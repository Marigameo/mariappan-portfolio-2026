---
/* Thenga's yard: the experiments heap. One shelf of small cards per category,
   and a single "cracked open" panel (a <dialog>) that shows one experiment at a
   time, with previous/next to walk the whole pile. Every experiment's notes are
   rendered into the panel up front (hidden), so they are in the page for search
   and need no templating. /experiments/#<id> opens one directly. Above the
   shelves, "Stories from the yard" holds the highlights: wide cards that link to a
   story of their own. All content comes from src/data/experiments.ts.
   First of all, the studio: UI experiments as a gallery of artboards, each one a
   preview of the new UI that opens its story (src/data/studio.ts). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Thenga from '../components/mascots/Thenga.astro';
import CoconutHeap from '../components/mascots/CoconutHeap.astro';
import DesignEcosystem from '../components/sketches/DesignEcosystem.astro';
import KbGraph from '../components/sketches/kb/KbGraph.astro';
import RoomDoors from '../components/RoomDoors.astro';
import NextRoom from '../components/NextRoom.astro';
import { rooms } from '../data/rooms';
import { moods, shelves, experiments, experimentCount, highlights } from '../data/experiments';
import { studio, studioHref } from '../data/studio';
import { site } from '../data/site';

const description = 'Thenga’s studio + yard: UI redesigns told as stories (the before, the after and the lessons), plus a heap of apps, ventures and night hacks, each with what I found inside.';
const n = experiments.length;
const sketches = { 'design-ecosystem': DesignEcosystem };
const artSketches = { 'kb-graph': KbGraph };
---
<BaseLayout title={`Thenga’s studio + yard — experiments | ${site.name}`} description={description} current="experiments">
  <main id="main" class="wrap yard">
    <header class="yard-hero">
      <div>
        <a class="breadcrumb" href="/#work"><Icon name="arrow-right" />All work</a>
        <p class="eyebrow"><span><span>Thenga’s studio + yard</span> · <span>{studio.length} on the easel</span> · <span>{experimentCount} on the pile</span></span></p>
        <h1>Every coconut’s a keeper.</h1>
        <p class="lede">In the studio, I take apart screens I’ve redesigned and show what changed. Out in the yard, the experiments keep piling up: shipped apps, a pivot, college ventures and night hacks. Not all of them became palms, but every one cracked open with something inside.</p>
      </div>
      <div class="yard-heap">
        <CoconutHeap items={experiments} />
        <p class="yard-hint" aria-hidden="true">pick a coconut</p>
      </div>
    </header>

    <!-- The three rooms, as doors: plain jump links until the script turns them into
         tabs, so without JS every room simply shows, one after another. Once the
         doors scroll away, a slim bar of the same rooms slides in under the header. -->
    <RoomDoors mode="tabs" label="Rooms" />
    <div class="rooms-mini" data-rooms-mini>
      <div class="wrap rooms-mini-row">
        {rooms.map((r) => <a class="room-tab" href={`#${r.id}`} data-room-jump={r.id}>{r.name}<span>{r.count}</span></a>)}
      </div>
    </div>

    <section class="room studio" id="studio" aria-labelledby="studio-title" data-room-panel>
      <header class="studio-head">
        <Thenga hobby="brush" class="studio-mascot" />
        <div>
          <h2 id="studio-title">The studio</h2>
          <p>Screens I’ve redrawn: the before, the after, and the smudges in between.</p>
        </div>
      </header>
      <ul class="arts">
        {studio.map((p) => {
          const Sketch = p.preview.kind === 'sketch' ? artSketches[p.preview.sketch] : null;
          return (
            <li class="art" style={`--accent: var(--${p.accent})`}>
              <a class="art-link" href={studioHref(p)}>
                <span class="art-frame"><span class="art-frame-icon" aria-hidden="true">#</span>{p.frame}</span>
                <span class="art-board">
                  <span class="art-shot">
                    {p.preview.kind === 'sketch' && Sketch
                      ? <Sketch label={p.preview.alt} />
                      : p.preview.kind === 'video' && <video src={p.preview.src} poster={p.preview.poster} width={p.preview.width} height={p.preview.height} muted loop playsinline preload="none" aria-label={p.preview.alt} data-art-video></video>}
                  </span>
                </span>
                <span class="art-body">
                  <strong class="art-title">{p.title}</strong>
                  <span class="nut-context">{p.context}</span>
                  {p.hook && <span class="art-hook">{p.hook}</span>}
                  <span class="art-tags">{p.tags.map((t) => <span class="art-tag">{t}</span>)}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
      <NextRoom from="studio" />
    </section>

    <section class="room picks" id="stories" aria-labelledby="highlights-title" data-room-panel>
      <header class="shelf-head">
        <p class="eyebrow">Highlights</p>
        <h2 id="highlights-title">Stories from the yard</h2>
        <p>The experiments that grew into stories of their own, in full.</p>
      </header>
      <ul class="picks-list">
        {highlights.map((h) => {
          const Sketch = sketches[h.sketch];
          return (
            <li class="pick" style={`--accent: var(--${h.accent})`}>
              <a class="pick-link" href={h.href}>
                <span class="pick-shot taped"><Sketch /></span>
                <span class="pick-body">
                  <span class="pick-tags">{h.tags.join(' · ')}</span>
                  <strong class="pick-title">{h.title}</strong>
                  <span class="nut-context">{h.context}</span>
                  <span class="pick-hook">{h.hook}</span>
                  <span class="nut-go">Read the story<Icon name="arrow-right" /></span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
      <NextRoom from="stories" />
    </section>

    <section class="room yard-room" id="yard" aria-labelledby="yard-title" data-room-panel>
      <header class="room-head">
        <h2 id="yard-title">The yard</h2>
      </header>
      <ul class="key" aria-label="What each coconut means">
        {Object.entries(moods).map(([key, m]) => (
          <li>
            <Thenga mood={key as keyof typeof moods} />
            <p><strong>{m.label}</strong>{m.meaning}</p>
          </li>
        ))}
      </ul>
      <nav class="yard-filter" aria-label="Shelves" data-yard-filter>
        <a class="pill" href="#yard" data-shelf="all">All<span>{experimentCount}</span></a>
        {shelves.map((s) => <a class="pill" href={`#${s.id}`} data-shelf={s.id}>{s.name}<span>{s.items.length}</span></a>)}
      </nav>

      {shelves.map((shelf) => (
        <section class="patch" id={shelf.id} aria-labelledby={`${shelf.id}-title`} data-patch={shelf.id}>
          <header class="patch-head">
            <h3 id={`${shelf.id}-title`}>{shelf.name}</h3>
            <p>{shelf.tagline}</p>
          </header>
          <ul class="rows">
            {shelf.items.map((x) => (
              <li class="row m-hover-host">
                <Thenga mood={x.mood} label={moods[x.mood].label} class="row-mood" />
                <div class="row-main">
                  <h4><button type="button" class="nut-open" data-open={x.id} aria-haspopup="dialog">{x.name}</button></h4>
                  <p class="row-hook">{x.hook}</p>
                </div>
                <p class="nut-context row-context">{x.context}</p>
                <span class="nut-status">{x.status}</span>
                <Icon name="arrow-right" class="row-go" />
              </li>
            ))}
          </ul>
        </section>
      ))}
      <NextRoom from="yard" />
    </section>

    <p style="margin-top: var(--space-5)">
      <a class="pill" href="/#work"><Icon name="arrow-right" style="transform:scaleX(-1)" />Back to all work</a>
    </p>

    <!-- The cracked-open panel. One article per experiment; the script shows one at a time. -->
    <dialog class="crack" id="crack" data-crack aria-labelledby={`${experiments[0].id}-t`}>
      <div class="crack-sheet">
        <button type="button" class="crack-close rail-btn" data-close aria-label="Close"><Icon name="close" /></button>
        {experiments.map((x, i) => {
          const prev = experiments[(i - 1 + n) % n];
          const next = experiments[(i + 1) % n];
          return (
            <article class="crack-item" data-item={x.id} aria-labelledby={`${x.id}-t`} hidden={i !== 0}>
              <header class="crack-head">
                <Thenga mood={x.mood} class="crack-mood" />
                <div>
                  <p class="crack-tags"><span class="tag">{moods[x.mood].label}</span><span class="nut-status">{x.status}</span></p>
                  <h2 id={`${x.id}-t`}>{x.name}</h2>
                  <p class="nut-context">{x.context}</p>
                </div>
              </header>
              <p class="crack-hook">{x.hook}</p>

              <div class="crack-sections">
                {x.sections.map((s) => (
                  <section>
                    <h3>{s.title}</h3>
                    <ul class="doodle-list">{s.points.map((p) => <li>{p}</li>)}</ul>
                  </section>
                ))}
              </div>

              {x.shot && <img class="crack-shot" src={x.shot.src} alt={x.shot.alt} width={x.shot.w} height={x.shot.h} loading="lazy" decoding="async" />}

              <section class="crack-found">
                <h3><span aria-hidden="true">✦</span> Found inside</h3>
                <ul>{x.found.map((f) => <li>{f}</li>)}</ul>
              </section>

              {x.note && <p class="crack-note">{x.note}</p>}

              {x.links && x.links.length > 0 && (
                <p class="crack-links">
                  {x.links.map((l) => <a class="pill" href={l.href} rel="noopener" target="_blank">{l.label}<Icon name="external" /></a>)}
                </p>
              )}

              <footer class="crack-nav">
                <button type="button" class="crack-step" data-step="-1"><Icon name="arrow-right" style="transform:scaleX(-1)" /><span><small>Previous</small>{prev.name}</span></button>
                <span class="crack-count">{i + 1} / {n}</span>
                <button type="button" class="crack-step crack-step--next" data-step="1"><span><small>Next</small>{next.name}</span><Icon name="arrow-right" /></button>
              </footer>
            </article>
          );
        })}
      </div>
    </dialog>
  </main>
</BaseLayout>

<script>
  // ---- The rooms: studio, stories and yard, one at a time ----
  // The bar's jump links become tabs; only the chosen room's panel shows. The hash
  // picks the room: #studio, #stories (#highlights, its old name), #yard, a shelf
  // id (the yard, filtered to that shelf) or an experiment id (the yard, with that
  // experiment cracked open). The bar sticks under the site header, whose height
  // changes when the nav wraps on phones, so it's measured.
  const header = document.querySelector<HTMLElement>('.site-header');
  const setHeaderH = () => document.documentElement.style.setProperty('--header-h', `${header?.offsetHeight ?? 64}px`);
  setHeaderH();
  addEventListener('resize', setHeaderH);

  const bar = document.querySelector<HTMLElement>('[data-doors]');
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-doors] [data-room]'));
  const mini = document.querySelector<HTMLElement>('[data-rooms-mini]');
  const jumps = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-room-jump], [data-go-room]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-room-panel]'));
  const chips = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-yard-filter] [data-shelf]'));
  const patches = Array.from(document.querySelectorAll<HTMLElement>('[data-patch]'));
  let room = 'studio';

  const selectRoom = (name: string, scroll = false) => {
    room = name;
    tabs.forEach((t) => {
      const on = t.dataset.room === name;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach((p) => { p.hidden = p.id !== name; });
    jumps.forEach((j) => { if (j.dataset.roomJump) j.setAttribute('aria-current', String(j.dataset.roomJump === name)); });
    // Switching from further down: back up to the doors, with the new room open below.
    if (scroll && bar) {
      const top = bar.getBoundingClientRect().top + scrollY - (header?.offsetHeight ?? 0) - 16;
      if (scrollY > top) scrollTo({ top, behavior: 'instant' as ScrollBehavior });
    }
  };
  const selectShelf = (id: string) => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.shelf === id)));
    patches.forEach((p) => { p.hidden = id !== 'all' && p.dataset.patch !== id; });
  };

  if (bar && tabs.length) {
    document.querySelector('main')?.classList.add('rooms-on');
    tabs[0].parentElement!.setAttribute('role', 'tablist');
    tabs.forEach((t, i) => {
      t.setAttribute('role', 'tab');
      t.id = `tab-${t.dataset.room}`;
      t.setAttribute('aria-controls', t.dataset.room!);
      t.addEventListener('click', (e) => {
        e.preventDefault();
        selectRoom(t.dataset.room!, true);
        history.replaceState(null, '', `#${t.dataset.room}`);
      });
      t.addEventListener('keydown', (e) => {
        const to = e.key === 'ArrowRight' ? (i + 1) % tabs.length : e.key === 'ArrowLeft' ? (i - 1 + tabs.length) % tabs.length : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
        if (to < 0) return;
        e.preventDefault();
        tabs[to].focus();
        tabs[to].click();
      });
    });
    panels.forEach((p) => { p.setAttribute('role', 'tabpanel'); p.setAttribute('aria-labelledby', `tab-${p.id}`); });
    // The mini bar and the "Next room" hand-offs switch rooms too, then hand focus
    // to that room's door so keyboard users land where the room starts.
    jumps.forEach((j) => j.addEventListener('click', (e) => {
      e.preventDefault();
      const id = (j.dataset.roomJump ?? j.dataset.goRoom)!;
      selectRoom(id, true);
      history.replaceState(null, '', `#${id}`);
      tabs.find((t) => t.dataset.room === id)?.focus({ preventScroll: true });
    }));
    if (mini && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => mini.classList.toggle('is-on', !e.isIntersecting && e.boundingClientRect.top < 0), {
        rootMargin: `-${header?.offsetHeight ?? 64}px 0px 0px 0px`,
      }).observe(bar);
    }
    chips.forEach((c) => {
      c.setAttribute('role', 'button');
      c.addEventListener('click', (e) => {
        e.preventDefault();
        selectShelf(c.dataset.shelf!);
        history.replaceState(null, '', `#${c.dataset.shelf === 'all' ? 'yard' : c.dataset.shelf}`);
      });
    });

    // The browser jumps to the anchor before the other rooms are hidden, which
    // shifts the page under it; so once the right room shows, land on it again.
    const land = (id: string) => document.getElementById(id)?.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior });
    const route = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      if (h === 'studio' || h === 'stories' || h === 'yard') { selectRoom(h); return bar?.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior }); }
      if (h === 'highlights') { selectRoom('stories'); return bar?.scrollIntoView({ block: 'start', behavior: 'instant' as ScrollBehavior }); }
      if (patches.some((p) => p.dataset.patch === h)) { selectShelf(h); selectRoom('yard'); return land(h); }
      if (h && document.querySelector(`[data-open="${CSS.escape(h)}"]`)) return selectRoom('yard');
      selectRoom(room);
    };
    selectShelf('all');
    route();
    addEventListener('hashchange', route);
    // The browser makes its own jump to the anchor once the page has loaded,
    // after ours; land once more so the doors, not the room, end up on top.
    addEventListener('load', () => { if (location.hash) route(); }, { once: true });
  }

  // ---- The cracked-open panel ----
  const dlg = document.querySelector<HTMLDialogElement>('[data-crack]');
  if (dlg && typeof dlg.showModal === 'function') {
    const items = Array.from(dlg.querySelectorAll<HTMLElement>('[data-item]'));
    const ids = items.map((a) => a.dataset.item!);
    const sheet = dlg.querySelector<HTMLElement>('.crack-sheet')!;
    let current = -1;
    let opener: HTMLElement | null = null;

    const show = (i: number, focusStep?: string) => {
      items.forEach((a, j) => { a.hidden = j !== i; });
      current = i;
      dlg.setAttribute('aria-labelledby', `${ids[i]}-t`);
      sheet.scrollTop = 0;
      history.replaceState(null, '', `#${ids[i]}`);
      if (focusStep) items[i].querySelector<HTMLElement>(`[data-step="${focusStep}"]`)?.focus();
    };
    const step = (by: number, focusStep?: string) => {
      dlg.dataset.swapped = '';
      show((current + by + items.length) % items.length, focusStep);
    };
    const open = (id: string, from: HTMLElement | null) => {
      const i = ids.indexOf(id);
      if (i < 0) return;
      opener = from;
      // Whichever coconut opened it (a row, or the heap up top), it lives in the yard.
      if (tabs.length) selectRoom('yard');
      show(i);
      if (!dlg.open) { dlg.showModal(); document.documentElement.classList.add('crack-lock'); }
    };

    dlg.addEventListener('close', () => {
      document.documentElement.classList.remove('crack-lock');
      delete dlg.dataset.swapped;
      history.replaceState(null, '', location.pathname + location.search + (tabs.length ? `#${room}` : ''));
      opener?.focus();
      opener = null;
    });
    // A click on the backdrop lands on the <dialog> itself; the sheet covers everything else.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    dlg.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.step), b.dataset.step)));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
    });

    document.querySelectorAll<HTMLElement | SVGElement>('[data-open]').forEach((el) => {
      el.addEventListener('click', () => open(el.dataset.open!, el instanceof HTMLButtonElement ? el : null));
    });

    // The heap: a label that follows the coconut under the pointer.
    const heap = document.querySelector<HTMLElement>('[data-heap]');
    const tip = heap?.querySelector<HTMLElement>('[data-heap-tip]');
    if (heap && tip) {
      heap.querySelectorAll<SVGGElement>('[data-open]').forEach((nut) => {
        nut.addEventListener('pointerenter', () => {
          const h = heap.getBoundingClientRect();
          const r = nut.getBoundingClientRect();
          tip.textContent = nut.dataset.name ?? '';
          tip.style.left = `${r.left + r.width / 2 - h.left}px`;
          tip.style.top = `${r.top - h.top - 8}px`;
          tip.hidden = false;
        });
        nut.addEventListener('pointerleave', () => { tip.hidden = true; });
      });
    }

    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (ids.includes(id)) open(id, null);
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }

  // The studio's artboards: each loop plays while its tile is hovered or focused.
  // On touch screens (no hover) it plays while the tile is in view instead. Under
  // reduced motion it never plays, and the poster stays.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const canHover = matchMedia('(hover: hover)').matches;
    document.querySelectorAll<HTMLVideoElement>('[data-art-video]').forEach((video) => {
      const link = video.closest<HTMLElement>('.art-link');
      const play = () => { video.play().catch(() => {}); };
      const stop = () => { video.pause(); };
      if (canHover && link) {
        link.addEventListener('pointerenter', play);
        link.addEventListener('pointerleave', stop);
        link.addEventListener('focus', play);
        link.addEventListener('blur', stop);
      } else {
        new IntersectionObserver(([e]) => (e.isIntersecting ? play() : stop()), { threshold: 0.6 }).observe(video);
      }
    });
  }
</script>

<style>
  .yard { padding-bottom: var(--space-5); }
  .yard-hero { display: grid; grid-template-columns: 1fr minmax(18rem, 30rem); align-items: end; gap: 1rem 3rem; padding-top: var(--space-4); }
  .yard-hero h1 { margin-top: .3rem; }
  /* Long eyebrow: if it wraps, it wraps at a dot, never inside a phrase. */
  .yard-hero .eyebrow { max-width: none; }
  .yard-hero .eyebrow > span > span { white-space: nowrap; }
  .yard-heap { position: relative; }
  .yard-hint { position: absolute; top: 2%; left: 4%; margin: 0; font-family: var(--font-hand); font-size: 1.3rem; color: var(--coral); transform: rotate(-5deg); }

  /* The doors sit under the hero. Once they scroll away, the mini bar slides in
     under the site header with the same three rooms, so switching is always one
     click away. The script measures the header (it wraps on phones) into --header-h. */
  main :global(.doors--tabs) { margin-top: var(--space-4); scroll-margin-top: calc(var(--header-h, 4rem) + 1rem); }
  .rooms-mini { position: fixed; top: var(--header-h, 4rem); left: 0; right: 0; z-index: 40; padding: .55rem 0; background: color-mix(in srgb, var(--paper) 90%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1.5px dashed var(--line); transform: translateY(-110%); opacity: 0; visibility: hidden; transition: transform .25s cubic-bezier(.2,.8,.2,1), opacity .2s ease, visibility 0s linear .25s; }
  .rooms-mini.is-on { transform: none; opacity: 1; visibility: visible; transition: transform .25s cubic-bezier(.2,.8,.2,1), opacity .2s ease; }
  .rooms-mini-row { display: flex; gap: .45rem; overflow-x: auto; scrollbar-width: none; }
  .rooms-mini-row::-webkit-scrollbar { display: none; }
  .room-tab { display: inline-flex; align-items: center; gap: .5rem; padding: .45rem .95rem; font-size: .92rem; font-weight: 500; white-space: nowrap; text-decoration: none; color: var(--ink-soft); background: var(--paper-2); border: 1.5px solid var(--border); border-radius: 999px; transition: color .15s ease, background .15s ease; }
  .room-tab span { font-family: var(--font-mono); font-size: .7rem; font-weight: 400; color: var(--ink-faint); }
  .room-tab:hover { color: var(--ink); }
  .room-tab[aria-current="true"] { color: var(--paper); background: var(--ink); border-color: var(--ink); }
  .room-tab[aria-current="true"] span { color: color-mix(in srgb, var(--paper) 70%, transparent); }
  .room-tab:focus-visible { outline: 2px solid var(--coral); outline-offset: 2px; }
  /* One room at a time; a min-height so the footer doesn't jump up under a short room. */
  .room { margin-top: var(--space-4); min-height: 50vh; scroll-margin-top: calc(var(--header-h, 4rem) + 4.5rem); }
  .room-head h2 { margin: 0 0 .3rem; }
  /* With the tabs on, the open door already names the room and says what's in it,
     so each room's own heading is kept for screen readers only. Without JS every
     room shows in turn, and the headings show with them. */
  .rooms-on :is(.studio-head, .picks > .shelf-head, .room-head) { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* The studio: a gallery of artboards. Each is a frame label, a board with a dot
     grid (the canvas), the new UI pinned on it, and a title with paint-swatch tags. */
  .studio-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.6rem; }
  .studio-head h2 { margin: 0 0 .3rem; }
  .studio-head p { margin: 0; }
  .studio-head :global(.studio-mascot) { flex: none; width: 5.5rem; margin: -.6rem 0 -.4rem; }
