---
/* About: the professional side up front. The journey (newest first) carries the
   little wins as stickers on the stop they happened at; below it, "Off the clock"
   is one row of Thengas, one per hobby. A sticker or a Thenga opens its photos
   and words in a panel (one <dialog>, one item shown at a time; hobbies step
   previous/next among themselves). /about/#<hobby id> or #win-<id> opens one. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Thenga from '../components/mascots/Thenga.astro';
import { pastimes } from '../data/offclock';
import thumbs from '../data/thumbs.json';

// Reel-sized copy and blurred preview per pick (scripts/thumbs.mjs); the original still opens full size.
const thumb = (src: string) => (thumbs as Record<string, { sm: string; lqip: string }>)[src];
import { site } from '../data/site';

const description = 'Mariappan Subramanian: design engineer at Strivelabs. The journey so far, from Zoho to Freshworks to Strive, the little wins along the way, and what he does off the clock.';

// The journey, newest first. `roles` with two entries renders as "A → B". Dates per LinkedIn.
const journey = [
  { year: "'24", company: 'Strivelabs', logo: '/images/logos/strivelabs.svg', roles: ['Founding Engineer\u00a0· Design Engineering'], when: 'Nov 2024 – now', note: 'Now: building the thing this site keeps talking about.', wobbly: 'wobbly--3', tilt: 3, now: true },
  { year: "'21", company: 'Freshworks', logo: '/images/logos/freshworks.svg', roles: ['Software Engineer', 'Senior Software Engineer'], when: 'Aug 2021 – Oct 2024', note: 'Owned the monorepo behind the Freshworks Marketplace — untangled years of tech debt and pushed it to 100% accessible.', wobbly: '', tilt: 2 },
  { year: "'20", company: 'Peppo', logo: '/images/logos/peppo.svg', roles: ['Software Engineer'], when: 'Sep 2020 – Aug 2021', note: 'Joined early enough to build things from scratch: location services, a Next.js PWA, even a POS console.', wobbly: 'wobbly--2', tilt: 1 },
  { year: "'19", company: 'Facilio', logo: '/images/logos/facilio.svg', roles: ['Engineering Intern', 'Member of Technical Staff, Frontend'], when: 'Dec 2019 – Aug 2020', note: 'SSO, an Autodesk BIM integration, and a full site revamp — my first taste of shipping full-time.', wobbly: 'wobbly--3', tilt: 3 },
  { year: "'19", company: 'Mad Street Den (vue.ai)', logo: '/images/logos/msd.svg', roles: ['Frontend Engineer'], when: 'Jul – Oct 2019', note: 'Speed-ran performance fixes on an AI recommendation engine, then built its dashboard in React.', wobbly: 'wobbly--2', tilt: 2 },
  { year: "'18", company: 'Zoho', logo: '/images/logos/zoho.svg', roles: ['Marketplace Apps Developer'], when: 'Dec 2018 – Feb 2019', note: 'Cut my teeth building marketplace extensions for LinkedIn, Wrike & GrooveHQ — in Zoho Deluge, of all things.', wobbly: '', tilt: 1 },
];

// The wins worth a laptop sticker, newest first. Each is a sticker on the journey
// stop named by `stop` (a company); its photos and words open in the panel.
const wins = [
  {
    id: 'blogathon', stop: 'Freshworks', short: 'Blog-a-thon champion', year: '2022',
    icon: 'pen', accent: 'coral', when: 'Freshworks · 2022', title: 'Blog-a-thon champion',
    text: "Won Freshworks' Developer Platform Blog-a-thon with a post on localising marketplace apps with Crayons.",
    photos: [{ src: '/images/wins/blogathon-2022.jpg', alt: 'Winners poster for the Freshworks Developer Platform Blog-a-thon, naming Mariappan Subramanian as champion', w: 960, h: 960 }],
    links: [{ href: 'https://medium.com/@mariappan/localiz-s-ing-your-marketplace-apps-with-crayons-32761e282320', label: 'Read the winning post' }],
    wobbly: '', tilt: 1,
  },
  {
    id: 'cliqtrix', stop: 'Zoho', short: 'Cliqtrix hacker ×2', year: "'18 & '19",
    icon: 'star', accent: 'blue', when: 'Zoho Cliq · 2018 & 2019', title: 'Two-time Cliqtrix hacker',
    text: "Honorable mention in '18 — the contest's very first year — then winner in '19.",
    photos: [
      { src: '/images/wins/cliqtrix-team-1.jpg', alt: 'Cliqtrix finalists in Trixster t-shirts posing with certificates and a prize cheque', w: 960, h: 639 },
      { src: '/images/wins/cliqtrix-solo.jpg', alt: "Mariappan holding a Cliqtrix '18 certificate, prize cheque and trophy", w: 432, h: 720 },
      { src: '/images/wins/cliqtrix-team-2.jpg', alt: 'Cliqtrix winners group photo with prize cheques', w: 770, h: 513 },
      { src: '/images/wins/cliqtrix-team-3.jpg', alt: 'Cliqtrix winners in black Trixster t-shirts holding up their trophies and certificates', w: 1200, h: 707 },
      { src: '/images/wins/cliqtrix-team-4.jpg', alt: 'The Cliqtrix finalists seated on the steps outside a glass-fronted office building', w: 770, h: 513 },
    ],
    links: [
      { href: 'https://www.cliqtrix.com/archives/2018/?src=cliqtrix-header#winners', label: "'18 winners" },
      { href: 'https://www.cliqtrix.com/archives/2019/?src=cliqtrix-header#winners', label: "'19 winners" },
    ],
    wobbly: 'wobbly--2', tilt: 2,
  },
];
const winsAt = (company: string) => wins.filter((w) => w.stop === company);
---
<BaseLayout title={`About | ${site.name}`} description={description} ogType="profile" current="about">
  <main id="main">
    <header class="wrap page-hero">
      <p class="eyebrow">About</p>
      <h1>A story in progress, written between commits and coffee.</h1>
      <p class="lede">I design and build interfaces for AI products at <a href={site.links.strivelabs}>Strivelabs</a>. Six stops so far, from marketplace apps at Zoho to generative UI at Strive.</p>
      <div class="hero-cta">
        <a class="pill pill--solid hire" href={site.links.linkedin} rel="noopener"><Icon name="linkedin" />Hire me</a>
        <p class="hire-note hand"><Icon name="arrow-curly" class="hire-arrow" />say hi on LinkedIn, I reply</p>
      </div>
    </header>

    <section class="section section--sand has-wave before-wave" style="margin-top: var(--wave-h)" id="journey" aria-labelledby="journey-title">
      <div class="wave" aria-hidden="true"></div>
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">The journey so far</p>
          <h2 id="journey-title">Six stops, <mark class="hl">one very long commit log.</mark></h2>
          <p class="journey-note hand">newest first, like git log<Icon name="arrow-down" /></p>
          <p class="journey-key hand"><span class="journey-key-dot" aria-hidden="true"><Icon name="star" /></span>the stickers are little wins, tap one</p>
        </div>
        <ol class="journey">
          {journey.map((j) => (
            <li class:list={['stop', j.now && 'stop--now']}>
              <span class="stop-year" aria-hidden="true">{j.year}</span>
              <article class:list={['stop-card', 'wobbly', j.wobbly, `tilt-${j.tilt}`]}>
                <div class="stop-head">
                  <p class="stop-when">{j.now && <span class="live" aria-hidden="true"></span>}{j.when}</p>
                  <img class="stop-logo" src={j.logo} alt={j.company} height="24" loading="lazy">
                </div>
                <h3>
                  <span class="visually-hidden">{j.company}: </span>
                  {j.roles.map((r, i) => (<>{i > 0 && <Icon name="arrow-right" class="stop-arrow" />}<span>{r}</span></>))}
                </h3>
                <p class="stop-note">{j.note}</p>
                {winsAt(j.company.split(' ')[0]).length > 0 && (
                  <div class="stop-wins">
                    {winsAt(j.company.split(' ')[0]).map((w, i) => (
                      <button type="button" class="sticker" style={`--accent: var(--${w.accent}); --tilt: ${i % 2 ? 2 : -3}deg`} data-sheet-open={`win-${w.id}`} aria-haspopup="dialog">
                        <span class="sticker-icon" aria-hidden="true"><Icon name={w.icon} /></span>
                        <span class="sticker-text"><small>Won · {w.year}</small>{w.short}</span>
                      </button>
                    ))}
                  </div>
                )}
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--paper has-wave" id="off-the-clock" aria-labelledby="clock-title">
      <div class="wave wave--flip" aria-hidden="true"></div>
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Off the clock</p>
          <h2 id="clock-title">Thenga’s day off.</h2>
          <p>Five things I do when the laptop’s shut.</p>
          <p class="clock-hint hand" aria-hidden="true">tap a coconut, there are photos inside<Icon name="arrow-curly" class="clock-arrow" /></p>
        </div>
        <ul class="hobbies">
          {pastimes.map((p, i) => (
            <li>
              <button type="button" class="hobby" style={`--accent: var(--${p.accent}); --m-delay: -${(i * 0.7).toFixed(1)}s`} data-sheet-open={p.id} aria-haspopup="dialog">
                <span class="hobby-art">
                  {p.picks[0] && <span class="hobby-peek" aria-hidden="true"><img src={thumb(p.picks[0].src)?.sm ?? p.picks[0].src} alt="" loading="lazy" decoding="async" /></span>}
                  <span class="board-who">
                    <Thenga hobby={p.hobby} />
                    <span class="board-doing" aria-hidden="true">{p.doing}</span>
                  </span>
                </span>
                <span class="hobby-name">{p.short}</span>
                <span class="hobby-more">{p.picks.length} photos<Icon name="arrow-right" /></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- The panel: one item per win and per hobby, one shown at a time. -->
    <!-- Without JS nothing would clear .is-developing, so show the photos straight away. -->
    <noscript><style>.polaroid.is-developing img { opacity: 1; filter: none; } .polaroid-developing, .polaroid-photo::after { display: none; }</style></noscript>
    <dialog class="sheet" data-sheet aria-labelledby={`win-${wins[0].id}-t`}>
      <div class="sheet-body">
        <button type="button" class="sheet-close rail-btn" data-sheet-close aria-label="Close"><Icon name="close" /></button>
        {wins.map((w, i) => {
          const prev = wins[(i - 1 + wins.length) % wins.length];
          const next = wins[(i + 1) % wins.length];
          // With two wins, previous and next are the same one: just "Next".
          const both = wins.length > 2;
          return (
            <article class="sheet-item sheet-win" data-sheet-item={`win-${w.id}`} aria-labelledby={`win-${w.id}-t`} style={`--accent: var(--${w.accent})`} hidden>
              <div class="win-body">
                <span class="win-badge"><Icon name={w.icon} /></span>
                <p class="win-when">{w.when}</p>
                <h2 id={`win-${w.id}-t`}>{w.title}</h2>
                <p>{w.text}</p>
                <div class="cluster win-links">
                  {w.links.map((l) => (
                    <a class="pill pill--soft" href={l.href} rel="noopener">{l.label}<Icon name="external" /></a>
                  ))}
                </div>
              </div>
              {w.photos.length > 1 ? (
                <div class="win-carousel" data-carousel role="group" aria-roledescription="carousel" aria-label={`${w.title} photos`}>
                  <div class="win-track" data-carousel-track>
                    {w.photos.map((p, i) => (
                      <button class="win-slide" type="button" data-full={p.src} aria-label={`Photo ${i + 1} of ${w.photos.length}, view full size: ${p.alt}`}>
                        <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy">
                        <img class="win-slide-bg" src={p.src} alt="" aria-hidden="true" loading="lazy">
                        <span class="win-shot-hint" aria-hidden="true">view</span>
                      </button>
                    ))}
                  </div>
                  <button class="rail-btn win-nav win-nav--prev" type="button" data-carousel-prev aria-label="Previous photo"><Icon name="arrow-right" /></button>
                  <button class="rail-btn win-nav win-nav--next" type="button" data-carousel-next aria-label="Next photo"><Icon name="arrow-right" /></button>
                  <p class="win-count" aria-hidden="true"><span data-carousel-count>1</span> / {w.photos.length}</p>
                </div>
              ) : (
                <div class="win-photos">
                  {w.photos.map((p) => (
                    <button class="win-shot" type="button" data-full={p.src} aria-label={`View full size: ${p.alt}`}>
                      <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy">
                      <span class="win-shot-hint" aria-hidden="true">view</span>
                    </button>
                  ))}
                </div>
              )}
              <footer class="sheet-nav">
                {both && <button type="button" class="sheet-step" data-sheet-step="-1"><Icon name="arrow-right" style="transform:scaleX(-1)" /><span><small>Previous</small>{prev.short}</span></button>}
                <button type="button" class="sheet-step sheet-step--next" data-sheet-step="1"><span><small>{both ? 'Next' : 'The other win'}</small>{next.short}</span><Icon name="arrow-right" /></button>
              </footer>
            </article>
          );
        })}
        {pastimes.map((p, i) => {
          const cta = p.more ?? (p.picks.length ? 'More on' : 'Meanwhile, it’s all on');
          const prev = pastimes[(i - 1 + pastimes.length) % pastimes.length];
          const next = pastimes[(i + 1) % pastimes.length];
          return (
            <article class="sheet-item board" data-sheet-item={p.id} aria-labelledby={`${p.id}-title`} style={`--accent: var(--${p.accent})`} hidden>
              <div class="board-head">
                <div class="board-who">
                  <Thenga hobby={p.hobby} />
                  <p class="board-doing" aria-hidden="true">{p.doing}</p>
                </div>
                <div class="board-main">
                  <h2 id={`${p.id}-title`}>{p.title}</h2>
                  <p>{p.text}</p>
                  {p.picks.length === 0 && (p.link ? (
                    <a class="ig-card ig-card--inline" href={p.link.href} rel="noopener">
                      <Icon name="instagram" /><span>{cta}</span><strong>{p.link.label}</strong><Icon name="arrow-right" class="ig-go" />
                    </a>
                  ) : (
                    <p class="board-aside">{p.aside}</p>
                  ))}
                </div>
              </div>
              {p.picks.length > 0 && (
                <div class="reel" data-rail>
                  <div class="rail-controls reel-controls">
                    <button class="rail-btn" type="button" data-prev aria-label="Previous" aria-controls={`${p.id}-reel`}><Icon name="arrow-right" /></button>
                    <span class="rail-progress" aria-hidden="true"><i data-thumb></i></span>
                    <button class="rail-btn" type="button" data-next aria-label="Next" aria-controls={`${p.id}-reel`}><Icon name="arrow-right" /></button>
                  </div>
                  <ul class="rail-track reel-track" id={`${p.id}-reel`} data-track aria-label={`${p.title}: a few picks`}>
                    {p.picks.map((x) => (
                      <li class="reel-item">
                        <button class="polaroid is-developing" type="button" data-full={x.src} data-develop aria-label={`View full size: ${x.alt}`}>
                          <span class="polaroid-photo" style={thumb(x.src) ? `background-image: url(${thumb(x.src).lqip})` : undefined}>
                            <img src={thumb(x.src)?.sm ?? x.src} alt={x.alt} width={x.w} height={x.h} loading="lazy" decoding="async">
                            <span class="polaroid-developing" aria-hidden="true">developing…</span>
                          </span>
                          {x.caption && <span class="polaroid-caption" aria-hidden="true">{x.caption}</span>}
                        </button>
                      </li>
                    ))}
                    {p.link && (
                      <li class="reel-item reel-item--cta">
                        <a class="ig-card" href={p.link.href} rel="noopener">
                          <Icon name="instagram" />
                          <span>{cta}</span>
                          <strong set:html={p.link.label.replaceAll('.', '.<wbr>')} />
                          <Icon name="arrow-right" class="ig-go" />
                        </a>
                      </li>
                    )}
                    {!p.link && p.aside && (
                      <li class="reel-item reel-item--cta"><p class="ig-card ig-card--note">{p.aside}</p></li>
                    )}
                  </ul>
                </div>
              )}
              <footer class="sheet-nav">
                <button type="button" class="sheet-step" data-sheet-step="-1"><Icon name="arrow-right" style="transform:scaleX(-1)" /><span><small>Previous</small>{prev.short}</span></button>
                <span class="sheet-count">{i + 1} / {pastimes.length}</span>
                <button type="button" class="sheet-step sheet-step--next" data-sheet-step="1"><span><small>Next</small>{next.short}</span><Icon name="arrow-right" /></button>
              </footer>
            </article>
          );
        })}
      </div>
    </dialog>

    <dialog class="lightbox" data-lightbox aria-label="Photo">
      <button class="lightbox-close rail-btn" type="button" data-lightbox-close aria-label="Close"><Icon name="close" /></button>
      <figure>
        <img alt="" data-lightbox-img>
        <figcaption data-lightbox-caption></figcaption>
      </figure>
    </dialog>
  </main>
</BaseLayout>

<script>
  // The panel: a sticker or a Thenga opens its item; previous/next walk the items of
  // the same kind (wins, or hobbies). The hash follows the open item, so a link can
  // open one. The reels and carousels inside measure themselves on resize, and
  // were hidden when they first did, so they get a nudge once their item shows.
  const dlg = document.querySelector<HTMLDialogElement>('[data-sheet]');
  if (dlg && typeof dlg.showModal === 'function') {
    const items = [...dlg.querySelectorAll<HTMLElement>('[data-sheet-item]')];
    const body = dlg.querySelector<HTMLElement>('.sheet-body')!;
    const ids = items.map((a) => a.dataset.sheetItem!);
    let current: HTMLElement | null = null;
    let opener: HTMLElement | null = null;

    const show = (id: string) => {
      const item = items.find((a) => a.dataset.sheetItem === id);
      if (!item) return false;
      items.forEach((a) => { a.hidden = a !== item; });
      current = item;
      dlg.setAttribute('aria-labelledby', item.getAttribute('aria-labelledby') ?? '');
      body.scrollTop = 0;
      history.replaceState(null, '', `#${id}`);
      requestAnimationFrame(() => dispatchEvent(new Event('resize')));
      return true;
    };
    const open = (id: string, from: HTMLElement | null) => {
      if (!show(id)) return;
      opener = from;
      if (!dlg.open) { dlg.showModal(); document.documentElement.classList.add('sheet-lock'); }
    };
    // Step among the items of the same kind: wins with wins, hobbies with hobbies.
    const step = (by: number, focusDir: string) => {
      if (!current) return;
      const kind = current.classList.contains('sheet-win');
      const group = items.filter((a) => a.classList.contains('sheet-win') === kind);
      const next = group[(group.indexOf(current) + by + group.length) % group.length];
      dlg.dataset.swapped = '';
      show(next.dataset.sheetItem!);
      next.querySelector<HTMLElement>(`[data-sheet-step="${focusDir}"]`)?.focus();
    };

    document.querySelectorAll<HTMLElement>('[data-sheet-open]').forEach((b) => b.addEventListener('click', () => open(b.dataset.sheetOpen!, b)));
    dlg.querySelectorAll<HTMLElement>('[data-sheet-step]').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.sheetStep), b.dataset.sheetStep!)));
    dlg.querySelectorAll('[data-sheet-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => {
      document.documentElement.classList.remove('sheet-lock');
      delete dlg.dataset.swapped;
      history.replaceState(null, '', location.pathname + location.search);
      opener?.focus();
      opener = null;
    });

    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (ids.includes(id)) open(id, null);
    };
    addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>

<style>
  /* Hire me: the one loud button on the page, with a handwritten nudge. */
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin-top: 1.4rem; }
  .hire { padding: .7rem 1.2rem; font-size: 1rem; box-shadow: 3px 3px 0 var(--shadow-ink); }
  .hire :global(.doodle) { width: 1.05rem; height: 1.05rem; }
  .hire-note { display: flex; align-items: center; gap: .3rem; margin: 0; font-size: 1.2rem; color: color-mix(in srgb, var(--coral) 82%, var(--ink)); transform: rotate(-2deg); }
  .hire-note :global(.hire-arrow) { width: 2.2rem; height: 1.6rem; stroke-width: 2; transform: scaleX(-1) rotate(-10deg); flex: none; }

  /* Spacing as on the homepage: every gap between sections is the same, the
     wave sitting in the bottom padding of the section above it. */
  .page-hero { padding-bottom: var(--space-4); }
  #journey.before-wave { padding-top: var(--space-4); padding-bottom: calc(var(--space-4) + var(--wave-h)) !important; }
  #off-the-clock.has-wave { padding-top: var(--space-4); padding-bottom: var(--space-4); }

  /* The key to the stickers, under the journey's heading. */
  .journey-key { display: flex; align-items: center; gap: .45rem; margin: .4rem 0 0; max-width: none; font-size: 1.15rem; color: var(--ink-soft); transform: rotate(-1deg); }
  .journey-key-dot { display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--yellow); border: 1.5px solid var(--border); }
  .journey-key-dot :global(.doodle) { width: .85rem; height: .85rem; stroke-width: 2; color: var(--sticky-ink); }

  /* A win, as a sticker stuck on its stop: a die-cut edge (a dashed line just
     inside), the accent's wash, tilted. It lifts and straightens on hover. */
  .stop-wins { display: flex; flex-wrap: wrap; gap: .6rem .8rem; margin-top: .35rem; }
  .sticker { display: inline-flex; align-items: center; gap: .55rem; padding: .4rem .85rem .4rem .45rem; font: inherit; text-align: left; color: var(--ink); background: color-mix(in srgb, var(--accent) 16%, var(--paper-2)); border: 1.5px solid var(--border); border-radius: 999px; box-shadow: 2px 2px 0 var(--shadow-ink), inset 0 0 0 3px var(--paper-2), inset 0 0 0 4px color-mix(in srgb, var(--accent) 45%, transparent); cursor: pointer; transform: rotate(var(--tilt, -2deg)); transition: transform .2s cubic-bezier(.2,.8,.2,1), box-shadow .2s ease; }
  .sticker:hover { transform: rotate(0) translateY(-2px); box-shadow: 3px 4px 0 var(--shadow-ink), inset 0 0 0 3px var(--paper-2), inset 0 0 0 4px color-mix(in srgb, var(--accent) 45%, transparent); }
  .sticker:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
  .sticker-icon { flex: none; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; color: var(--accent); background: var(--paper-2); border: 1.5px solid var(--border); }
  .sticker-icon :global(.doodle) { width: 1rem; height: 1rem; stroke-width: 2; }
  .sticker-text { display: grid; font-size: .9rem; font-weight: 600; line-height: 1.15; }
  .sticker-text small { font-family: var(--font-mono); font-size: .6rem; font-weight: 400; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }

  /* Off the clock: one row of Thengas, each on its tinted blob with what it's
     up to, and the hobby's name underneath. */
  .hobbies { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem 1.2rem; }
  .hobby { display: grid; justify-items: center; gap: 1.5rem; width: 100%; padding: .4rem 0; font: inherit; color: var(--ink); background: none; border: 0; cursor: pointer; }
  .hobby { position: relative; }
  .hobby-art { position: relative; display: block; width: min(9.5rem, 100%); transition: transform .25s cubic-bezier(.2,.8,.2,1); }
  .hobby .board-who { position: relative; z-index: 1; display: block; }
