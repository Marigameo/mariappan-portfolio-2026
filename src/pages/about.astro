---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Thenga from '../components/mascots/Thenga.astro';
import { pastimes } from '../data/offclock';
import thumbs from '../data/thumbs.json';

// Reel-sized copy and blurred preview per pick (scripts/thumbs.mjs); the original still opens full size.
const thumb = (src: string) => (thumbs as Record<string, { sm: string; lqip: string }>)[src];
import { site } from '../data/site';

const description = 'Beyond the job title: guitar covers, slow travel, home cooking, Tamil poetry and photographs. The other sides of Mariappan Subramanian, plus the journey so far.';

// The journey, newest first. `roles` with two entries renders as "A → B". Dates per LinkedIn.
const journey = [
  { year: "'24", company: 'Strivelabs', logo: '/images/logos/strivelabs.svg', roles: ['Founding Engineer\u00a0· Design Engineering'], when: 'Nov 2024 – now', note: 'Now: building the thing this site keeps talking about.', wobbly: 'wobbly--3', tilt: 3, now: true },
  { year: "'21", company: 'Freshworks', logo: '/images/logos/freshworks.svg', roles: ['Software Engineer', 'Senior Software Engineer'], when: 'Aug 2021 – Oct 2024', note: 'Owned the monorepo behind the Freshworks Marketplace — untangled years of tech debt and pushed it to 100% accessible.', wobbly: '', tilt: 2 },
  { year: "'20", company: 'Peppo', logo: '/images/logos/peppo.svg', roles: ['Software Engineer'], when: 'Sep 2020 – Aug 2021', note: 'Joined early enough to build things from scratch: location services, a Next.js PWA, even a POS console.', wobbly: 'wobbly--2', tilt: 1 },
  { year: "'19", company: 'Facilio', logo: '/images/logos/facilio.svg', roles: ['Engineering Intern', 'Member of Technical Staff, Frontend'], when: 'Dec 2019 – Aug 2020', note: 'SSO, an Autodesk BIM integration, and a full site revamp — my first taste of shipping full-time.', wobbly: 'wobbly--3', tilt: 3 },
  { year: "'19", company: 'Mad Street Den (vue.ai)', logo: '/images/logos/msd.svg', roles: ['Frontend Engineer'], when: 'Jul – Oct 2019', note: 'Speed-ran performance fixes on an AI recommendation engine, then built its dashboard in React.', wobbly: 'wobbly--2', tilt: 2 },
  { year: "'18", company: 'Zoho', logo: '/images/logos/zoho.svg', roles: ['Marketplace Apps Developer'], when: 'Dec 2018 – Feb 2019', note: 'Cut my teeth building marketplace extensions for LinkedIn, Wrike & GrooveHQ — in Zoho Deluge, of all things.', wobbly: '', tilt: 1 },
];

// The wins worth a laptop sticker, newest first. `photos` fan out above the text.
const wins = [
  {
    icon: 'pen', accent: 'coral', when: 'Freshworks · 2022', title: 'Blog-a-thon champion',
    text: "Won Freshworks' Developer Platform Blog-a-thon with a post on localising marketplace apps with Crayons.",
    photos: [{ src: '/images/wins/blogathon-2022.jpg', alt: 'Winners poster for the Freshworks Developer Platform Blog-a-thon, naming Mariappan Subramanian as champion', w: 960, h: 960 }],
    links: [{ href: 'https://medium.com/@mariappan/localiz-s-ing-your-marketplace-apps-with-crayons-32761e282320', label: 'Read the winning post' }],
    wobbly: '', tilt: 1,
  },
  {
    icon: 'star', accent: 'blue', when: 'Zoho Cliq · 2018 & 2019', title: 'Two-time Cliqtrix hacker',
    text: "Honorable mention in '18 — the contest's very first year — then winner in '19.",
    photos: [
      { src: '/images/wins/cliqtrix-team-1.jpg', alt: 'Cliqtrix finalists in Trixster t-shirts posing with certificates and a prize cheque', w: 960, h: 639 },
      { src: '/images/wins/cliqtrix-solo.jpg', alt: "Mariappan holding a Cliqtrix '18 certificate, prize cheque and trophy", w: 432, h: 720 },
      { src: '/images/wins/cliqtrix-team-2.jpg', alt: 'Cliqtrix winners group photo with prize cheques', w: 770, h: 513 },
      { src: '/images/wins/cliqtrix-team-3.jpg', alt: 'Cliqtrix winners in black Trixster t-shirts holding up their trophies and certificates', w: 1200, h: 707 },
      { src: '/images/wins/cliqtrix-team-4.jpg', alt: 'The Cliqtrix finalists seated on the steps outside a glass-fronted office building', w: 770, h: 513 },
    ],
    links: [
      { href: 'https://www.cliqtrix.com/archives/2018/?src=cliqtrix-header#winners', label: "'18 winners" },
      { href: 'https://www.cliqtrix.com/archives/2019/?src=cliqtrix-header#winners', label: "'19 winners" },
    ],
    wobbly: 'wobbly--2', tilt: 2,
  },
];
---
<BaseLayout title={`About | ${site.name}`} description={description} ogType="profile" current="about">
  <main id="main">
    <header class="wrap page-hero">
      <p class="eyebrow">About</p>
      <h1>A story in progress, written between commits and coffee.</h1>
      <p class="lede">By day I design and build interfaces for AI products at <a href={site.links.strivelabs}>Strivelabs</a>. Off the clock, it looks something like this. <span class="hand ink-coral">Currently compiling curiosity…</span></p>
    </header>

    <section class="section section--sand has-wave before-wave" style="margin-top: var(--wave-h)" id="journey" aria-labelledby="journey-title">
      <div class="wave" aria-hidden="true"></div>
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">The journey so far</p>
          <h2 id="journey-title">Six stops, <mark class="hl">one very long commit log.</mark></h2>
          <p class="journey-note hand">newest first, like git log<Icon name="arrow-down" /></p>
        </div>
        <ol class="journey">
          {journey.map((j) => (
            <li class:list={['stop', j.now && 'stop--now']}>
              <span class="stop-year" aria-hidden="true">{j.year}</span>
              <article class:list={['stop-card', 'wobbly', j.wobbly, `tilt-${j.tilt}`]}>
                <div class="stop-head">
                  <p class="stop-when">{j.now && <span class="live" aria-hidden="true"></span>}{j.when}</p>
                  <img class="stop-logo" src={j.logo} alt={j.company} height="24" loading="lazy">
                </div>
                <h3>
                  <span class="visually-hidden">{j.company}: </span>
                  {j.roles.map((r, i) => (<>{i > 0 && <Icon name="arrow-right" class="stop-arrow" />}<span>{r}</span></>))}
                </h3>
                <p class="stop-note">{j.note}</p>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--paper has-wave" id="wins" aria-labelledby="wins-title">
      <div class="wave wave--flip" aria-hidden="true"></div>
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Little wins</p>
          <h2 id="wins-title">The bits I'd put on a laptop sticker.</h2>
        </div>
        <ul class="wins">
          {wins.map((w) => (
            <li class:list={['win', 'wobbly', w.wobbly, `tilt-${w.tilt}`]} style={`--accent: var(--${w.accent})`}>
              {w.photos.length > 1 ? (
                /* Several photos: a full-width carousel, each shown whole over a blurred copy of itself. */
                <div class="win-carousel" data-carousel role="group" aria-roledescription="carousel" aria-label={`${w.title} photos`}>
                  <div class="win-track" data-carousel-track>
                    {w.photos.map((p, i) => (
                      <button class="win-slide" type="button" data-full={p.src} aria-label={`Photo ${i + 1} of ${w.photos.length}, view full size: ${p.alt}`}>
                        <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy">
                        <img class="win-slide-bg" src={p.src} alt="" aria-hidden="true" loading="lazy">
                        <span class="win-shot-hint" aria-hidden="true">view</span>
                      </button>
                    ))}
                  </div>
                  <button class="rail-btn win-nav win-nav--prev" type="button" data-carousel-prev aria-label="Previous photo"><Icon name="arrow-right" /></button>
                  <button class="rail-btn win-nav win-nav--next" type="button" data-carousel-next aria-label="Next photo"><Icon name="arrow-right" /></button>
                  <p class="win-count" aria-hidden="true"><span data-carousel-count>1</span> / {w.photos.length}</p>
                </div>
              ) : (
                <div class="win-photos">
                  {w.photos.map((p) => (
                    <button class="win-shot" type="button" data-full={p.src} aria-label={`View full size: ${p.alt}`}>
                      <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy">
                      <span class="win-shot-hint" aria-hidden="true">view</span>
                    </button>
                  ))}
                </div>
              )}
              <div class="win-body">
                <span class="win-badge"><Icon name={w.icon} /></span>
                <p class="win-when">{w.when}</p>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
                <div class="cluster win-links">
                  {w.links.map((l) => (
                    <a class="pill pill--soft" href={l.href} rel="noopener">{l.label}<Icon name="external" /></a>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="into" aria-labelledby="into-title">
      <div class="wrap">
        <hr class="rule" style="margin-bottom: var(--space-5)">
        <div class="dayoff-head">
          <p class="eyebrow">Off the clock</p>
          <h2 id="into-title">Thenga’s day off.</h2>
        </div>
        <!-- One board per pastime, from src/data/offclock.ts: Thenga and the words, then a reel of
             picks big enough to enjoy in place (the rail script in main.js drives the arrows), and
             an Instagram card for the rest. Tapping a pick still opens it in the lightbox below. -->
        <!-- Without JS nothing would clear .is-developing, so show the photos straight away. -->
        <noscript><style>.polaroid.is-developing img { opacity: 1; filter: none; } .polaroid-developing, .polaroid-photo::after { display: none; }</style></noscript>
        <ol class="boards">
          {pastimes.map((p, i) => {
            const cta = p.more ?? (p.picks.length ? 'More on' : 'Meanwhile, it’s all on');
            return (
              <li class="board" id={p.id} style={`--accent: var(--${p.accent}); --m-delay: -${(i * 0.7).toFixed(1)}s`} aria-labelledby={`${p.id}-title`}>
                <div class="board-head">
                  <div class="board-who">
                    <Thenga hobby={p.hobby} />
                    <p class="board-doing" aria-hidden="true">{p.doing}</p>
                  </div>
                  <div class="board-main">
                    <h3 id={`${p.id}-title`}>{p.title}</h3>
                    <p>{p.text}</p>
                    {p.picks.length === 0 && (p.link ? (
                      <a class="ig-card ig-card--inline" href={p.link.href} rel="noopener">
                        <Icon name="instagram" /><span>{cta}</span><strong>{p.link.label}</strong><Icon name="arrow-right" class="ig-go" />
                      </a>
                    ) : (
                      <p class="board-aside">{p.aside}</p>
                    ))}
                  </div>
                </div>
                {p.picks.length > 0 && (
                  <div class="reel" data-rail>
                    <div class="rail-controls reel-controls">
                      <button class="rail-btn" type="button" data-prev aria-label="Previous" aria-controls={`${p.id}-reel`}><Icon name="arrow-right" /></button>
                      <span class="rail-progress" aria-hidden="true"><i data-thumb></i></span>
                      <button class="rail-btn" type="button" data-next aria-label="Next" aria-controls={`${p.id}-reel`}><Icon name="arrow-right" /></button>
                    </div>
                    <ul class="rail-track reel-track" id={`${p.id}-reel`} data-track aria-label={`${p.title}: a few picks`}>
                      {p.picks.map((x) => (
                        <li class="reel-item">
                          <button class="polaroid is-developing" type="button" data-full={x.src} data-develop aria-label={`View full size: ${x.alt}`}>
                            <span class="polaroid-photo" style={thumb(x.src) ? `background-image: url(${thumb(x.src).lqip})` : undefined}>
                              <img src={thumb(x.src)?.sm ?? x.src} alt={x.alt} width={x.w} height={x.h} loading="lazy" decoding="async">
                              <span class="polaroid-developing" aria-hidden="true">developing…</span>
                            </span>
                            {x.caption && <span class="polaroid-caption" aria-hidden="true">{x.caption}</span>}
                          </button>
                        </li>
                      ))}
                      {p.link && (
                        <li class="reel-item reel-item--cta">
                          <a class="ig-card" href={p.link.href} rel="noopener">
                            <Icon name="instagram" />
                            <span>{cta}</span>
                            <strong set:html={p.link.label.replaceAll('.', '.<wbr>')} />
                            <Icon name="arrow-right" class="ig-go" />
                          </a>
                        </li>
                      )}
                      {!p.link && p.aside && (
                        <li class="reel-item reel-item--cta"><p class="ig-card ig-card--note">{p.aside}</p></li>
                      )}
                    </ul>
                  </div>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <dialog class="lightbox" data-lightbox aria-label="Photo">
      <button class="lightbox-close rail-btn" type="button" data-lightbox-close aria-label="Close"><Icon name="close" /></button>
      <figure>
        <img alt="" data-lightbox-img>
        <figcaption data-lightbox-caption></figcaption>
      </figure>
    </dialog>
  </main>
</BaseLayout>
