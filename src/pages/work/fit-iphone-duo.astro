        <code class="install">{installCmd}</code>
        <span class="deep-dive-go">Open it on GitHub<Icon name="arrow-right" /></span>
      </span>
    </a>
    <div class="get-it">
      <a class="get-link" href={playground} rel="noopener">Playground <Icon name="external" class="doodle--thin" /></a>
      <a class="get-link" href={report} rel="noopener">Sample report <Icon name="external" class="doodle--thin" /></a>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Screenshot">
