---
/* tune-search, told as an interactive lesson rather than a case study: the org switcher
   that closed while I typed, the question I couldn't answer (what's the right height?),
   stepping back to learn search from scratch, then each lesson as a question the reader
   answers before a simulation shows untuned and tuned side by side. Then the lab, the
   skill, how it was tested, and the switcher fixed. The sims are drawn by
   ../../scripts/tune-search.ts and styled in ../../styles/tune-search.css; without the
   script the answers simply show. Sources: the skill's journey/search/ journal and
   research notes (not published). Media lives in public/images/work/tune-search/.
   The switcher recordings are Mari's own, cropped to the sidebar from full-screen captures. */
import WorkLayout from '../../layouts/WorkLayout.astro';
import Icon from '../../components/Icon.astro';
import StudioLoop from '../../components/sketches/studio/StudioLoop.astro';
import { skillsRepo, installCmd } from '../../data/skills';
import '../../styles/tune-search.css';

const img = (f: string) => `/images/work/tune-search/${f}`;
const skillUrl = `${skillsRepo}/tree/main/skills/tune-search`;
const lab = 'https://marigameo.github.io/search-lab/';
const sampleReport = `${skillUrl}/sample-report`;
const description = 'tune-search, a skill that fixes search as you type: how a broken org switcher in my own product turned into learning search from scratch, a lab to feel the difference, and a skill that finds, fixes and proves it. Told as questions you answer, with simulations of untuned and tuned search. Built by me, paired with Claude.';

// Screen recordings of the real switcher, cropped to the sidebar. They play while in view.
const recordings = {
  before: {
    src: img('switcher-before.mp4'), poster: img('switcher-before.webp'), tag: 'Before',
    label: 'Screen recording of the org switcher before the fix. The account menu opens from the sidebar and the organisation list appears beside it, tall. Typing “ahr” shrinks the list to one row, the panel drops down beside its menu row, and then it closes.',
    caption: 'The real switcher. Three letters in, the panel shrinks, drops and closes.',
  },
  after: {
    src: img('switcher-after.mp4'), poster: img('switcher-after.webp'), tag: 'After',
    label: 'Screen recording of the org switcher after the fix. Typing “ahr”, then “am”, then “l” filters the list while the panel keeps its height, with Add organisation pinned at the bottom, and it stays open throughout.',
    caption: 'The same switcher after the fix. It keeps its height and stays open as I type.',
  },
};

const kinds = [
  { name: 'Typeahead', sub: 'a dropdown under the box', tone: 'coral' },
  { name: '⌘K palette', sub: 'a modal you summon', tone: 'blue' },
  { name: 'Live results page', sub: 'a page that updates as you type', tone: 'teal' },
  { name: 'Picker', sub: 'pick one from a list, like my switcher', tone: 'violet' },
];

const learnt = [
  { value: '7', label: 'topics' },
  { value: '3', label: 'live teardowns' },
  { value: '45', label: 'rules' },
  { value: '6', label: 'principles' },
];

const principles = [
  { title: 'Every result knows its query', sub: 'An answer for an old query never lands.' },
  { title: 'Identity, not position', sub: 'Highlight, rows and dedupe by ID, never by index.' },
  { title: 'Remove the cause, never reschedule it', sub: '“Dim later” and “resize later” only move the glitch.' },
  { title: 'People set the timing, frequency sets the motion', sub: 'The more often it happens, the less it moves.' },
  { title: 'The user owns the input', sub: 'Focus stays, text is never lost, the keyboard’s keys are the keyboard’s.' },
  { title: 'Prove it in frames', sub: 'A 36ms blink and a working guard both look fine live.' },
];

const stats = [
  { value: '12', label: 'Checks, each proven to bite', sub: 'Every one fails the lab’s naive search and passes the tuned one', ink: 'coral' },
  { value: '33 → 0', label: 'A fresh agent, only the skill', sub: 'On a scrubbed copy: 33 failures found, none left on checks it never saw', ink: 'blue' },
  { value: '18', label: 'Notes back into the skill', sub: 'That same agent found the harness’s subtlest bug', ink: 'teal' },
  { value: '36ms', label: 'Wikipedia’s loading row', sub: 'On screen for 36ms. Invisible live, obvious in frames', ink: 'violet' },
];

const lessons = [
  { miss: 'Asked for a fix before I knew what right looked like.', lesson: 'Step back and learn the thing. Once I could name the bug, the fix was one rule.' },
  { miss: 'Fixed a flicker by doing it later: dim later, resize later.', lesson: 'Moving a glitch doesn’t remove it. Remove its cause.' },
  { miss: 'Watched it live and called it fine.', lesson: 'These bugs last 36ms, or look like waiting. Look at frames.' },
  { miss: 'Trusted the tuned version because we wrote it.', lesson: 'Test equipment is a product. A check counts only once it fails something broken.' },
];

const credits = [
  { href: 'https://www.nngroup.com/articles/response-times-3-important-limits/', source: 'Nielsen Norman Group', title: 'Response times: the 3 important limits', note: 'Why 100ms and 1s, from Card, Miller and Nielsen.' },
  { href: 'https://github.com/smeijer/spin-delay', source: 'smeijer', title: 'spin-delay', note: 'The delay and minimum pair, as a library.' },
  { href: 'https://www.w3.org/WAI/ARIA/apg/patterns/combobox/', source: 'W3C', title: 'ARIA combobox pattern', note: 'The keyboard and screen reader contract.' },
  { href: 'https://github.com/emilkowalski/skills', source: 'Emil Kowalski', title: 'Design engineering skills', note: 'Motion by frequency, not size.' },
  { href: 'https://github.com/thedaviddias/ux-patterns-for-developers', source: 'thedaviddias', title: 'UX patterns for developers', note: 'The closest prior art: search, autocomplete and palette cards.' },
];

const play = '<svg viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1l7 4-7 4z"/></svg>';
---
<WorkLayout
  title="tune-search — search that doesn’t jump, flicker or lie"
  description={description}
  ogDescription="My org switcher closed while I typed. Fixing it properly meant learning search from scratch. Now it’s a skill."
  eyebrow="Open source · Design engineer · Nov 2026"
  heading="tune-search"
  facts={[
    { label: 'Role', value: 'Solo build, paired with Claude' },
    { label: 'Status', value: 'Open source (MIT), in my skills repo. Lab live' },
  ]}
  link={{ href: skillUrl, label: 'GitHub' }}
  schema={{
    name: 'tune-search',
    url: skillUrl,
    description: 'An agent skill that fixes search as you type (typeahead dropdowns, ⌘K palettes, live results pages, and the layout and keys of pickers): it finds the searches in a product, audits them in a real browser under slow, failing and out-of-order networks, fixes the causes in the product’s own code on the owner’s go, and proves the fix with the same checks. With a lab that shows the same search untuned and tuned.',
    inLanguage: 'en',
    keywords: 'search, combobox, typeahead, command palette, race conditions, loading states, layout shift, accessibility, IME, agent skills, Playwright, design engineering, designing with Claude',
  }}
>
  <Fragment slot="lede">My org switcher closed every time I typed in it. Fixing it properly meant learning what <mark class="hl">search really is</mark>, from scratch. This story asks you the questions I had to answer. Pick one, and watch it play out.</Fragment>

  <Fragment slot="glance">
    <div class="at-glance-row">
      <h3>The aim</h3>
      <p>Fix my switcher the right way, not the quick way. Then make the right way a prompt away for any search, since agents don’t get it right on their own.</p>
    </div>
    <div class="at-glance-row">
      <h3>My part</h3>
      <div>
        <ul class="doodle-list">
          <li><strong>The bug,</strong> and the question behind it: what is the right fix?</li>
          <li><strong>Every call,</strong> from the scope to what the lab and the report should feel like.</li>
          <li><strong>The trial</strong> on my own product, tested by hand.</li>
        </ul>
        <p>Claude researched, built and tested. I learnt, set the direction and made the calls.</p>
      </div>
    </div>
    <div class="at-glance-row">
      <h3>Shipped</h3>
      <p>A skill on <a href={skillUrl} rel="noopener">GitHub</a>, a <a href={lab} rel="noopener">live lab</a> with untuned and tuned side by side, and a switcher that stays open.</p>
    </div>
  </Fragment>

  <div class="story">
    <section class="slide" aria-labelledby="s-bug">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">01</span>
        <div><p class="slide-kicker">Where it started</p><h2 id="s-bug">A switcher that closed while I typed</h2></div>
      </header>
      <ul class="doodle-list slide-points">
        <li>In our platform, you switch organisations from a menu in the sidebar. Type to find one, and <strong>the panel jumps, then closes</strong>. Open it again, scroll, click.</li>
        <li>An agent wrote it in one shot. It looked fine, and broke the moment you used it. <strong>Agents don’t catch this kind of bug themselves.</strong></li>
      </ul>
      <figure class="rec">
        <span class="shot-frame"><video src={recordings.before.src} poster={recordings.before.poster} width="930" height="876" muted loop playsinline preload="none" data-inview-video aria-label={recordings.before.label}></video><span class="ba-tag" aria-hidden="true">{recordings.before.tag}</span></span>
        <figcaption>{recordings.before.caption}</figcaption>
      </figure>
    </section>

    <section class="slide" aria-labelledby="s-question">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">02</span>
        <div><p class="slide-kicker">The question</p><h2 id="s-question">What is the right fix, though?</h2></div>
      </header>
      <ul class="doodle-list slide-points">
        <li>The height changing was clearly the cause. But I wasn’t sure what <strong>right</strong> looked like, and neither was the agent.</li>
      </ul>
      <div class="call" data-call>
        <p class="call-kicker">Your call</p>
        <p class="call-q">As results filter, what should the panel’s height do?</p>
        <div class="call-opts">
          <button class="call-opt" type="button" data-opt>Fit the results</button>
          <button class="call-opt" type="button" data-opt>Hold, then resize when typing stops</button>
          <button class="call-opt" type="button" data-opt data-right>Never shrink while open</button>
          <button class="call-skip" type="button" data-opt data-skip>Just show me</button>
        </div>
        <div class="call-reveal" data-reveal>
          <span class="call-verdict" data-verdict></span>
          <div class="sim" data-sim="height">
            <div class="sim-bar"><p>Typing “invoice” into three panels.</p><button class="sim-play" type="button" data-play><Fragment set:html={play} />Replay</button></div>
            <div class="sim-stages"></div>
            <p class="sim-fallback">A jumps twice as you type. B holds, then jumps once, right as you start reading. C never jumps.</p>
          </div>
          <p class="call-answer"><strong>Never shrink while open.</strong> Grow-only for a dropdown, a fixed height for a ⌘K palette. Resizing “once typing stops” only moves the jump to the moment you start reading.</p>
          <aside class="said" aria-label="My first guess">
            <p><span>My first guess</span>“I’d maintain a constant height for the panel &amp; adjust after a delay just like how it’s debounced.”</p>
            <img src="/images/portraits/me.webp" alt="" width="80" height="80" loading="lazy" decoding="async">
          </aside>
          <p class="rule-chip">Principle 3 · Remove the cause, never reschedule it</p>
        </div>
      </div>
    </section>

    <section class="slide" aria-labelledby="s-back">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">03</span>
        <div><p class="slide-kicker">Stepping back</p><h2 id="s-back">Search turned out to be a family</h2></div>
      </header>
      <ul class="doodle-list slide-points">
        <li>So I stopped fixing, and started learning: what kinds of search there are, how they behave over time, what applies where. <strong>There was far more to it than I’d assumed.</strong></li>
        <li>Nobody had written it down for agents. The closest skills stop at ARIA roles and keys. <strong>None covers what happens while results arrive.</strong></li>
      </ul>
      <ul class="kinds">
        {kinds.map((k, i) => (
          <li class:list={['sk-box', `sk-box--${k.tone}`, `sk-lean-${(i % 3) + 1}`]}><strong>{k.name}</strong><span>{k.sub}</span></li>
        ))}
      </ul>
      <ul class="learnt" aria-label="What the learning came to">
        {learnt.map((l) => <li><b>{l.value}</b>{l.label}</li>)}
      </ul>
      <aside class="said" aria-label="My brief, before the learning">
        <p><span>Me, at the start</span>“Search bar is a simple yet a unique unit of web which can involve lots of states &amp; transitions. So many get it wrong &amp; agents mess up with perfection.”</p>
        <img src="/images/portraits/me.webp" alt="" width="80" height="80" loading="lazy" decoding="async">
      </aside>
    </section>

    <section class="slide" aria-labelledby="s-race">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">04</span>
        <div><p class="slide-kicker">Lesson · state</p><h2 id="s-race">The slow answer that wins</h2></div>
      </header>
      <div class="call" data-call>
        <p class="call-kicker">Your call</p>
        <p class="call-q">You type “typography”. The answer for “typo” was slow and lands last. What’s on screen?</p>
        <div class="call-opts">
          <button class="call-opt" type="button" data-opt>Results for “typography”</button>
          <button class="call-opt" type="button" data-opt data-right>Results for “typo”</button>
          <button class="call-skip" type="button" data-opt data-skip>Just show me</button>
        </div>
        <div class="call-reveal" data-reveal>
          <span class="call-verdict" data-verdict></span>
          <div class="sim" data-sim="race">
            <div class="sim-bar"><p>Same typing, same network.</p><button class="sim-play" type="button" data-play><Fragment set:html={play} />Replay</button></div>
            <div class="sim-stages"></div>
            <div class="sim-extra"></div>
            <p class="sim-fallback">Untuned: “typo” lands last and replaces the right results. Tuned: it’s dropped.</p>
          </div>
          <p class="call-answer">Without a guard, <strong>whichever answer lands last wins</strong>. The fix is one check: an answer is shown only if it belongs to the current query. Cancelling old requests saves the server; the guard keeps the screen right.</p>
          <aside class="said" aria-label="What I assumed">
            <p><span>What I assumed</span>“Always the latest query results is what I finally see on screen I guess.”</p>
            <img src="/images/portraits/me.webp" alt="" width="80" height="80" loading="lazy" decoding="async">
          </aside>
          <p class="rule-chip">Principle 1 · Every result knows its query</p>
        </div>
      </div>
    </section>

    <section class="slide" aria-labelledby="s-blink">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">05</span>
        <div><p class="slide-kicker">Lesson · time</p><h2 id="s-blink">A spinner that flashes is worse than none</h2></div>
      </header>
      <div class="call" data-call>
        <p class="call-kicker">Your call</p>
        <p class="call-q">Results take 200ms. The list dims after 150ms to say “loading”. What does the user see?</p>
        <div class="call-opts">
          <button class="call-opt" type="button" data-opt>Nothing, it’s quick</button>
          <button class="call-opt" type="button" data-opt>A clear loading state</button>
          <button class="call-opt" type="button" data-opt data-right>A flicker</button>
          <button class="call-skip" type="button" data-opt data-skip>Just show me</button>
        </div>
        <div class="call-reveal" data-reveal>
          <span class="call-verdict" data-verdict></span>
          <div class="sim" data-sim="blink">
            <div class="sim-bar">
              <div class="sim-chips" role="group" aria-label="Server answers in"><span>Answers in</span><button type="button" data-latency="80" aria-pressed="false">80ms</button><button type="button" data-latency="200" aria-pressed="true">200ms</button><button type="button" data-latency="900" aria-pressed="false">900ms</button></div>
              <button class="sim-play" type="button" data-play><Fragment set:html={play} />Replay</button>
            </div>
            <div class="sim-stages"></div>
            <p class="sim-fallback">At 200ms, the untuned list dims for 50ms: a flicker. The tuned one, once dimmed, stays dimmed 300ms.</p>
          </div>
          <p class="call-answer">A 50ms flicker, three times over. Wait 150ms before showing a wait, and <strong>once shown, keep it at least 300ms</strong>. Neither number depends on the server. They come from people, so a skill can ship them.</p>
          <aside class="said" aria-label="My question">
            <p><span>My question</span>“How do I know this time range in real requests? I’ll not know how long server would take right?”</p>
            <img src="/images/portraits/me.webp" alt="" width="80" height="80" loading="lazy" decoding="async">
          </aside>
          <p class="rule-chip">Principle 4 · People set the timing</p>
        </div>
      </div>
    </section>

    <section class="slide" aria-labelledby="s-highlight">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">06</span>
        <div><p class="slide-kicker">Lesson · arrivals</p><h2 id="s-highlight">Enter opens what you chose</h2></div>
      </header>
      <div class="call" data-call>
        <p class="call-kicker">Your call</p>
        <p class="call-q">You arrow down to “Designers team page”. Server results arrive. You press Enter. What opens?</p>
        <div class="call-opts">
          <button class="call-opt" type="button" data-opt>Designers team page</button>
          <button class="call-opt" type="button" data-opt data-right>Depends where the results land</button>
          <button class="call-skip" type="button" data-opt data-skip>Just show me</button>
        </div>
        <div class="call-reveal" data-reveal>
          <span class="call-verdict" data-verdict></span>
          <div class="sim" data-sim="highlight">
            <div class="sim-bar"><p>Local rows first, the server’s a second later.</p><button class="sim-play" type="button" data-play><Fragment set:html={play} />Replay</button></div>
            <div class="sim-stages"></div>
            <div class="sim-extra"></div>
            <p class="sim-fallback">Untuned: results land on top, the highlight stays at row 2, and Enter opens something you never chose.</p>
          </div>
          <p class="call-answer">If the highlight is a row number and results land above, <strong>Enter silently opens something else</strong>. Keep the highlight by ID, and let new results arrive below, in their own section.</p>
          <p class="rule-chip">Principle 2 · Identity, not position</p>
        </div>
      </div>
    </section>

    <section class="slide" aria-labelledby="s-bold">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">07</span>
        <div><p class="slide-kicker">Lesson · layout</p><h2 id="s-bold">Bold moves things</h2></div>
      </header>
      <div class="call" data-call>
        <p class="call-kicker">Your call</p>
        <p class="call-q">The matched letters are bold, as in most searches. Harmless?</p>
        <div class="call-opts">
          <button class="call-opt" type="button" data-opt>Harmless</button>
          <button class="call-opt" type="button" data-opt data-right>The row shifts as you type</button>
          <button class="call-skip" type="button" data-opt data-skip>Just show me</button>
        </div>
        <div class="call-reveal" data-reveal>
          <span class="call-verdict" data-verdict></span>
          <div class="sim" data-sim="emphasis">
            <div class="sim-bar"><p>Measured live, as you watch.</p><button class="sim-play" type="button" data-play><Fragment set:html={play} />Replay</button></div>
            <div class="sim-stages"></div>
            <p class="sim-fallback">Bold letters are wider, so every keystroke nudges the rest of the row. Colour costs no width.</p>
          </div>
          <p class="call-answer">Bold letters are wider, so <strong>every keystroke nudges the row</strong>. Italic does too. Mark the match with colour or a highlight. And nothing per keystroke should animate: the more often something happens, the less it should move.</p>
          <aside class="said" aria-label="My guess">
            <p><span>My guess</span>“I will not use bold if it adds some weight &amp; results in shift […] may be em.”</p>
            <img src="/images/portraits/me.webp" alt="" width="80" height="80" loading="lazy" decoding="async">
          </aside>
          <p class="rule-chip">Principle 4 · Frequency sets the motion</p>
        </div>
      </div>
    </section>

    <section class="slide" aria-labelledby="s-keys">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">08</span>
        <div><p class="slide-kicker">Lesson · keys</p><h2 id="s-keys">Two keys nobody tests</h2></div>
      </header>
      <div class="call" data-call>
        <p class="call-kicker">Your call · 1 of 2</p>
        <p class="call-q">Text typed, panel open. You press Escape once. What should happen?</p>
        <div class="call-opts">
          <button class="call-opt" type="button" data-opt>Clear the text</button>
          <button class="call-opt" type="button" data-opt data-right>Close the panel, keep the text</button>
          <button class="call-opt" type="button" data-opt>Drop the highlight</button>
        </div>
        <div class="call-reveal" data-reveal>
          <span class="call-verdict" data-verdict></span>
          <div class="sim" data-sim="escape">
            <div class="sim-bar"><p>One Escape, both ways.</p><button class="sim-play" type="button" data-play><Fragment set:html={play} />Replay</button></div>
            <div class="sim-stages"></div>
            <div class="sim-extra"></div>
            <p class="sim-fallback">Untuned: one Escape closes and wipes your text. Tuned: it closes, and your text stays.</p>
          </div>
          <p class="call-answer"><strong>One press, one undo</strong>, smallest first: close, then clear. Never lose typed text on the way out. I added a step for the highlight; not wrong, just one press too many.</p>
          <p class="rule-chip">Principle 5 · The user owns the input</p>
        </div>
      </div>
      <div class="call" data-call>
        <p class="call-kicker">Your call · 2 of 2</p>
        <p class="call-q">Typing Japanese, you press Enter to confirm 東京. What should the search do?</p>
        <div class="call-opts">
          <button class="call-opt" type="button" data-opt>Open the first result</button>
          <button class="call-opt" type="button" data-opt data-right>Nothing. That Enter was the keyboard’s</button>
        </div>
        <div class="call-reveal" data-reveal>
          <span class="call-verdict" data-verdict></span>
          <div class="sim" data-sim="ime">
            <div class="sim-bar"><p>A Japanese input method, mid-word.</p><button class="sim-play" type="button" data-play><Fragment set:html={play} />Replay</button></div>
            <div class="sim-stages"></div>
            <div class="sim-extra"></div>
            <p class="sim-fallback">Untuned: Enter opens “Tokyo office”. Tuned: Enter only confirms the characters.</p>
          </div>
          <p class="call-answer">While a Japanese, Chinese or Korean keyboard is composing, <strong>every key belongs to it</strong>. Safari even reports that Enter after composing ends, so the usual check misses it.</p>
          <p class="rule-chip">Principle 5 · The user owns the input</p>
        </div>
      </div>
    </section>

    <section class="slide" aria-labelledby="s-principles">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">09</span>
        <div><p class="slide-kicker">What it came to</p><h2 id="s-principles">Six principles under 45 rules</h2></div>
      </header>
      <ol class="principles">
        {principles.map((p, i) => (
          <li class:list={['sk-box', `sk-lean-${(i % 3) + 1}`]}><b>{i + 1}</b><strong>{p.title}</strong><span>{p.sub}</span></li>
        ))}
      </ol>
    </section>

    <section class="slide" aria-labelledby="s-lab">
      <header class="slide-head">
        <span class="slide-num" aria-hidden="true">10</span>
        <div><p class="slide-kicker">The playground</p><h2 id="s-lab">A lab to feel the difference</h2></div>
      </header>
      <ul class="doodle-list slide-points">
        <li>The same search twice, <strong>naive and tuned, side by side</strong>, on the same network. A dropdown, a ⌘K palette and a results page, from fast wifi down to slow 3G, with a button that fails the next request.</li>
      </ul>
      <figure class="shot-fig">
        <a class="zoom" href={lab} rel="noopener" aria-label="Open the search lab">
          <span class="shot-frame">
