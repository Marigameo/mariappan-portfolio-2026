---
/* A project write-up: breadcrumb, title, lede, facts, the article, and a back link.
   Pages pass the facts as props, the lede in the "lede" slot, and the write-up as children.
   An optional "glance" slot holds .at-glance-row blocks (problem, my part, shipped) under the facts.
   Laid out in the side-column frame of the posts (.side-page in style.css): the
   header across the full frame, then the story at its usual 46rem on the left and,
   beside it, Thenga (laptop for work, hammer for side builds) over "On this page"
   (the slides), so nothing jumps sideways coming from the listing pages. */
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Thenga from '../components/mascots/Thenga.astro';
import PageToc from '../components/PageToc.astro';
import { site } from '../data/site';
import { projects } from '../data/work';

interface Props {
  /** Browser/OG title, e.g. "Report builder | Work | Mariappan Subramanian" (suffix added here). */
  title: string;
  description: string;
  /** Shorter text for social cards. Defaults to `description`. */
  ogDescription?: string;
  /** The visible <h1>. */
  heading: string;
  /** BCP-47 language of the heading when it is not English (e.g. "ta"). */
  headingLang?: string;
  /** A quiet gloss beside a non-English heading, e.g. its reading and meaning. */
  headingNote?: string;
  /** Small mono label above the heading, e.g. "Strive Labs · 2024 → now". */
  eyebrow?: string;
  facts: { label: string; value: string }[];
  link: { href: string; label: string };
  /** Feeds the schema.org CreativeWork block. */
  schema: {
    name: string;
    alternateName?: string;
    url: string;
    description: string;
    inLanguage: string | string[];
    keywords: string;
  };
}

const { title, description, ogDescription, heading, headingLang, headingNote, eyebrow, facts, link, schema } = Astro.props;
// Thenga at work or tinkering, as on the Work page's tabs.
const kind = projects.find((p) => Astro.url.pathname === `/work/${p.slug}/`)?.kind;
const mascot = kind === 'side-builds' ? 'hammer' : 'laptop';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: schema.name,
  ...(schema.alternateName ? { alternateName: schema.alternateName } : {}),
  url: schema.url,
  description: schema.description,
  author: { '@type': 'Person', name: site.name, url: `${site.url}/` },
  inLanguage: schema.inLanguage,
  keywords: schema.keywords,
};
---
<BaseLayout title={`${title} | Work | ${site.name}`} description={description} ogDescription={ogDescription} ogType="article" current="work" jsonLd={jsonLd}>
  <main id="main" class="wrap side-page">
    <header class="page-hero side-hero">
      <div class="hero-text">
        <a class="breadcrumb" href="/work/"><Icon name="arrow-right" />All work</a>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 lang={headingLang}>{heading}{headingNote && <span class="title-note" lang="en">{headingNote}</span>}</h1>
        <p class="lede"><slot name="lede" /></p>
        <dl class="facts">
          {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
          <div><dt>Link</dt><dd><a href={link.href} rel="noopener">{link.label} <Icon name="external" class="doodle--thin" /></a></dd></div>
        </dl>
      </div>
    </header>
    <div class="side-body">
      <div class="side-main">

        {Astro.slots.has('glance') && (
          <section class="at-glance" aria-labelledby="at-glance-title">
            <h2 id="at-glance-title" class="at-glance-title">At a glance</h2>
            <slot name="glance" />
          </section>
        )}

        {Astro.slots.has('sketch') && (
          <figure class="work-shot taped">
            <slot name="sketch" />
          </figure>
        )}

        <article class="prose">
          <slot />
        </article>

        <p style="margin-top: var(--space-4)">
          <a class="pill" href="/work/"><Icon name="arrow-right" style="transform:scaleX(-1)" />Back to all work</a>
        </p>
      </div>
      <aside class="side-col">
        <div class="side-mascot" aria-hidden="true"><Thenga hobby={mascot} /></div>
        <PageToc heads=".prose .slide h2[id], .prose > h2[id]" />
      </aside>

    </div>
  </main>
</BaseLayout>

<style>
  /* Hero thumbnail on a project page — the same card sketch, sized for the top of the write-up.
     Own class (not .shot) so the rail's card-layout rules don't apply here. */
  .work-shot {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: var(--space-3) 0 var(--space-4);
    overflow: hidden;
    border: 1.5px solid var(--border);
    border-radius: 10px 5px 12px 6px / 6px 12px 5px 10px;
    background: var(--sand);
    box-shadow: 4px 4px 0 var(--shadow-ink);
    transform: rotate(-0.8deg);
  }
  .work-shot :global(.sk) { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
