---
/* A story figure with two views: the hand-drawn sketch (the default slot) and the
   real product, a screenshot or a short muted loop. Two small tabs switch between
   them; main.js wires the tabs (arrow keys too) and plays the loop only while it's
   showing, never on its own under reduced motion. Without JS the sketch shows.

   <SketchLive id="slots" live={{ kind: 'image', src, width, height, alt }} caption="…">
     <CanvasBeforeAfter />
   </SketchLive>

   A tall image (a full-page doc) can pass `scroll: 'scroll the real doc'`: it keeps its
   readable width inside a short frame that scrolls, with a fade and that hint below.
   `start="live"` opens on the real product instead (the studio stories lead with it);
   a video still waits for its Play button. */
interface Live {
  kind: 'image' | 'video';
  src: string;
  width: number;
  height: number;
  alt: string;
  /** Still frame for a video: shown before it plays and under reduced motion. */
  poster?: string;
  /** Tall images only: scroll inside a short frame, with this hint below it. */
  scroll?: string;
}
interface Props {
  /** Unique on the page; builds the tab and panel ids. */
  id: string;
  live: Live;
  /** One line under the live view. */
  caption?: string;
  /** Which tab shows first. Defaults to the sketch. */
  start?: 'sketch' | 'live';
}

const { id, live, caption, start = 'sketch' } = Astro.props;
const onLive = start === 'live';
const t = (k: string) => `sl-${id}-${k}`;
---
<div class="sl" data-sketch-live>
  <div class="sl-tabs" role="tablist" aria-label="Sketch or the real product">
    <button class="sl-tab" type="button" role="tab" id={t('tab-sketch')} aria-controls={t('sketch')} aria-selected={onLive ? 'false' : 'true'} tabindex={onLive ? '-1' : undefined}>Sketch</button>
    <button class="sl-tab" type="button" role="tab" id={t('tab-live')} aria-controls={t('live')} aria-selected={onLive ? 'true' : 'false'} tabindex={onLive ? undefined : '-1'}><span class="sl-dot" aria-hidden="true"></span>Live</button>
  </div>
  <div class="sl-panel" role="tabpanel" id={t('sketch')} aria-labelledby={t('tab-sketch')} hidden={onLive}>
    <slot />
  </div>
  <div class="sl-panel" role="tabpanel" id={t('live')} aria-labelledby={t('tab-live')} hidden={!onLive}>
    <figure class="sl-live">
      <div class:list={['sl-frame', live.scroll && 'sl-frame--scroll']}>
        {live.scroll ? (
          <div class="sl-scroll" tabindex="0" role="region" aria-label={`${live.alt} Scrolls.`}>
            <img src={live.src} width={live.width} height={live.height} alt={live.alt} loading="lazy" decoding="async">
          </div>
        ) : live.kind === 'video' ? (
          <video src={live.src} poster={live.poster} width={live.width} height={live.height} muted loop playsinline preload="none" aria-label={live.alt} data-sl-video></video>
        ) : (
          <img src={live.src} width={live.width} height={live.height} alt={live.alt} loading="lazy" decoding="async">
        )}
        {live.kind === 'video' && <button class="sl-play" type="button" data-sl-play aria-pressed="false">Play</button>}
      </div>
      {live.scroll && <p class="sl-hint sk-hand" aria-hidden="true">{live.scroll} ↓</p>}
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  </div>
</div>
