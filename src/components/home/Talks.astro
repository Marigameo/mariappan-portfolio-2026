---
/* Three talks as ticket stubs: the ones marked `featured` in src/data/talks.ts. */
import HomeSection from './HomeSection.astro';
import Ticket from './Ticket.astro';
import { talks } from '../../data/talks';

const picks = talks.filter((t) => t.featured);
---
<HomeSection flip id="talks" tone="sand" eyebrow="On stage" title="Talks" more={{ href: '/talks/', label: 'See all talks' }}>
  <div class="grid grid--3 tickets">
    {picks.map((t) => <Ticket {...t} />)}
  </div>
</HomeSection>
