---
import Ticket from './Ticket.astro';
import { talks } from '../../data/talks';
---
<section class="section section--paper has-wave" id="talks" aria-labelledby="talks-title">
  <div class="wave wave--flip" aria-hidden="true"></div>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">On stage</p>
      <h2 id="talks-title">Talks</h2>
      <p>Things I've said out loud, on stage, to rooms of front-end folks. Keep the stub.</p>
    </div>
    <div class="grid grid--3 tickets">
      {talks.map((t) => <Ticket {...t} />)}
    </div>
  </div>
</section>
