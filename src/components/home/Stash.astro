---
/* The door to Thenga's yard (/experiments/): one wide card under the rails. The
   thumbnail is Thenga with a few experiments floating around it, each a coconut
   in its own mood with a name tag. The only idle motion is a slow float; the
   coconuts' mood loops play while the card is hovered (.m-hover-host). The scene
   is decorative (aria-hidden); the card's label says where it goes.
   Entries live in src/data/experiments.ts; `floaters` picks which ones float,
   with a short tag so the names stay readable at thumbnail size. Up top, the
   studio's painter (Thenga with a brush) floats with the latest studio story.
   The card is one big link to /experiments/ ("Step inside" stretches over it),
   with the three rooms as their own small links in the foot, straight into each. */
import Icon from '../Icon.astro';
import Thenga from '../mascots/Thenga.astro';
import { moods, experiments, experimentCount } from '../../data/experiments';
import { studio } from '../../data/studio';
import { rooms, roomHref } from '../../data/rooms';

// Order matters: phones show only 1, 2, 5 and 6, so those four cover all three moods.
const floaters = [
  { id: 'zendesk-clickup', tag: 'ClickUp app' },
  { id: 'accetoss', tag: 'Accetoss' },
  { id: 'quickfix', tag: 'Quickfix' },
  { id: 'mardi-ai', tag: 'Mardi AI' },
  { id: 'penaltyvaultz', tag: 'PenaltyVaultz' },
  { id: 'economize', tag: 'economize' },
]
  .map((f) => ({ ...f, item: experiments.find((x) => x.id === f.id) }))
  .filter((f) => f.item);

---
<div class="wrap">
  <div class="stash-card m-hover-host">
    <span class="stash-shot taped" aria-hidden="true">
      <span class="float-hero">
        <Thenga />
        <span class="float-count">{experimentCount} on the pile</span>
      </span>
      <span class="floater floater--studio">
        <Thenga hobby="brush" />
        <span class="floater-tag">KB homepage</span>
      </span>
      {floaters.map((f, i) => (
        <span class:list={['floater', `floater--${i + 1}`]}>
          <Thenga mood={f.item!.mood} />
          <span class="floater-tag">{f.tag}</span>
        </span>
      ))}
    </span>
    <div class="stash-body">
      <span class="stash-eyebrow"><span><span>Thenga’s studio + yard</span> · <span>{studio.length} on the easel</span> · <span>{experimentCount} on the pile</span></span></span>
      <strong class="stash-title">Every coconut’s a keeper.</strong>
      <span class="stash-text">In the studio, I take apart screens I’ve redesigned and show what changed. Out in the yard, experiments keep piling up. Not all of them became palms, but every one cracked open with something worth keeping.</span>
      <span class="stash-moods">
        {Object.values(moods).map((m) => <span class="tag">{m.label}</span>)}
      </span>
      <div class="stash-foot">
        <nav class="stash-rooms" aria-label="Rooms">
          {rooms.map((r) => <a class="stash-room" href={roomHref(r.id)}>{r.name}<span>{r.count}</span></a>)}
        </nav>
        <a class="stash-go" href="/experiments/" aria-label={`Step inside Thenga’s studio + yard: ${studio.length} UI ${studio.length === 1 ? 'story' : 'stories'} and ${experimentCount} experiments, and what I found inside each`}>Step inside<Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</div>

<style>
  .stash-card { position: relative; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: center; gap: 1.5rem 2.5rem; margin-top: var(--space-5); padding: 1.5rem 2rem 1.5rem 1.5rem; text-decoration: none; color: var(--ink); background: var(--paper-2); border: 1.5px solid var(--border); border-radius: var(--radius-wobble-2); box-shadow: 4px 4px 0 var(--shadow-ink); transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s ease; }
  .stash-card::before { content: ""; position: absolute; inset: -6px; border: 1.5px solid #9a6440; border-radius: inherit; transform: rotate(.5deg); opacity: .5; pointer-events: none; transition: transform .25s ease, opacity .25s ease; }
  .stash-card:hover { color: var(--ink); transform: translateY(-4px); box-shadow: 6px 8px 0 var(--shadow-ink); }
  .stash-card:hover::before { transform: rotate(-.4deg); opacity: .85; }

  /* The scene: taped on like the rail thumbnails. Every piece is placed by its
     centre, in percentages of the frame, so it scales with the card. */
  .stash-shot { position: relative; display: block; aspect-ratio: 16 / 10; border: 1.5px solid var(--border); border-radius: 10px 5px 12px 6px / 6px 12px 5px 10px; background: var(--sand); box-shadow: 4px 4px 0 var(--shadow-ink); transform: rotate(-1.2deg); transition: transform .3s cubic-bezier(.2,.8,.2,1); }
  .stash-card:hover .stash-shot { transform: rotate(0); }
  .stash-shot.taped::before { top: -.75rem; left: 18%; width: 5rem; height: 1.3rem; transform: rotate(-4deg); z-index: 1; }

  .float-hero { position: absolute; left: 50%; top: 52%; width: 27%; display: grid; justify-items: center; transform: translate(-50%, -50%); }
  .float-hero :global(.mascot) { width: 100%; }
  .float-count { margin-top: -.2rem; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); white-space: nowrap; }

  .floater { --x: 50%; --y: 50%; --t: 5s; --d: 0s; --r: 0deg; position: absolute; left: var(--x); top: var(--y); width: 13%; display: grid; justify-items: center; gap: .15rem; transform: translate(-50%, -50%); }
  .floater :global(.mascot) { width: 100%; animation: thenga-float var(--t) ease-in-out var(--d) infinite; }
  .floater-tag { padding: .2rem .5rem .28rem; font-family: var(--font-hand); font-size: 1.02rem; line-height: 1; white-space: nowrap; color: var(--ink); background: var(--paper-2); border: 1.3px solid var(--border); border-radius: 6px 10px 5px 9px / 9px 5px 10px 6px; box-shadow: 2px 2px 0 var(--shadow-ink); transform: rotate(var(--r)); }
  /* Three down each side of Thenga, never in step with each other. */
  .floater--1 { --x: 15%; --y: 20%; --t: 5.2s; --d: -1.1s; --r: -4deg; }
  .floater--2 { --x: 85%; --y: 18%; --t: 4.6s; --d: -2.4s; --r: 3deg; }
  .floater--3 { --x: 27%; --y: 52%; --t: 5.8s; --d: -.4s; --r: 2deg; }
  .floater--4 { --x: 73%; --y: 50%; --t: 5s; --d: -3.2s; --r: -3deg; }
  .floater--5 { --x: 14%; --y: 80%; --t: 4.8s; --d: -1.8s; --r: -2deg; }
  .floater--6 { --x: 86%; --y: 80%; --t: 5.4s; --d: -.9s; --r: 4deg; }
  /* The studio's painter, above Thenga's head. */
  .floater--studio { --x: 50%; --y: 14%; --t: 5.6s; --d: -2s; --r: -2deg; }
  @keyframes thenga-float { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-5px) rotate(-3deg); } }

  .stash-body { display: grid; gap: .6rem; min-width: 0; }
  .stash-eyebrow { display: flex; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); }
  .stash-eyebrow::before { content: ""; width: 1.2rem; height: 1.5px; background: #9a6440; flex: none; }
  .stash-title { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.7rem, 3.4vw, 2.4rem); line-height: 1.05; letter-spacing: -.02em; }
  .stash-text { font-size: 1rem; color: var(--ink-soft); max-width: 52ch; }
  .stash-moods { display: flex; flex-wrap: wrap; gap: .45rem; }
  .stash-foot { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin-top: .4rem; padding-top: .8rem; border-top: 1.5px dashed var(--line); }
  /* Long eyebrow: wrap between the pieces, never inside one. */
  .stash-eyebrow > span > span { white-space: nowrap; }
  /* The rooms: small links that sit above the card's stretched link. */
  .stash-rooms { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: .4rem; }
  .stash-room { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .7rem; font-size: .86rem; font-weight: 500; white-space: nowrap; text-decoration: none; color: var(--ink); background: var(--paper); border: 1.5px solid var(--border); border-radius: 999px; transition: border-color .15s ease, color .15s ease; }
  .stash-room span { font-family: var(--font-mono); font-size: .66rem; font-weight: 400; color: var(--ink-faint); }
  .stash-room:hover { color: var(--coral); border-color: var(--coral); }
  .stash-room:focus-visible { outline: 2px solid var(--coral); outline-offset: 2px; }
  .stash-go { margin-left: auto; display: inline-flex; align-items: center; gap: .3rem; font-size: .95rem; font-weight: 500; color: var(--coral); white-space: nowrap; text-decoration: none; }
  .stash-go::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius-wobble-2); }
  .stash-go:hover { color: var(--coral); }
  .stash-go:focus-visible { outline: none; }
  .stash-card:has(.stash-go:focus-visible) { outline: 2px solid var(--ink); outline-offset: 4px; }
  .stash-go :global(.doodle) { width: 1rem; height: 1rem; stroke-width: 2; transition: transform .2s ease; }
  .stash-card:hover .stash-go :global(.doodle) { transform: translateX(4px); }

  @media (max-width: 899px) {
    .stash-card { grid-template-columns: 1fr; padding: 1.3rem 1.2rem 1.2rem; }
    .stash-go { margin-left: 0; }
    .stash-shot { aspect-ratio: 2 / 1; }
    .float-hero { width: 22%; }
    .floater { width: 11%; }
  }
  /* Phones: four floaters, pulled in so their tags stay inside the frame. */
  @media (max-width: 559px) {
    .stash-shot { aspect-ratio: 4 / 3; }
    .float-hero { width: 30%; top: 50%; }
    .floater { width: 16%; }
    .floater-tag { font-size: .88rem; padding: .16rem .4rem .22rem; }
    .floater--3, .floater--4 { display: none; }
    .floater--1 { --x: 20%; --y: 24%; }
    .floater--2 { --x: 80%; --y: 22%; }
    .floater--5 { --x: 20%; --y: 74%; }
    .floater--6 { --x: 80%; --y: 74%; }
    .floater--studio { --y: 13%; }
  }
</style>
