---
/* Selected company work: three projects, newest company first. The rest live on
   the full list (/work/). To swap one, change a <ProjectCard> here; each card
   needs a story page in src/pages/work/. */
import HomeSection from './HomeSection.astro';
import ProjectCard from './ProjectCard.astro';
import StriveChat from '../sketches/StriveChat.astro';
import ReportBuilder from '../sketches/ReportBuilder.astro';
---
<HomeSection flip id="work" tone="sand" eyebrow="Selected work" title="Shipped at work" more={{ href: '/work/#work', label: 'See all work' }}>
  <ul class="home-grid">
    <ProjectCard href="/work/strive-gen-ui-chat/" accent="coral" title="Strive AI" kicker="Strivelabs · Gen UI" status="Live · runs most of Strive">
      <StriveChat slot="sketch" />
      A marketing chat that answers in live interfaces, not paragraphs.
    </ProjectCard>
    <ProjectCard href="/work/report-builder/" accent="blue" title="Strive Studio" kicker="Strivelabs · Design in code" status="Live for all customers">
      <ReportBuilder slot="sketch" />
      Lovable for marketing reports, with numbers that never go stale.
    </ProjectCard>
    <ProjectCard href="/work/freshworks-marketplace/" accent="teal" title="Freshworks Marketplace" kicker="Freshworks · Vue 3 migration" status="Shipped · WCAG 2.1 AA">
      <img slot="sketch" style="object-position: left top" src="/images/work/freshworks-marketplace/marketplace-home.webp" alt="The revamped Freshworks Marketplace: a search bar, product filters on the left, and a grid of popular apps." width="1800" height="890" loading="lazy" decoding="async">
      One codebase, two experiences, moved to Vue 3 with a revamp on top.
    </ProjectCard>
  </ul>
</HomeSection>
