---
/* Things I've built. One <Rail> per chapter, one <WorkCard> per project.
   To add a project: add a <WorkCard> to the right rail (and a page in src/pages/work/).
   Company work shares one rail, newest first: give each card its company, role · years
   and `live` if it's the current job, and the rail header follows the card in view.
   To add a chapter: add another <Rail>. */
import Rail from './Rail.astro';
import WorkCard from './WorkCard.astro';
import StriveChat from '../sketches/StriveChat.astro';
import ReportBuilder from '../sketches/ReportBuilder.astro';
import Thatpam from '../sketches/Thatpam.astro';
import DforDoubts from '../sketches/DforDoubts.astro';
import Stash from './Stash.astro';

const strive = { company: 'Strivelabs', meta: 'Design engineer · 2024 → now', live: true };
const freshworks = { company: 'Freshworks', meta: 'Senior software engineer · 2021 → 2024' };
---
<section class="section section--sand has-wave before-wave" id="work" aria-labelledby="proj-title">
  <div class="wave" aria-hidden="true"></div>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Selected work</p>
      <h2 id="proj-title">Inference time.</h2>
      <p>What's shipped, out in the open. A few more are still running in the background — can't say much yet, but the stories will stream in.</p>
    </div>
  </div>

  <Rail id="rail-work" icon="briefcase" title="Strivelabs" meta="Design engineer · 2024 → now" live>
    <WorkCard {...strive} href="/work/strive-gen-ui-chat/" accent="coral" when="Generative UI chat" title="Strive AI" tags={['Gen UI', 'Streaming']}>
      <StriveChat slot="sketch" />
      The gateway to everything at Strivelabs, a chat agent that answers in interfaces, not paragraphs. I own the frontend, the streaming engine, and the design system it runs on.
    </WorkCard>
    <WorkCard {...strive} href="/work/report-builder/" accent="blue" when="Report Builder" title="Strive Studio" tags={['Gen UI', 'Agentic']}>
      <ReportBuilder slot="sketch" />
      Lovable for marketing, before artifacts were a thing. Chat to build live reports wired to your warehouse — no static exports, no dashboards to babysit.
    </WorkCard>
    <WorkCard {...freshworks} href="/work/freshworks-marketplace/" accent="teal" when="Vue 3 migration" title="Freshworks Marketplace" tags={['Vue 3', 'Monorepo']}>
      <img slot="sketch" style="object-position: left top" src="/images/work/freshworks-marketplace/marketplace-home.webp" alt="The revamped Freshworks Marketplace: a search bar, product filters on the left, and a grid of popular apps." width="1800" height="890" loading="lazy" decoding="async">
      One codebase, two very different experiences, and a quarter to move both onto Vue 3 — while shipping a revamp on top of it.
    </WorkCard>
  </Rail>

  <Rail id="rail-indie" icon="lightbulb" title="Indie builds" meta="Side quests, solo. Idea → pixels → payments.">
    <WorkCard href="/work/thatpam/" accent="teal" when="Solo build · Experiment" title="தட்பம்" titleLang="ta" tags={['Ed-tech', '0 → 1']}>
      <Thatpam slot="sketch" />
      A one-person ed-tech experiment born in lockdown — startup life, taught cohorts, multiple hats. Cohorts are paused now, but the students went pro. Lots of fun & lessons to carry forward.
    </WorkCard>
    <WorkCard href="/work/dfordoubts/" accent="violet" when="OPERATIONAL . EDTECH" title="DforDoubts" tags={['E-learning', 'Full-stack']}>
      <DforDoubts slot="sketch" />
      A live e-learning platform that helps learners find experts, and answers. Took it from idea to pixels to production.
    </WorkCard>
  </Rail>

  <Stash />
</section>
