---
/* Things I've built. One <Rail> per chapter, one <WorkCard> per project.
   To add a project: add a <WorkCard> to the right rail (and a page in src/pages/work/).
   Company work shares one rail, newest first: give each card its company, role · years
   and `live` if it's the current job (spread one of the objects below), and add that
   object to the rail's `chapters`. The header lists every company and highlights the
   one whose card is in view.
   To add a chapter: add another <Rail>. */
import Rail from './Rail.astro';
import WorkCard from './WorkCard.astro';
import StriveChat from '../sketches/StriveChat.astro';
import ReportBuilder from '../sketches/ReportBuilder.astro';
import AgentUI from '../sketches/AgentUI.astro';
import BrandKit from '../sketches/BrandKit.astro';
import Thatpam from '../sketches/Thatpam.astro';
import DforDoubts from '../sketches/DforDoubts.astro';
import Stash from './Stash.astro';

const strive = { company: 'Strivelabs', meta: 'Design engineer · 2024 → now', live: true };
const freshworks = { company: 'Freshworks', meta: 'Senior software engineer · 2021 → 2024' };
---
<section class="section section--sand has-wave before-wave" id="work" aria-labelledby="proj-title">
  <div class="wave" aria-hidden="true"></div>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Selected work</p>
      <h2 id="proj-title">Inference time.</h2>
      <p>What's shipped, out in the open. A few more are still running in the background — can't say much yet, but the stories will stream in.</p>
    </div>
  </div>

  <Rail id="rail-work" icon="briefcase" chapters={[strive, freshworks]}>
    <WorkCard {...strive} href="/work/strive-gen-ui-chat/" accent="coral" title="Strive AI" tags={['Gen UI', 'Design system']}
      part="The base, with our CTO: streaming engine, contracts, design system" shipped="Live · how customers use almost all of Strive">
      <StriveChat slot="sketch" />
      A marketing chat that answers in live interfaces, not paragraphs.
    </WorkCard>
    <WorkCard {...strive} href="/work/report-builder/" accent="blue" title="Strive Studio" tags={['Gen UI', 'Design in code']}
      part="Studio designed in code, the report skill, the sandbox bridge" shipped="Live for all customers · one of the most used">
      <ReportBuilder slot="sketch" />
      Lovable for marketing reports, with numbers that never go stale.
    </WorkCard>
    <WorkCard {...strive} href="/work/brand-kit/" accent="teal" title="Brand kit extractor" tags={['Design systems', 'LLM']}
      part="End to end: the experience, the extraction, the kit page and the skill" shipped="Live for all customers · reports read it first">
      <BrandKit slot="sketch" />
      Read a customer’s brand off their website once, and every surface after that can wear it.
    </WorkCard>
    <WorkCard {...strive} href="/work/pluggable-agent-ui/" accent="violet" title="Pluggable UI for agents" tags={['DX', 'Agent UI']}
      part="The framework on our CTO’s screens idea: scaffold, hooks, docs" shipped="~13+ agents, still growing · now slots in chat">
      <AgentUI slot="sketch" />
      One command to a minimal, working agent UI on our framework and UX guidelines. Write the core logic, and the agent is ready.
    </WorkCard>
    <WorkCard {...freshworks} href="/work/freshworks-marketplace/" accent="teal" title="Freshworks Marketplace" tags={['Vue 3', 'Accessibility']}
      part="The pitch, the plan, the POC and the hands-on migration" shipped="In stages, before Vue 2’s end of life · WCAG 2.1 AA">
      <img slot="sketch" style="object-position: left top" src="/images/work/freshworks-marketplace/marketplace-home.webp" alt="The revamped Freshworks Marketplace: a search bar, product filters on the left, and a grid of popular apps." width="1800" height="890" loading="lazy" decoding="async">
      One codebase, two experiences, moved to Vue 3 with a revamp on top.
    </WorkCard>
  </Rail>

  <Rail id="rail-indie" icon="lightbulb" title="Side builds" meta="Solo, outside the day job. Idea → pixels → payments.">
    <WorkCard href="/work/thatpam/" accent="teal" title="தட்பம்" titleLang="ta" titleNote="thatpam, Tamil for “coolness”" tags={['Teaching', '0 → 1']}
      part="All of it, from the pixels to the payments" shipped="Paused · the students went pro" shippedLabel="Status">
      <Thatpam slot="sketch" />
      Frontend, taught in Tamil, in tiny cohorts.
    </WorkCard>
    <WorkCard href="/work/dfordoubts/" accent="violet" title="DforDoubts" tags={['Full-stack', 'Payments']}
      part="Solo developer, from a one-line brief to payments" shipped="Live, now a registered company">
      <DforDoubts slot="sketch" />
      An e-learning marketplace for educators and learners.
    </WorkCard>
  </Rail>

  <Stash />
</section>
