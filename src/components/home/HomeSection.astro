---
/* One homepage band after the hero and logos: the same head (eyebrow, title, an
   optional "view all" link on the right) and the same spacing everywhere, so the
   page keeps one rhythm. `tone` alternates the band colour; `flip` mirrors its
   wave so neighbouring waves don't repeat. Content goes in the slot.
   Spacing: the wave sits above the band, in the bottom padding of whatever comes
   before it (that's why every band, and .logos, pads its bottom by --wave-h). So
   between two bands it's always: content, --space-4, the wave, --space-4, content.
   The last band before the footer skips the extra, since the footer's own margin
   holds its wave. */
import Icon from '../Icon.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  more?: { href: string; label: string };
  tone?: 'paper' | 'sand';
  flip?: boolean;
}

const { id, eyebrow, title, more, tone = 'paper', flip = false } = Astro.props;
---
<section class:list={['home-section', tone === 'sand' ? 'section--sand' : 'section--paper']} id={id} aria-labelledby={`${id}-title`}>
  <div class:list={['wave', flip && 'wave--flip']} aria-hidden="true"></div>
  <div class="wrap">
    <header class="home-head">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id={`${id}-title`}>{title}</h2>
      </div>
      {more && <a class="home-more" href={more.href}>{more.label}<Icon name="arrow-right" /></a>}
    </header>
    <slot />
  </div>
</section>

<style>
  .home-section { position: relative; padding-block: var(--space-4) calc(var(--space-4) + var(--wave-h)); scroll-margin-top: 4.5rem; }
  /* last-of-type, not last-child: a component's <script> can land after the section. */
  .home-section:last-of-type { padding-bottom: var(--space-4); }
  .home-section.section--paper { background: var(--paper); }
  .home-head { display: flex; align-items: flex-end; justify-content: space-between; gap: .6rem 1.5rem; flex-wrap: wrap; margin-bottom: var(--space-4); }
  .home-head h2 { margin: 0; }
  .home-head .eyebrow { margin-bottom: .6rem; }
/* "See all …": a pill in the site's card language (outline + hard offset shadow) so
     it reads as a way into more, not a footnote. Fills on hover, like .pill--solid. */
  .home-more { display: inline-flex; align-items: center; gap: .45rem; margin-bottom: .2rem; padding: .6rem 1rem .6rem 1.1rem; font-size: .95rem; font-weight: 500; line-height: 1; white-space: nowrap; color: var(--ink); text-decoration: none; background: var(--paper-2); border: 1.5px solid var(--border); border-radius: 1.5rem 1.1rem 1.4rem 1.2rem / 1.2rem 1.5rem 1.1rem 1.4rem; box-shadow: 3px 3px 0 var(--shadow-ink); transition: transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease; }
  .home-more:hover { color: var(--paper); background: var(--ink); border-color: var(--ink); transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--shadow-ink); }
  .home-more:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--shadow-ink); }
  .home-more:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }
  .home-more :global(.doodle) { width: 1rem; height: 1rem; stroke-width: 2; transition: transform .2s ease; }
  .home-more:hover :global(.doodle) { transform: translateX(3px); }
  @media (max-width: 639px) { .home-head { margin-bottom: 1.75rem; } }
</style>
