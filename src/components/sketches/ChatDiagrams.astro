---
// Card sketch for the chat diagrams story.
// A chat turn: the question in a dark bubble, two lines of prose, then the
// diagram card with its title and the expand, download and copy toolbar. Inside,
// the skill's own example drawn small: a lead runs left to right through a
// "Fits ICP?" decision on the bold brand-coloured main path, the step the answer
// is about in a brand wash, a won outcome in teal, and the "No" branch muted and
// dashed with a soft loop back. Everything that matters sits in the top band so
// the 16:9 crop keeps it; the composer sits below. Strive orange is the one
// fixed colour.
---
<svg class="sk" viewBox="0 0 600 440" preserveAspectRatio="xMinYMin slice" role="img" aria-label="Sketch of a diagram in Strive chat: a question in a dark bubble, “How does a lead become a customer?”, two lines of prose, and a diagram card titled Lead to closed won, with expand, download and copy icons. Inside, a flowchart runs left to right: New lead, a Fits ICP? decision, then on a bold orange main path Book demo, Send proposal in an orange wash, and Closed won in teal. The No branch goes down to a muted, dashed Nurture box, with a dashed line looping back to New lead. Below, the chat composer.">
  <rect width="600" height="440" class="f-page"/>

  <!-- The question, then the start of the prose answer. -->
  <rect x="318" y="20" width="262" height="28" rx="14" class="f-ink"/>
  <text x="449" y="38" font-size="10" text-anchor="middle" style="fill: var(--paper)">How does a lead become a customer?</text>
  <rect x="20" y="64" width="300" height="6" rx="3" class="f-bar"/>
  <rect x="20" y="78" width="220" height="6" rx="3" class="f-bar-2"/>

  <!-- The diagram card: title and the hover toolbar. -->
  <g class="sk-lift">
    <rect x="20" y="98" width="560" height="208" rx="10" class="f-card s-soft" stroke-width="1.5"/>
    <text x="36" y="122" font-size="10.5" font-weight="600" class="t-soft">Lead → Closed won</text>
    <path d="M520 112 l-5 0 0 5 M515 112 l6 6 M531 124 l5 0 0 -5 M536 124 l-6 -6" class="s-ink" stroke-width="1.1"/>
    <path d="M548 111 v9 m-3.5 -3.5 l3.5 3.5 3.5 -3.5 M543 124 h10" class="s-ink" stroke-width="1.1"/>
    <rect x="562" y="111" width="8" height="9" rx="1.5" class="s-ink" stroke-width="1.1"/>
    <path d="M566 108 h6 v9" class="s-ink" stroke-width="1.1"/>

    <!-- Edges first, so the nodes sit on top. The main path is bold brand. -->
    <path d="M114 186 H140" stroke="#f26b1d" stroke-width="2.6" fill="none"/>
    <path d="M200 186 H236" stroke="#f26b1d" stroke-width="2.6" fill="none"/>
    <path d="M316 186 H344" stroke="#f26b1d" stroke-width="2.6" fill="none"/>
    <path d="M436 186 H464" stroke="#f26b1d" stroke-width="2.6" fill="none"/>
    <path d="M170 216 V250" class="s-ink" stroke-opacity=".45"/>
    <path d="M132 264 C 80 264, 70 236, 72 202" class="s-ink" stroke-opacity=".45" stroke-dasharray="4 4"/>
    <path d="M67 208 l5 -7 5 7" class="s-ink" stroke-opacity=".45"/>

    <!-- New lead: a stadium for the start. -->
    <rect x="34" y="172" width="80" height="28" rx="14" class="f-paper" stroke="var(--ink)" stroke-opacity=".3" stroke-width="1.3"/>
    <text x="74" y="190" font-size="9.5" text-anchor="middle">New lead</text>

    <!-- The decision, phrased as a question. -->
    <path d="M170 156 L200 186 L170 216 L140 186 Z" class="f-paper" stroke="var(--ink)" stroke-opacity=".3" stroke-width="1.3"/>
    <text x="170" y="189" font-size="8.5" text-anchor="middle">Fits ICP?</text>
    <rect x="203" y="168" width="26" height="14" rx="7" class="f-paper s-soft"/>
    <text x="216" y="178" font-size="7.5" text-anchor="middle" class="t-soft">Yes</text>
    <rect x="176" y="226" width="22" height="14" rx="7" class="f-paper s-soft"/>
    <text x="187" y="236" font-size="7.5" text-anchor="middle" class="t-soft">No</text>

    <rect x="236" y="172" width="80" height="28" rx="6" class="f-paper" stroke="var(--ink)" stroke-opacity=".3" stroke-width="1.3"/>
    <text x="276" y="190" font-size="9.5" text-anchor="middle">Book demo</text>

    <!-- The step the answer is about: a brand wash. -->
    <rect x="344" y="172" width="92" height="28" rx="6" fill="#f26b1d" fill-opacity=".14" stroke="#f26b1d" stroke-width="1.5"/>
    <text x="390" y="190" font-size="9.5" text-anchor="middle">Send proposal</text>

    <!-- The good outcome: a teal wash, a stadium for the end. -->
    <rect x="464" y="172" width="96" height="28" rx="14" fill="var(--teal)" fill-opacity=".14" stroke="var(--teal)" stroke-width="1.5"/>
    <text x="512" y="190" font-size="9.5" text-anchor="middle">Closed won</text>

    <!-- Out of scope: muted and dashed. -->
    <rect x="132" y="250" width="80" height="28" rx="6" class="f-tint" stroke="var(--ink)" stroke-opacity=".3" stroke-width="1.2" stroke-dasharray="4 3"/>
    <text x="172" y="268" font-size="9.5" text-anchor="middle" class="t-soft">Nurture</text>
    <text x="84" y="244" font-size="8" class="t-soft">Re-engages</text>

    <rect x="244" y="284" width="250" height="5" rx="2.5" class="f-bar-2"/>
  </g>
  <text x="404" y="262" font-size="15" style="fill: #f26b1d; font-family: var(--font-hand)">only when it helps</text>

  <!-- Below the hero crop: the composer. -->
  <rect x="20" y="344" width="560" height="76" rx="16" class="f-card" stroke="#f26b1d" stroke-opacity=".35" stroke-width="1.5"/>
  <text x="40" y="372" font-size="11" class="t-soft">Ask anything…</text>
  <circle cx="556" cy="398" r="11" class="f-tint"/>
  <path d="M551 398 h9 m-3.5 -3.5 l3.5 3.5 -3.5 3.5" class="s-ink" stroke-width="1.2"/>
</svg>
