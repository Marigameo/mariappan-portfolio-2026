---
// Card sketch for the tune-search story.
// The bug it started from, in one frame. A sidebar with its account menu open, and
// beside it the organisation picker: a dashed coral outline shows where the panel
// was, pushed up against the screen's edge, and the real panel sits 120px lower,
// shrunk to three rows after one letter. The pointer is left inside the outline,
// outside the panel, which is why a hover menu closes. Everything sits in the top
// 16:9 of the 600x440 box, since card frames crop the bottom. Colours come from
// the .sk rules.
---
<svg class="sk" viewBox="0 0 600 440" preserveAspectRatio="xMinYMin slice" role="img" aria-label="Sketch of an organisation switcher breaking. A sidebar with its account menu open, Switch org highlighted. Beside it a dashed coral outline marks where the tall picker panel was; the real panel has dropped 120 pixels lower, shrunk to three rows after one letter was typed. The pointer is left in the outline, outside the panel, with a handwritten note: dropped, then closed.">
  <rect width="600" height="440" class="f-page"/>

  <g class="sk-lift">
    <rect x="24" y="22" width="552" height="292" rx="14" class="f-card" stroke="var(--ink)" stroke-width="2"/>
    <rect x="30" y="28" width="150" height="280" rx="9" class="f-tint"/>
    <rect x="46" y="48" width="92" height="8" rx="3" class="f-bar"/>
    <rect x="46" y="70" width="70" height="8" rx="3" class="f-bar"/>
    <rect x="46" y="92" width="96" height="8" rx="3" class="f-bar"/>
    <rect x="46" y="114" width="62" height="8" rx="3" class="f-bar"/>

    <!-- The account menu, Switch org highlighted. -->
    <rect x="42" y="168" width="156" height="104" rx="8" class="f-card s-soft" stroke-width="1.5"/>
    <rect x="52" y="182" width="52" height="6" rx="2" class="f-bar-2"/>
    <rect x="52" y="204" width="60" height="6" rx="2" class="f-bar-2"/>
    <rect x="48" y="220" width="144" height="22" rx="5" class="f-tint"/>
    <rect x="56" y="228" width="70" height="6" rx="2" class="f-bar"/>
    <path d="M178 226 l5 5 -5 5" class="s-ink" stroke-opacity=".7"/>
    <rect x="52" y="254" width="48" height="6" rx="2" class="f-bar-2"/>
    <rect x="42" y="282" width="18" height="18" rx="5" fill="var(--coral)"/>
    <rect x="68" y="288" width="64" height="7" rx="2" class="f-bar"/>

    <!-- Where the panel was, pushed up, and where it dropped to. -->
    <rect x="214" y="36" width="200" height="266" rx="9" fill="none" stroke="var(--coral)" stroke-width="1.8" stroke-dasharray="6 5"/>
    <rect x="214" y="156" width="200" height="146" rx="9" class="f-card s-soft" stroke-width="1.5"/>
    <text x="228" y="183" font-size="15" style="font-family: var(--font-mono)">n</text>
    <rect x="240" y="170" width="1.6" height="16" fill="var(--blue)"/>
    <line x1="222" y1="196" x2="406" y2="196" class="s-soft" stroke-width="1"/>
    <rect x="226" y="208" width="14" height="14" rx="4" class="f-bar-2"/>
    <rect x="248" y="212" width="80" height="6" rx="2" class="f-bar"/>
    <rect x="226" y="236" width="14" height="14" rx="4" class="f-bar-2"/>
    <rect x="248" y="240" width="96" height="6" rx="2" class="f-bar"/>
    <rect x="226" y="264" width="14" height="14" rx="4" class="f-bar-2"/>
    <rect x="248" y="268" width="66" height="6" rx="2" class="f-bar"/>

    <!-- The pointer, left behind. -->
    <path d="M316 62 v22 l6 -5.5 4 9 3.4 -1.6 -4 -8.8 h8.2 z" fill="var(--ink)" stroke="var(--paper-2)" stroke-width="1.2" stroke-linejoin="round"/>
  </g>

  <path d="M436 44 V146" stroke="var(--coral)" stroke-width="2" stroke-dasharray="5 4" fill="none"/>
  <path d="M429 138 l7 9 7 -9" stroke="var(--coral)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <text x="450" y="92" font-size="20" style="fill: var(--coral); font-family: var(--font-hand)">120px</text>
  <text x="450" y="118" font-size="17" style="fill: var(--coral); font-family: var(--font-hand)">dropped,</text>
  <text x="450" y="140" font-size="17" style="fill: var(--coral); font-family: var(--font-hand)">then closed</text>
</svg>
