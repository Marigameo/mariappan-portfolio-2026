---
/* Two things side by side on one sheet: a comparison drawn like the build-vs-own
   sketch. A side can be a ghost (the thing we left behind, dashed, no shadow) or
   inked in a colour, with an optional hand-lettered stamp. Items are marked +/–
   for a before/after, or with plain dots when both sides are good in their own
   way. Stacks on a phone. */
type Tone = 'ghost' | 'coral' | 'blue' | 'teal' | 'violet';
interface Side { title: string; stamp?: string; items: string[]; tone: Tone; minus?: number[] }
interface Props {
  left: Side;
  right: Side;
  mid?: string;
  marks?: 'plus-minus' | 'dot';
  alt: string;
  caption?: string;
}
const { left, right, mid = 'vs', marks = 'plus-minus', alt, caption } = Astro.props;
const sides = [left, right];
---
<figure class="sk-fig">
  <div class="sk-sheet vs" role="img" aria-label={alt}>
    {sides.map((s, i) => (
      <>
        {i === 1 && <p class="vs-mid" aria-hidden="true">{mid}</p>}
        <div class:list={['sk-box', `sk-box--${s.tone}`, `sk-lean-${i + 1}`, 'vs-col', `vs-col--${s.tone}`]}>
          <p class="sk-hdr vs-hdr">{s.title}{s.stamp && <span class="vs-stamp">{s.stamp}</span>}</p>
          <ul class:list={[marks === 'dot' && 'vs-dots']}>
            {s.items.map((k, j) => <li class={marks === 'plus-minus' && !(s.minus ?? (s.tone === 'ghost' ? s.items.map((_, n) => n) : [])).includes(j) ? 'is-plus' : ''}>{k}</li>)}
          </ul>
        </div>
      </>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .vs { display: grid; grid-template-columns: 1fr auto 1fr; align-items: stretch; gap: 1rem; }
  .vs-mid { align-self: center; margin: 0 !important; font-family: var(--font-display); font-size: 1.4rem; color: var(--ink-faint); }
  .vs-hdr { display: flex; align-items: center; gap: .5rem; font-size: .64rem; color: var(--c); }
  .vs-col--ghost .vs-hdr { color: var(--ink-faint); }
  .vs-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .45rem; }
  .vs-col li { position: relative; padding-left: 1.2rem; font-size: .85rem; line-height: 1.4; color: var(--ink); }
  .vs-col--ghost li { color: var(--ink-faint); }
  .vs-col li::before { content: "–"; position: absolute; left: 0; font-weight: 700; }
  .vs-col li.is-plus::before { content: "+"; color: var(--teal); }
  .vs-dots li::before, .vs-dots li.is-plus::before { content: "•"; color: var(--c); }
  .vs-stamp { flex: none; white-space: nowrap; padding: .15rem .45rem; border: 1.5px solid var(--c); border-radius: 4px; font-family: var(--font-hand); font-size: .95rem; letter-spacing: 0; text-transform: none; transform: rotate(-6deg); }
  @media (max-width: 559px) {
    .vs { grid-template-columns: 1fr; }
    .vs-mid { text-align: center; }
  }
</style>
