---
/* The whole product in one row: you ask in chat, the agent edits one HTML
   file, the canvas renders it in a sandbox, and the report asks the host for
   live data. The loop closes with a hand-written note: every tool turn, the
   canvas refetches. Four boxes across, two by two on a tablet, stacked on a
   phone. Other flows pass their own `steps`, `note`, `caption` and `alt`. */
import Icon from '../../Icon.astro';

interface Step { kicker: string; label: string; sub: string; tone: string }
interface Props { steps?: Step[]; note?: string; caption?: string; alt?: string }

const defaultSteps: Step[] = [
  { kicker: 'Chat', label: 'You ask', sub: '“Weekly Google Ads recap, CPL trend, top five wasted keywords”', tone: '' },
  { kicker: 'Skill', label: 'The agent edits one file', sub: 'an HTML page, scaffolded before its first turn', tone: 'coral' },
  { kicker: 'Canvas', label: 'A sandbox renders it', sub: 'beside the thread, no access to the app', tone: 'blue' },
  { kicker: 'Bridge', label: 'The report asks for data', sub: 'through the host, live and read-only', tone: 'teal' },
];

const {
  steps = defaultSteps,
  note = 'every tool turn, the canvas refetches, and round it goes',
  caption = 'One HTML file in the middle. Chat writes it, a sandbox runs it, the host feeds it.',
  alt = 'You ask in chat for a report. The agent, using the report builder skill, edits one HTML file that was scaffolded before its first turn. A sandboxed canvas beside the thread renders it with no access to the app. The report asks the host for live, read-only data through a bridge. After every tool turn the canvas refetches the file, so the loop goes round again with each edit.',
} = Astro.props;
---
<figure class="sk-fig">
  <div class="sk-sheet sl" role="img" aria-label={alt}>
    <ol class="sl-steps">
      {steps.map((s, i) => (
        <>
          {i > 0 && <li class="sk-arrow sl-arrow" aria-hidden="true"><Icon name="arrow-right" /></li>}
          <li class:list={['sk-box', s.tone && `sk-box--${s.tone}`, `sk-lean-${i + 1}`]}>
            <span class="sl-kicker">{s.kicker}</span>
            <strong>{s.label}</strong>
            <span class="sl-sub">{s.sub}</span>
          </li>
        </>
      ))}
    </ol>
    <p class="sl-note sk-hand"><Icon name="arrow-curly" /> {note}</p>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .sl-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; align-items: stretch; gap: .5rem; }
  .sl-steps .sk-box { display: grid; align-content: start; gap: .25rem; padding: .65rem .7rem .75rem; }
  .sl-arrow { align-self: center; }
  .sl-arrow :global(.doodle) { width: 1.3rem; height: 1.3rem; }
  .sl-kicker { font-family: var(--font-mono); font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; color: var(--c); }
  .sl-steps strong { font-size: .88rem; font-weight: 500; line-height: 1.3; color: var(--ink); }
  .sl-sub { font-size: .74rem; line-height: 1.4; color: var(--ink-faint); }
  .sl-note { margin: 1.1rem 0 0 !important; max-width: none; text-align: right; color: var(--coral); }
  .sl-note :global(.doodle) { width: 1.3rem; height: 1.3rem; transform: scaleY(-1); }
  @media (max-width: 719px) {
    .sl-steps { grid-template-columns: 1fr; }
    .sl-arrow { justify-self: center; transform: rotate(90deg); }
    .sl-note { text-align: center; }
  }
</style>
