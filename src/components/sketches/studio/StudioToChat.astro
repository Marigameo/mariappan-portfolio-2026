---
/* v1 and v2 of where a report gets built. Left: the report builder as its own
   chat, beside the main one, each with its own history. Right: one chat, the
   report builder as a skill, the report in a canvas beside the thread. Drawn
   with the .sk card-sketch classes so it follows the theme. */
const v1 = ['Report rules kept out of the main prompt', 'Free to experiment without touching core chat', 'Trade-off: a separate agent and history'];
const v2 = ['A skill the main chat picks up when the intent is a report', 'The report opens in a canvas beside the thread', 'One chat, one history'];

const alt =
  'Version one: the main chat and a separate Report Studio chat side by side, each with its own history. ' +
  'Version two: a single chat with a report builder skill chip, and the report open in a canvas panel beside the thread, with a navigator rail to reopen it.';

const bubbles = [0, 1, 2];
---
<figure class="sk-fig stc">
  <div class="sk-sheet" role="img" aria-label={alt}>
    <div class="stc-grid">
      <div class="stc-side">
        <p class="stc-tag stc-tag--old">v1 · its own chat</p>
        <svg class="sk stc-svg" viewBox="0 0 320 200" aria-hidden="true">
          <!-- main chat -->
          <rect x="8" y="14" width="118" height="172" rx="10" class="f-page stc-edge"/>
          <text x="20" y="34" font-size="10" font-weight="600">Chat</text>
          <line x1="8" x2="126" y1="44" y2="44" class="s-line"/>
          {bubbles.map((b) => (
            <g>
              <rect x={b % 2 ? 22 : 50} y={56 + b * 30} width="62" height="16" rx="8" class={b % 2 ? 'f-bar-2' : 'f-card stc-thin'}/>
            </g>
          ))}
          <rect x="18" y="154" width="98" height="20" rx="10" class="f-card stc-thin"/>
          <text x="67" y="198" text-anchor="middle" class="stc-hand">history A</text>
          <!-- report studio -->
          <rect x="140" y="14" width="172" height="172" rx="10" class="f-page stc-edge"/>
          <text x="152" y="34" font-size="10" font-weight="600">Report Studio</text>
          <line x1="140" x2="312" y1="44" y2="44" class="s-line"/>
          <line x1="204" x2="204" y1="44" y2="186" class="s-line"/>
          <rect x="148" y="56" width="48" height="12" rx="6" class="f-card stc-thin"/>
          <rect x="148" y="78" width="40" height="12" rx="6" class="f-bar-2"/>
          <rect x="148" y="160" width="50" height="16" rx="8" class="f-card stc-thin"/>
          <rect x="212" y="54" width="92" height="22" rx="4" class="f-card stc-thin"/>
          <rect x="212" y="54" width="92" height="3" class="stc-brand"/>
          <rect x="212" y="84" width="43" height="28" rx="4" class="f-card stc-thin"/>
          <rect x="261" y="84" width="43" height="28" rx="4" class="f-card stc-thin"/>
          <polyline points="214,160 234,146 254,152 274,132 302,138" class="stc-series"/>
          <text x="226" y="198" text-anchor="middle" class="stc-hand">history B</text>
        </svg>
        <ul class="stc-notes stc-notes--old">{v1.map((n) => <li>{n}</li>)}</ul>
      </div>

      <div class="stc-side">
        <p class="stc-tag stc-tag--new">v2 · a skill in the main chat</p>
        <svg class="sk stc-svg" viewBox="0 0 320 200" aria-hidden="true">
          <rect x="8" y="14" width="304" height="172" rx="10" class="f-page stc-edge"/>
          <!-- navigator rail -->
          <rect x="296" y="60" width="10" height="44" rx="5" class="f-tint"/>
          <circle cx="301" cy="72" r="3" class="stc-dot"/>
          <circle cx="301" cy="84" r="3" class="f-bar"/>
          <circle cx="301" cy="96" r="3" class="f-bar"/>
          <!-- chat column -->
          <text x="20" y="34" font-size="10" font-weight="600">Chat</text>
          <rect x="54" y="52" width="66" height="14" rx="7" class="f-card stc-thin"/>
          <rect x="20" y="76" width="92" height="5" rx="2.5" class="f-bar"/>
          <rect x="20" y="87" width="72" height="5" rx="2.5" class="f-bar"/>
          <rect x="54" y="104" width="66" height="14" rx="7" class="f-card stc-thin"/>
          <rect x="20" y="128" width="84" height="5" rx="2.5" class="f-bar"/>
          <rect x="16" y="150" width="112" height="28" rx="10" class="f-card stc-edge"/>
          <rect x="22" y="156" width="64" height="14" rx="7" class="stc-chip"/>
          <text x="54" y="166" text-anchor="middle" class="stc-chip-t">/report_builder</text>
          <!-- canvas -->
          <rect x="138" y="22" width="152" height="156" rx="8" class="f-card stc-edge"/>
          <rect x="146" y="30" width="30" height="10" rx="3" class="f-bar-2"/>
          <rect x="180" y="30" width="26" height="10" rx="3" class="f-tint"/>
          <path d="M276 30l6 6m0-6l-6 6" class="s-ink stc-x"/>
          <line x1="138" x2="290" y1="46" y2="46" class="s-line"/>
          <rect x="146" y="54" width="136" height="26" rx="4" class="f-page stc-thin"/>
          <rect x="146" y="54" width="136" height="3" class="stc-brand"/>
          <rect x="146" y="88" width="64" height="30" rx="4" class="f-page stc-thin"/>
          <rect x="218" y="88" width="64" height="30" rx="4" class="f-page stc-thin"/>
          <polyline points="148,166 172,150 196,156 222,136 250,144 280,128" class="stc-series"/>
          <text x="214" y="198" text-anchor="middle" class="stc-hand stc-hand--new">one thread, report beside it</text>
        </svg>
        <ul class="stc-notes stc-notes--new">{v2.map((n) => <li>{n}</li>)}</ul>
      </div>
    </div>
  </div>
  <figcaption>Build apart, then fold in. The standalone studio was a step we took on purpose, and it was always meant to become a skill.</figcaption>
</figure>

<style>
  .stc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }
  .stc-side { min-width: 0; }
  .stc-tag { margin: 0 0 .6rem !important; max-width: none; font-family: var(--font-mono); font-size: .64rem; letter-spacing: .12em; text-transform: uppercase; }
  .stc-tag--old { color: var(--ink-faint); }
  .stc-tag--new { color: var(--teal); }
  .stc-svg { width: 100%; height: auto; overflow: visible; }
  .stc-edge { stroke: var(--ink); stroke-width: 1.4; }
  .stc-thin { stroke: var(--ink); stroke-opacity: .35; stroke-width: 1; }
  .stc-brand { fill: var(--coral); }
  .stc-series { fill: none; stroke: var(--coral); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .stc-dot { fill: var(--teal); }
  .stc-chip { fill: var(--coral); fill-opacity: .14; stroke: var(--coral); stroke-width: 1; }
  .stc-chip-t { font-family: var(--font-mono) !important; font-size: 6.5px; fill: var(--coral) !important; }
  .stc-x { stroke-width: 1.2; }
  .stc-hand { font-family: var(--font-hand) !important; font-size: 14px; fill: var(--ink-faint) !important; }
  .stc-hand--new { fill: var(--teal) !important; }
  .stc-notes { margin: 1.1rem 0 0; padding: 0; list-style: none; display: grid; gap: .4rem; }
  .stc-notes li { position: relative; padding-left: 1.1rem; font-size: .84rem; line-height: 1.4; color: var(--ink-soft); }
  .stc-notes li::before { content: "•"; position: absolute; left: .1rem; color: var(--c); font-weight: 700; }
  .stc-notes--old { --c: var(--ink-faint); }
  .stc-notes--new { --c: var(--teal); }
  @media (max-width: 639px) { .stc-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
