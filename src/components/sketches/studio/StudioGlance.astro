---
/* Strive Studio's highlights: two cards for the weight of the project, two for
   the parts I worked on, pinned up like sticky notes under a small label. Two
   across on a phone. */
const facts = [
  { value: 'Live reports', label: 'Built from a chat, current on every view', sub: 'no snapshots, in production', ink: 'coral' },
  { value: 'Sandbox & bridge', label: 'Hosting HTML the agent wrote, safely', sub: 'host-held credentials, read-only calls', ink: 'blue' },
  { value: 'Design context', label: 'Shell, tokens and taste for the agent', sub: 'so reports look like they belong', ink: 'teal' },
  { value: 'A pattern that spread', label: 'The report canvas became the template', sub: 'briefings, routine previews, chat artifacts', ink: 'violet' },
];
---
<div class="glance">
  <p class="glance-label">Highlights</p>
  <ul>
    {facts.map((f, i) => (
      <li class:list={['sk-box', `sk-box--${f.ink}`, `sk-lean-${i + 1}`]}>
        <b>{f.value}</b>
        <strong>{f.label}</strong>
        <span>{f.sub}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .glance { margin-top: var(--space-4); }
  .glance-label { margin: 0 0 .8rem !important; max-width: none; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); }
  .glance ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .glance li { display: flex; flex-direction: column; gap: .15rem; padding: .85rem .9rem .95rem; }
  .glance b { font-family: var(--font-display); font-size: 1.4rem; font-weight: 400; line-height: 1.05; letter-spacing: -.01em; color: var(--c); }
  .glance strong { margin-top: .45rem; font-size: .88rem; font-weight: 500; line-height: 1.3; color: var(--ink); }
  .glance span { font-size: .76rem; line-height: 1.4; color: var(--ink-faint); }
  @media (max-width: 719px) { .glance ul { grid-template-columns: 1fr 1fr; } }
</style>
