---
/* Twelve months on one rail, split into the two contracts. The rail is grey for
   everything built on "one JSON document per turn" and turns coral at the pivot,
   so the shape of the year is readable before any of the text is. Other posts
   pass their own `phases` and `caption`; the defaults are the gen-UI year. */

interface Item { period: string; title: string; detail: string; pivot?: boolean }
interface Phase { label: string; tone: 'grey' | 'coral' | 'teal'; items: Item[] }
interface Props { phases?: Phase[]; caption?: string }

const defaultPhases: Phase[] = [
  {
    label: 'Contract 1 · one JSON document per turn',
    tone: 'grey',
    items: [
      { period: 'Sep to Oct 2025', title: 'First chat', detail: 'Basic chat, tool calls, tool-ack, first UI blocks, stacked suggestions, dynamic thinking steps' },
      { period: 'Oct to Nov 2025', title: 'Progressive rendering', detail: 'Block-by-block rendering, reasoning shown as chain of thought, suggestions as cards' },
      { period: 'Dec 2025 to Jan 2026', title: 'History and replay', detail: 'Chat history, read-only replay, stop handler, streaming parser utility, loading states for non-text blocks, first behaviour slots' },
      { period: 'Feb to Mar 2026', title: 'Slots and skills', detail: 'Report preview and content editor slots, slash commands and skills, history pagination, error boundaries, stream only the active message' },
    ],
  },
  {
    label: 'Contract 2 · one tool call per component',
    tone: 'coral',
    items: [
      { period: '6 Apr 2026', title: 'The pivot', detail: 'Tool-call-based streaming. Text tool removed; markdown streams natively', pivot: true },
      { period: 'May to Jun 2026', title: 'Tools become the unit', detail: 'execute_tools endpoint replaces tool-ack, agent trace component, report studio wired into global chat, file support, canvas, selectable table' },
      { period: 'Jul 2026', title: 'Composer and flows', detail: 'Composer redesign, chat mode picker, interactive slash-skills menu, citations, connect an app mid-chat, card-driven routine creation, routine preview panel' },
      { period: 'Aug to Sep 2026', title: 'Scaling out', detail: 'Multi-connection chat, conversation minimap, analytics instrumentation, auth-retry hardening, task and briefing cards' },
    ],
  },
];

const {
  phases = defaultPhases,
  caption = 'Twelve months, two contracts. Everything above the coral line was built on a single JSON document per turn; everything on it was built on one tool call per component.',
} = Astro.props;
---
<figure class="sk-fig">
  <div class="sk-sheet sk-sheet--bare arc">
    {phases.map((phase) => (
      <section class:list={['arc-phase', `arc-phase--${phase.tone}`]}>
        <h3 class="arc-label"><span aria-hidden="true"></span>{phase.label}</h3>
        <ol class="arc-list">
          {phase.items.map((item) => (
            <li class:list={['arc-stop', item.pivot && 'arc-stop--pivot']}>
              <span class="arc-dot" aria-hidden="true"></span>
              <p class="arc-period">{item.period}</p>
              <p class="arc-title">{item.title}</p>
              <p class="arc-detail">{item.detail}</p>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .arc-phase { --rail: var(--ink-faint); }
  .arc-phase--coral { --rail: var(--coral); }
  .arc-phase--teal { --rail: var(--teal); }
  .arc-phase + .arc-phase { margin-top: 1.4rem; }

  .arc-label { display: flex; align-items: center; gap: .5rem; margin: 0 0 .7rem; font-family: var(--font-mono); font-size: .64rem; font-weight: 400; letter-spacing: .12em; text-transform: uppercase; color: var(--rail); }
  .arc-label span { width: .45rem; height: .45rem; flex: none; border-radius: 50%; background: var(--rail); }

  .arc-list { list-style: none; margin: 0; padding-left: 1.5rem; }
  .arc-stop { position: relative; padding: 0 0 1rem 1.4rem; }
  .arc-stop:last-child { padding-bottom: 0; }
  .arc-stop::before { content: ""; position: absolute; left: .3rem; top: .8rem; bottom: -.15rem; border-left: 1.5px dashed var(--rail); }
  .arc-stop:last-child::before { display: none; }
  .arc-dot { position: absolute; left: 0; top: .4rem; width: .65rem; height: .65rem; border: 1.5px solid var(--rail); border-radius: 50% 45% 55% 50% / 55% 50% 45% 50%; background: var(--paper); }
  /* The one day the contract changed. */
  .arc-stop--pivot .arc-dot { left: -.12rem; top: .28rem; width: .9rem; height: .9rem; border: 2px solid var(--coral); background: var(--coral); }

  .arc-period { margin: 0 !important; max-width: none; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-faint); }
  .arc-stop--pivot .arc-period { color: var(--coral); }
  .arc-title { margin: .12rem 0 0 !important; max-width: none; font-size: 1rem; font-weight: 500; color: var(--ink); }
  .arc-stop--pivot .arc-title { font-family: var(--font-hand); font-size: 1.6rem; color: var(--coral); }
  .arc-detail { margin: .12rem 0 0 !important; max-width: none; font-size: .84rem; line-height: 1.5; color: var(--ink-soft); }
</style>
