---
/* The strip's signals, one meaning each: four faces with their marks, then the old
   mapping ghosted below it, where grey meant "doing something quiet", so the busiest
   agents looked the quietest. Faces are drawn in markup: circles for people, rounded
   squares for agents. The mark colours are the component's own, as it ships (green,
   amber and red follow the theme through light-dark). Stacks on a phone. */
const marks = [
  { k: 'live', title: 'Green', sub: 'Doing something: working, editing, commenting', shape: 'agent' },
  { k: 'wait', title: 'Amber', sub: 'Waiting on someone. On you, it reads “Needs you”', shape: 'agent' },
  { k: 'fail', title: 'A red square', sub: 'Failed. Square, so it differs by shape, not hue alone', shape: 'agent' },
  { k: 'none', title: 'Nothing', sub: 'Just here', shape: 'person' },
];
---
<figure class="sk-fig">
  <div class="sk-sheet ml" role="img" aria-label="The strip's four signals, one meaning each. A green dot: doing something, whether working, editing or commenting. Amber: waiting on someone, which reads Needs you when it's you. A red square: failed, square so it differs by shape and not by hue alone. No mark: just here. Below, the old way: a grey dot meant doing something quiet, so the busiest agents looked the quietest, and editing had a pill of its own.">
    <ul class="ml-row">
      {marks.map((m, i) => (
        <li class:list={['sk-box', `sk-lean-${i + 1}`]}>
          <span class:list={['ml-face', `ml-face--${m.shape}`]} aria-hidden="true"><i class:list={['ml-mark', `ml-mark--${m.k}`]}></i></span>
          <strong>{m.title}</strong>
          <span class="ml-sub">{m.sub}</span>
        </li>
      ))}
    </ul>
    <div class="sk-box sk-box--ghost ml-old">
      <p class="sk-hdr">Before · round 21</p>
      <p>A grey dot for working, a black pill for editing. The busiest agents looked the quietest.</p>
    </div>
  </div>
  <figcaption>Each mark means one thing, so nothing has to be learnt twice.</figcaption>
</figure>

<style>
  .ml { display: grid; gap: 1.1rem; padding: 1.3rem 1.2rem 1.2rem; }
  .ml-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .ml-row li { display: grid; gap: .25rem; align-content: start; padding: .85rem .85rem .9rem; }
  .ml-face { position: relative; inline-size: 2.4rem; block-size: 2.4rem; margin-bottom: .35rem; background: var(--sand-2); border-radius: 9px; }
  .ml-face--person { border-radius: 50%; }
  .ml-mark { position: absolute; inset-block-end: -3px; inset-inline-end: -3px; inline-size: .8rem; block-size: .8rem; border-radius: 50%; border: 2.5px solid var(--paper-2); box-sizing: content-box; }
  .ml-mark--live { background: light-dark(#1f9d55, #3fbf74); }
  .ml-mark--wait { background: light-dark(#a14a06, #f5b83d); }
  .ml-mark--fail { background: light-dark(#b42318, #f97066); border-radius: 2px; }
  .ml-mark--none { display: none; }
  .ml-row strong { font-size: .9rem; font-weight: 500; color: var(--ink); }
  .ml-sub { font-size: .76rem; line-height: 1.4; color: var(--ink-faint); }
  .ml-old { padding: .7rem .9rem .8rem; max-width: 34rem; }
  .ml-old p { margin: 0 !important; font-size: .82rem; color: var(--ink-faint); }
  .ml-old .sk-hdr { margin-bottom: .2rem !important; font-size: .62rem !important; }
  @media (max-width: 719px) { .ml-row { grid-template-columns: 1fr 1fr; } }
</style>
