---
// Card sketch for the pluggable agent UI project.
// Hand-drawn product sketch: the platform shell with an agent rail on the left, a
// scaffolded agent's trigger form in the middle and its step progress on the right.
// Colours come from the .sk rules in src/styles/style.css so it follows the theme;
// the fixed hex value is the product's own brand orange.
---
<svg class="sk" viewBox="0 0 600 440" preserveAspectRatio="xMinYMin slice" role="img" aria-label="Sketch of an agent plugged into the platform: a rail of agents on the left with one highlighted, the agent's trigger form with two fields and a run button, and a step progress list beside it with two steps done and one in flight">
  <rect width="600" height="440" class="f-page"/>
  <rect width="600" height="30" class="f-card"/>
  <line x1="0" y1="30.5" x2="600" y2="30.5" class="s-line"/>
  <circle cx="18" cy="15" r="5" fill="#f26b1d"/>
  <text x="30" y="19.5" font-size="11" font-weight="600">Agents</text>

  <rect y="31" width="150" height="409" class="f-tint"/>
  <line x1="150.5" y1="31" x2="150.5" y2="440" class="s-line"/>
  <rect x="14" y="52" width="122" height="28" rx="8" fill="#f26b1d" fill-opacity=".1" stroke="#f26b1d" stroke-opacity=".5" stroke-width="1.2"/>
  <rect x="24" y="61" width="10" height="10" rx="3" fill="#f26b1d"/>
  <rect x="42" y="63" width="70" height="6" rx="3" fill="#f26b1d" fill-opacity=".7"/>
