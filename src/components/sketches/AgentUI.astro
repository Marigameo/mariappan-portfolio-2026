  <rect x="24" y="127" width="10" height="10" rx="3" class="f-bar"/>
  <rect x="42" y="129" width="60" height="6" rx="3" class="f-bar-2"/>
  <rect x="24" y="157" width="10" height="10" rx="3" class="f-bar"/>
  <rect x="42" y="159" width="84" height="6" rx="3" class="f-bar-2"/>
  <rect x="24" y="187" width="10" height="10" rx="3" class="f-bar"/>
