---
// Card sketch for agent-clarifier.
// A chat where the user's vague ask is answered with a question card instead of a
// guess: "Asked by" line, the question, "1 of 4", numbered rows with the first one
// picked, "Something else", and a footer with progress dashes, Skip and Continue.
// Everything sits in the top 16:9 of the 600x440 box, since card frames crop the
// bottom. Colours come from the .sk rules so it follows the theme; the picked key is ink,
// like Continue, as in the component (one colour since 0.2.0).
---
<svg class="sk" viewBox="0 0 600 440" preserveAspectRatio="xMinYMin slice" role="img" aria-label="Sketch of a chat: the user asks for hotel ideas in London, and instead of guessing, the agent shows a question card. It reads Asked by Trip planner, Which area would you like to stay in, 1 of 4, with three numbered options, the first one picked, a Something else row, and a footer with progress dashes, Skip and Continue.">
  <rect width="600" height="440" class="f-page"/>

  <rect x="300" y="14" width="276" height="30" rx="11" class="f-tint"/>
  <text x="316" y="33.5" font-size="11.5" class="t-soft">Hotels in London, any ideas?</text>
  <text x="24" y="64" font-size="11.5" class="t-soft">Happy to. A few quick questions first.</text>

  <g class="sk-lift">
    <rect x="24" y="76" width="552" height="252" rx="14" class="f-card s-soft" stroke-width="1.5"/>
    <circle cx="44" cy="95" r="3" class="f-bar"/>
    <text x="54" y="99" font-size="10" class="t-soft">Asked by Trip planner</text>
    <text x="40" y="121" font-size="15" font-weight="600">Which area would you like to stay in?</text>
    <text x="508" y="121" font-size="10.5" class="t-soft">1 of 4</text>
    <path d="M550 114l5 5 5-5" class="s-ink" stroke-opacity=".5"/>

    <rect x="34" y="132" width="532" height="36" rx="8" class="f-tint"/>
    <rect x="46" y="139" width="22" height="22" rx="5" class="f-ink"/>
    <text x="53.5" y="154" font-size="11" font-weight="600" class="t-on-ink">1</text>
    <text x="82" y="148" font-size="12" font-weight="500">Covent Garden</text>
    <rect x="178" y="139" width="66" height="13" rx="6.5" class="s-soft" fill="none"/>
    <rect x="186" y="144" width="50" height="3.5" rx="1.75" class="f-bar"/>
    <rect x="82" y="155" width="150" height="5" rx="2.5" class="f-bar-2"/>
    <path d="M540 150h10m-4-4l4 4-4 4" class="s-ink" stroke-opacity=".6"/>

    <rect x="46" y="176" width="22" height="22" rx="5" class="f-tint"/>
    <text x="53" y="191" font-size="11" class="t-soft">2</text>
    <text x="82" y="185" font-size="12">South Bank</text>
    <rect x="82" y="192" width="128" height="5" rx="2.5" class="f-bar-2"/>
    <line x1="46" y1="206.5" x2="554" y2="206.5" class="s-line"/>

    <rect x="46" y="214" width="22" height="22" rx="5" class="f-tint"/>
    <text x="53" y="229" font-size="11" class="t-soft">3</text>
    <text x="82" y="223" font-size="12">Kensington</text>
    <rect x="82" y="230" width="140" height="5" rx="2.5" class="f-bar-2"/>
    <line x1="46" y1="244.5" x2="554" y2="244.5" class="s-line"/>

    <rect x="46" y="252" width="22" height="22" rx="5" class="f-tint"/>
    <path d="M52 268l1-4 7-7 3 3-7 7z" class="s-ink" stroke-opacity=".55" stroke-width="1.2"/>
    <text x="82" y="267" font-size="12" class="t-soft">Something else</text>

    <line x1="24" y1="284.5" x2="576" y2="284.5" class="s-line"/>
    <rect x="44" y="305" width="16" height="3" rx="1.5" class="f-ink"/>
    <rect x="64" y="305" width="12" height="3" rx="1.5" class="f-bar"/>
    <rect x="80" y="305" width="12" height="3" rx="1.5" class="f-bar"/>
    <rect x="96" y="305" width="12" height="3" rx="1.5" class="f-bar"/>
    <text x="428" y="310" font-size="11" class="t-soft">Skip</text>
    <rect x="468" y="294" width="92" height="26" rx="7" class="f-ink"/>
    <text x="484" y="311" font-size="11" font-weight="500" class="t-on-ink">Continue →</text>
  </g>
</svg>

<style>
  .t-on-ink { fill: var(--paper-2) !important; }
</style>
