---
/* One kit, many readers. The customer's website (blue, theirs) is read once at
   onboarding into a single knowledge-base file (coral, the bet). Reports read it
   today (teal, stamped "live"); the other surfaces are ghosts, ready to read the
   same file the day they need it. Three columns, stacked on a phone with the
   arrows turned down. `detailed` adds what each side holds, for the blog. */
import Icon from '../../Icon.astro';

interface Props { detailed?: boolean; caption?: string }
const { detailed = false, caption = 'Read the brand once. Every surface after that reads the same file.' } = Astro.props;

const swatches = ['#4F46E5', '#0EA5E9', '#FAFAFF', '#1E1B4B'];
const later = [
  { name: 'Chat answers', sub: 'blocks in their colours' },
  { name: 'Chat artifacts', sub: 'agent-written pages' },
  { name: 'Emails and decks', sub: 'logo, type, palette' },
];
---
<figure class="sk-fig">
  <div class="sk-sheet bkh" role="img" aria-label="The customer's own website is read once, at onboarding, into one file in the knowledge base: brand/design.md, holding colour, type and corner tokens plus written usage rules. Reports read that file today. Chat answers, chat artifacts, and emails and decks are drawn faintly: they can read the same file the day they need it.">
    <div class="sk-box sk-box--blue sk-lean-1 bkh-site">
      <p class="sk-hdr bkh-hdr">Their website</p>
      <span class="bkh-browser" aria-hidden="true">
        <i class="bkh-dots"><b></b><b></b><b></b></i>
        <i class="bkh-line"></i>
        <i class="bkh-line bkh-line--short"></i>
        <i class="bkh-cta"></i>
      </span>
      {detailed ? <p class="bkh-sub">The page, its stylesheets and every colour on it</p> : <p class="bkh-sub">read once, at onboarding</p>}
    </div>

    <span class="sk-arrow bkh-arrow" aria-hidden="true"><Icon name="arrow-right" /></span>

    <div class="sk-box sk-box--coral sk-lean-2 bkh-kit">
      <p class="sk-hdr bkh-hdr">Knowledge base</p>
      <code class="bkh-file">brand/design.md</code>
      <span class="bkh-swatches" aria-hidden="true">{swatches.map((c) => <i style={`background:${c}`}></i>)}</span>
      <p class="bkh-sub">{detailed ? 'Tokens up top, usage rules below. Editable, and gated on every write' : 'tokens + usage rules'}</p>
    </div>

    <span class="sk-arrow bkh-arrow" aria-hidden="true"><Icon name="arrow-right" /></span>

    <ul class="bkh-readers">
      <li class="sk-box sk-box--teal sk-lean-3">
        <strong>Reports <span class="bkh-stamp">live</span></strong>
        <span class="bkh-sub">{detailed ? 'the first reader: brand colour, series, surfaces, fonts, corners' : 'the first reader'}</span>
      </li>
      {later.map((r) => (
        <li class="sk-box sk-box--ghost">
          <strong>{r.name}</strong>
          {detailed && <span class="bkh-sub">{r.sub}</span>}
        </li>
      ))}
    </ul>
  </div>
  <p class="bkh-note sk-hand" aria-hidden="true"><Icon name="arrow-curly" /> ready whenever they ask</p>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .bkh { display: grid; grid-template-columns: 1fr auto 1.1fr auto 1fr; align-items: center; gap: .8rem; }
  .bkh-hdr { margin-bottom: .5rem !important; font-size: .62rem; color: var(--c); }
  .bkh-sub { display: block; margin: .45rem 0 0 !important; max-width: none; font-size: .76rem; line-height: 1.4; color: var(--ink-faint); }
  .bkh-arrow :global(.doodle) { width: 1.4rem; height: 1.4rem; }

  /* A tiny page: three lights, two text lines and one button in the brand colour. */
  .bkh-browser { display: grid; gap: .35rem; padding: .45rem .5rem .55rem; border: 1.5px solid var(--line); border-radius: 6px; background: var(--paper); }
  .bkh-dots { display: flex; gap: .2rem; }
  .bkh-dots b { width: .32rem; height: .32rem; border-radius: 50%; background: var(--ink-faint); opacity: .5; }
  .bkh-line { height: .32rem; width: 80%; border-radius: 99px; background: var(--ink); opacity: .14; }
  .bkh-line--short { width: 55%; opacity: .09; }
  .bkh-cta { height: .7rem; width: 2.6rem; margin-top: .1rem; border-radius: 4px; background: var(--blue); }

  .bkh-file { font-family: var(--font-mono); font-size: .8rem; color: var(--ink); background: none; padding: 0; }
  .bkh-swatches { display: flex; gap: .3rem; margin-top: .55rem; }
  .bkh-swatches i { width: 1.15rem; height: 1.15rem; border: 1.5px solid var(--ink); border-radius: 4px 6px 5px 6px; }

  .bkh-readers { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .bkh-readers li { padding: .45rem .7rem .5rem; }
  .bkh-readers strong { display: flex; align-items: center; gap: .45rem; font-size: .86rem; font-weight: 500; color: var(--ink); }
  .bkh-readers .sk-box--ghost strong { color: var(--ink-faint); font-weight: 400; }
  .bkh-readers .bkh-sub { margin-top: .15rem !important; }
  .bkh-stamp { padding: .05rem .4rem; border: 1.5px solid var(--teal); border-radius: 4px; font-family: var(--font-hand); font-size: .95rem; font-weight: 400; color: var(--teal); transform: rotate(-6deg); }

  .bkh-note { margin: .7rem 0 0 !important; max-width: none; text-align: right; }
  .bkh-note :global(.doodle) { width: 1.3rem; height: 1.3rem; transform: scaleY(-1); }

  @media (max-width: 719px) {
    .bkh { grid-template-columns: 1fr; }
    .bkh-arrow { justify-self: center; transform: rotate(90deg); }
    .bkh-note { text-align: center; }
  }
</style>
