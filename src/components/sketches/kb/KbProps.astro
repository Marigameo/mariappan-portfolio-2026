---
// Artboard sketch for the frontmatter story (the studio, Experiments page).
// One knowledge base file the way it ships: the files sidebar, a header with the
// file's icon, title, folder and a line about it, then its frontmatter as a list
// of rows (icon, label, field), and the doc below in the same card. On hover one
// row goes into edit in place, with a caret and a quiet "enter to save": the
// properties are part of the page, not a form somewhere else. Strive orange is
// the one fixed colour; the rest follows the theme through the .sk rules.
interface Props { label: string }
const { label } = Astro.props;
const rows = [
  { y: 122, name: 'Domain', value: 'northwind.io', prefix: true },
  { y: 154, name: 'Category', value: 'AI content workflows' },
  { y: 186, name: 'Founded', value: '2019' },
];
---
<svg class="sk fm" viewBox="0 0 600 440" preserveAspectRatio="xMidYMin slice" role="img" aria-label={label}>
  <rect width="600" height="440" class="f-tint"/>

  <!-- Files sidebar: folders and the .md files inside them, one file open. -->
  <rect width="150" height="440" class="f-card"/>
  <line x1="150.5" y1="0" x2="150.5" y2="440" class="s-line"/>
  <rect x="14" y="16" width="16" height="16" rx="5" fill="#f26b1d"/>
  <text x="36" y="28.5" font-size="10.5" font-weight="600">Strive</text>
  <rect x="12" y="44" width="126" height="20" rx="6" class="f-page s-soft" stroke-width="1"/>
  <g>
    <path d="M14 82h7l2 2h7v7h-16z" class="fm-folder"/><rect x="36" y="83" width="34" height="6" rx="3" class="f-bar"/>
    <rect x="28" y="99" width="8" height="10" rx="1.5" class="fm-doc"/><rect x="42" y="101" width="46" height="6" rx="3" class="f-bar-2"/>
    <rect x="28" y="119" width="8" height="10" rx="1.5" class="fm-doc"/><rect x="42" y="121" width="38" height="6" rx="3" class="f-bar-2"/>
    <path d="M14 142h7l2 2h7v7h-16z" class="fm-folder"/><rect x="36" y="143" width="44" height="6" rx="3" class="f-bar"/>
    <rect x="28" y="159" width="8" height="10" rx="1.5" class="fm-person"/><rect x="42" y="161" width="50" height="6" rx="3" class="f-bar-2"/>
    <rect x="28" y="179" width="8" height="10" rx="1.5" class="fm-person"/><rect x="42" y="181" width="40" height="6" rx="3" class="f-bar-2"/>
    <path d="M14 202h7l2 2h7v7h-16z" class="fm-folder"/><rect x="36" y="203" width="52" height="6" rx="3" class="f-bar"/>
    <rect x="22" y="216" width="116" height="20" rx="6" fill="#f26b1d" fill-opacity=".1"/>
    <rect x="28" y="221" width="8" height="10" rx="1.5" class="fm-doc"/><rect x="42" y="223" width="48" height="6" rx="3" fill="#f26b1d" fill-opacity=".5"/>
    <rect x="28" y="241" width="8" height="10" rx="1.5" class="fm-doc"/><rect x="42" y="243" width="36" height="6" rx="3" class="f-bar-2"/>
  </g>
  <rect x="14" y="416" width="34" height="5" rx="2.5" class="f-bar-2"/><rect x="100" y="416" width="38" height="5" rx="2.5" class="f-bar-2"/>

  <!-- Breadcrumb. -->
  <rect x="170" y="20" width="44" height="6" rx="3" class="f-bar-2"/><rect x="222" y="20" width="40" height="6" rx="3" class="f-bar-2"/><rect x="270" y="20" width="48" height="6" rx="3" class="f-bar"/>

  <!-- Header card: icon, title, folder chip, one line, and Edit. -->
  <rect x="166" y="34" width="420" height="64" rx="12" class="f-card s-soft" stroke-width="1.2"/>
  <rect x="182" y="46" width="30" height="30" rx="7" fill="#f26b1d" fill-opacity=".12"/>
  <path d="M193 54h8M195 54v6l-4 10h12l-4-10v-6" fill="none" stroke="#f26b1d" stroke-width="1.4" stroke-linejoin="round"/>
  <text x="224" y="64" font-size="19" class="t-display">Northwind</text>
  <rect x="320" y="51" width="62" height="16" rx="8" class="f-page s-soft" stroke-width="1"/>
  <text x="351" y="62.5" font-size="8" text-anchor="middle" class="t-soft">Competitors</text>
  <rect x="224" y="78" width="210" height="6" rx="3" class="f-bar-2"/>
  <rect x="528" y="46" width="44" height="20" rx="10" class="f-ink"/>
  <text x="550" y="59.5" font-size="8.5" text-anchor="middle" class="fm-on-ink">Edit</text>

  <!-- The file: frontmatter rows, then the doc, in one card. -->
  <rect x="166" y="108" width="420" height="350" rx="12" class="f-card s-soft" stroke-width="1.2"/>
  {rows.map((r, i) => (
    <g>
      <circle cx="187" cy={r.y + 11} r="5" class="fm-icon"/>
      <text x="198" y={r.y + 14} font-size="9" class="t-soft">{r.name}</text>
      <rect x="290" y={r.y} width="230" height="22" rx="5" class:list={['f-page', 's-soft', i === 1 && 'fm-field']} stroke-width="1"/>
      {r.prefix && <text x="298" y={r.y + 14.5} font-size="8" class="fm-mono">https://</text>}
      {r.prefix && <line x1="337.5" y1={r.y + 5} x2="337.5" y2={r.y + 17} class="s-line" stroke-width="1"/>}
      <text x={r.prefix ? 344 : 298} y={r.y + 14.5} font-size="9">{r.value}</text>
      {i < rows.length - 1 && <line x1="180" y1={r.y + 27.5} x2="572" y2={r.y + 27.5} class="s-line" stroke-width="1"/>}
    </g>
  ))}

  <!-- The row being edited in place, shown on hover. -->
  <g class="fm-edit">
    <rect x="290" y="154" width="230" height="22" rx="5" class="fm-ring"/>
    <line x1="389" y1="159" x2="389" y2="171" class="fm-caret"/>
    <text x="512" y="168.5" font-size="7" text-anchor="end" class="fm-hint">Enter to save</text>
  </g>

  <line x1="166" y1="222.5" x2="586" y2="222.5" class="s-line"/>
  <text x="184" y="252" font-size="16" class="t-display">Overview</text>
  <g>
    <circle cx="188" cy="271" r="2" class="f-bar"/><rect x="196" y="268" width="200" height="6" rx="3" class="f-bar-2"/>
    <circle cx="188" cy="287" r="2" class="f-bar"/><rect x="196" y="284" width="240" height="6" rx="3" class="f-bar-2"/>
    <circle cx="188" cy="303" r="2" class="f-bar"/><rect x="196" y="300" width="170" height="6" rx="3" class="f-bar-2"/>
  </g>
  <text x="184" y="340" font-size="13" class="t-display">What they do</text>
  <rect x="184" y="352" width="380" height="6" rx="3" class="f-bar-2"/>
  <rect x="184" y="366" width="350" height="6" rx="3" class="f-bar-2"/>
  <rect x="184" y="380" width="260" height="6" rx="3" class="f-bar-2"/>
  <text x="184" y="414" font-size="13" class="t-display">Key features</text>
  <rect x="184" y="426" width="320" height="6" rx="3" class="f-bar-2"/>
</svg>

<style>
  .fm text { fill: var(--ink); }
  .fm .t-soft { fill: var(--ink-soft); }
  .fm .fm-on-ink { fill: var(--paper-2); font-weight: 600; }
  .fm .fm-mono { font-family: var(--font-mono); fill: var(--ink-faint); }
  .fm .fm-folder { fill: var(--ink); fill-opacity: .16; }
  .fm .fm-doc { fill: none; stroke: #f26b1d; stroke-opacity: .7; stroke-width: 1.2; }
  .fm .fm-person { fill: none; stroke: var(--blue); stroke-opacity: .8; stroke-width: 1.2; }
  .fm .fm-icon { fill: none; stroke: var(--ink); stroke-opacity: .35; stroke-width: 1.2; }
  .fm .fm-ring { fill: none; stroke: #f26b1d; stroke-width: 1.6; }
  .fm .fm-caret { stroke: var(--ink); stroke-width: 1.2; }
  .fm .fm-hint { fill: var(--ink-faint); }
  .fm .fm-edit { opacity: 0; transition: opacity .25s ease; }
  :global(.art-link:hover) .fm .fm-edit, :global(.art-link:focus-visible) .fm .fm-edit { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.art-link:hover) .fm .fm-caret { animation: fm-blink 1s steps(1) infinite; }
  }
  @keyframes fm-blink { 50% { opacity: 0; } }
  /* In the story's Sketch tab there's no hover: show the edit as it ships. */
  :global(.fm-sketch) .fm .fm-edit { opacity: 1; }
</style>
