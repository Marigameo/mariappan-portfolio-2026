---
// Card sketch for the draw-diagrams story.
// The skill on the left: a folder card listing its files, with the install line
// under it. An arrow carries it into anyone's chat on the right: a question in a
// dark bubble and a small themed diagram, drawn in the skill's default blue
// rather than Strive orange, because it's meant for any chat. The main path is
// bold blue, the step that matters sits in a blue wash, the good outcome in
// teal, the side branch muted and dashed. Everything that matters sits in the
// top band so the 16:9 crop keeps it.
const files = ['SKILL.md', 'TOOL.md', 'MODEL-SKILL.md', 'DESIGN.md', 'validate-diagram.mjs', 'render-diagram.js'];
const blue = '#2563eb';
---
<svg class="sk" viewBox="0 0 600 440" preserveAspectRatio="xMinYMin slice" role="img" aria-label="Sketch of the draw-diagrams skill going into a chat. On the left, a folder card titled draw-diagrams lists its files: SKILL.md, TOOL.md, MODEL-SKILL.md, DESIGN.md, validate-diagram.mjs and render-diagram.js, with the install command under it. An arrow points right to a chat: a question in a dark bubble, “How does a refund work?”, and a diagram card where a flow runs from Request through a Within 30 days? decision on a bold blue main path to Approve in a blue wash and Refunded in teal, with a muted, dashed Manual review branch. A handwritten note says: in your chat.">
  <rect width="600" height="440" class="f-page"/>

  <!-- The skill: a folder of files. -->
  <g class="sk-lift">
    <rect x="20" y="24" width="214" height="236" rx="10" class="f-card s-soft" stroke-width="1.5"/>
    <path d="M36 44 h14 l4 5 h18 v14 h-36 Z" class="f-tint" stroke="var(--ink)" stroke-opacity=".35" stroke-width="1.2"/>
    <text x="82" y="58" font-size="11" font-weight="600" style="font-family: var(--font-mono)">draw-diagrams/</text>
    {files.map((f, i) => (
      <>
        <rect x="38" y={78 + i * 24} width="10" height="13" rx="1.5" class="f-paper" stroke="var(--ink)" stroke-opacity=".35" stroke-width="1"/>
        <text x="56" y={89 + i * 24} font-size="9.5" class="t-soft" style="font-family: var(--font-mono)">{f}</text>
      </>
    ))}
    <rect x="34" y="226" width="186" height="22" rx="6" class="f-ink"/>
    <text x="44" y="241" font-size="8.5" style="fill: var(--paper); font-family: var(--font-mono)">npx skills add marigameo/skills</text>
  </g>

  <!-- Into any chat. -->
  <path d="M246 142 H286" class="s-ink" stroke-width="1.5" stroke-opacity=".6"/>
  <path d="M280 136 l7 6 -7 6" class="s-ink" stroke-width="1.5" stroke-opacity=".6"/>

  <rect x="388" y="24" width="192" height="26" rx="13" class="f-ink"/>
  <text x="484" y="41" font-size="10" text-anchor="middle" style="fill: var(--paper)">How does a refund work?</text>

  <g class="sk-lift">
    <rect x="298" y="62" width="282" height="198" rx="10" class="f-card s-soft" stroke-width="1.5"/>
    <text x="312" y="84" font-size="10" font-weight="600" class="t-soft">How a refund gets handled</text>

    <!-- Edges first. The main path is bold blue. -->
    <path d="M360 118 V132" stroke={blue} stroke-width="2.4" fill="none"/>
    <path d="M360 178 V196" stroke={blue} stroke-width="2.4" fill="none"/>
    <path d="M403 214 H430" stroke={blue} stroke-width="2.4" fill="none"/>
    <path d="M384 155 H446 V176" class="s-ink" stroke-opacity=".45"/>

    <rect x="320" y="94" width="80" height="24" rx="12" class="f-paper" stroke="var(--ink)" stroke-opacity=".3" stroke-width="1.3"/>
    <text x="360" y="110" font-size="9" text-anchor="middle">Request</text>

    <path d="M360 132 L384 155 L360 178 L336 155 Z" class="f-paper" stroke="var(--ink)" stroke-opacity=".3" stroke-width="1.3"/>
    <text x="360" y="158" font-size="7.5" text-anchor="middle">30 days?</text>

    <!-- The step that matters: a blue wash. -->
    <rect x="317" y="196" width="86" height="26" rx="6" fill={blue} fill-opacity=".1" stroke={blue} stroke-width="1.5"/>
    <text x="360" y="213" font-size="9" text-anchor="middle">Approve</text>

    <rect x="430" y="201" width="80" height="26" rx="13" fill="var(--teal)" fill-opacity=".14" stroke="var(--teal)" stroke-width="1.5"/>
    <text x="470" y="218" font-size="9" text-anchor="middle">Refunded</text>

    <!-- Off the main path: muted and dashed. -->
    <rect x="410" y="176" width="88" height="22" rx="6" class="f-tint" stroke="var(--ink)" stroke-opacity=".3" stroke-width="1.2" stroke-dasharray="4 3"/>
    <text x="454" y="191" font-size="8.5" text-anchor="middle" class="t-soft">Manual review</text>

    <rect x="312" y="240" width="170" height="5" rx="2.5" class="f-bar-2"/>
  </g>
  <text x="430" y="292" font-size="16" style="fill: var(--coral); font-family: var(--font-hand)">in your chat</text>

  <!-- Below the hero crop: the composer. -->
  <rect x="298" y="344" width="282" height="76" rx="16" class="f-card" stroke="var(--ink)" stroke-opacity=".2" stroke-width="1.5"/>
  <text x="316" y="372" font-size="11" class="t-soft">Ask anything…</text>
</svg>
