---
// Card sketch for the brand kit project.
// Hand-drawn product sketch, read left to right: a customer's website, the brand
// kit read from it (swatches, type, corners, usage rules), and a report wearing
// the same colours. Everything sits in the top band so the card and deep-dive
// crops keep all three. Colours come from the .sk rules in src/styles/style.css
// so it follows the theme; the fixed hex values are the made-up customer brand.
---
<svg class="sk" viewBox="0 0 600 440" preserveAspectRatio="xMinYMin slice" role="img" aria-label="Sketch of a brand kit, read left to right: a customer's website with an indigo button, an arrow to a brand kit card holding four colour swatches, a type sample, a corner radius and usage rules, and an arrow to a report whose hero number and chart bars wear the same indigo and sky blue">
  <rect width="600" height="440" class="f-page"/>

  <g class="sk-lift">
    <rect x="20" y="30" width="180" height="222" rx="10" class="f-card s-soft" stroke-width="1.5"/>
    <line x1="20" y1="54.5" x2="200" y2="54.5" class="s-line"/>
    <circle cx="34" cy="42" r="3.5" class="f-bar"/>
    <circle cx="46" cy="42" r="3.5" class="f-bar"/>
    <circle cx="58" cy="42" r="3.5" class="f-bar"/>
    <rect x="72" y="36" width="112" height="12" rx="6" class="f-tint"/>
    <text x="81" y="45.5" font-size="8" class="t-soft">yourbrand.com</text>
    <rect x="34" y="66" width="10" height="10" rx="3" fill="#4F46E5"/>
    <rect x="50" y="68" width="36" height="6" rx="3" class="f-bar"/>
    <rect x="132" y="68" width="22" height="6" rx="3" class="f-bar-2"/>
    <rect x="160" y="68" width="22" height="6" rx="3" class="f-bar-2"/>
    <rect x="34" y="96" width="130" height="11" rx="5.5" class="f-bar"/>
    <rect x="34" y="114" width="100" height="11" rx="5.5" class="f-bar"/>
    <rect x="34" y="136" width="146" height="5" rx="2.5" class="f-bar-2"/>
    <rect x="34" y="147" width="118" height="5" rx="2.5" class="f-bar-2"/>
    <rect x="34" y="166" width="64" height="22" rx="7" fill="#4F46E5"/>
    <rect x="46" y="175" width="40" height="5" rx="2.5" class="f-paper"/>
    <rect x="104" y="166" width="54" height="22" rx="7" class="s-soft" fill="none" stroke-width="1.4"/>
    <rect x="34" y="202" width="152" height="36" rx="6" class="f-tint"/>
  </g>

  <path d="M204 132 C 210 124, 216 124, 222 130" class="s-ink" stroke-dasharray="3 3"/>
  <path d="M216 124 l7 6 -9 2" class="s-ink"/>

  <g class="sk-lift">
    <rect x="226" y="30" width="164" height="222" rx="10" class="f-card" stroke="#4F46E5" stroke-opacity=".55" stroke-width="1.5"/>
    <text x="240" y="54" font-size="12" font-weight="600">Brand kit</text>
    <rect x="240" y="68" width="30" height="30" rx="6" fill="#4F46E5"/>
    <rect x="276" y="68" width="30" height="30" rx="6" fill="#0EA5E9"/>
    <rect x="312" y="68" width="30" height="30" rx="6" fill="#FAFAFF" class="s-soft" stroke-width="1.4"/>
    <rect x="348" y="68" width="30" height="30" rx="6" fill="#1E1B4B"/>
    <text x="240" y="138" font-size="30" class="t-display">Aa</text>
    <rect x="288" y="118" width="48" height="5" rx="2.5" class="f-bar"/>
    <rect x="288" y="129" width="32" height="5" rx="2.5" class="f-bar-2"/>
    <path d="M352 140 v-14 a 10 10 0 0 1 10 -10 h 14" class="s-ink" stroke-opacity=".6"/>
    <line x1="240" y1="154.5" x2="376" y2="154.5" class="s-line" stroke-dasharray="4 4"/>
    <rect x="240" y="166" width="134" height="5" rx="2.5" class="f-bar-2"/>
    <rect x="240" y="179" width="110" height="5" rx="2.5" class="f-bar-2"/>
    <rect x="240" y="192" width="86" height="5" rx="2.5" class="f-bar-2"/>
    <rect x="236" y="222" width="132" height="15" rx="7.5" class="f-tint"/>
    <text x="246" y="232.5" font-size="8" class="t-soft">extracted · yourbrand.com</text>
  </g>

  <path d="M394 132 C 400 124, 406 124, 412 130" class="s-ink" stroke-dasharray="3 3"/>
  <path d="M406 124 l7 6 -9 2" class="s-ink"/>

  <g class="sk-lift">
    <rect x="416" y="30" width="164" height="222" rx="10" class="f-card s-soft" stroke-width="1.5"/>
    <rect x="430" y="44" width="62" height="6" rx="3" class="f-bar"/>
    <rect x="430" y="62" width="136" height="72" rx="8" fill="#4F46E5"/>
    <rect x="442" y="74" width="36" height="4" rx="2" class="f-paper" fill-opacity=".7"/>
    <text x="442" y="106" font-size="20" font-weight="700" fill="#fff">$48k</text>
    <path d="M442 124 C 466 116, 484 121, 502 114 S 538 108, 554 102" fill="none" stroke="#fff" stroke-opacity=".75" stroke-width="1.5" stroke-linecap="round"/>
    <line x1="430" y1="236.5" x2="566" y2="236.5" class="s-line"/>
    <rect x="432" y="196" width="12" height="40" rx="2.5" fill="#4F46E5"/>
    <rect x="446" y="210" width="12" height="26" rx="2.5" fill="#0EA5E9"/>
    <rect x="466" y="178" width="12" height="58" rx="2.5" fill="#4F46E5"/>
    <rect x="480" y="200" width="12" height="36" rx="2.5" fill="#0EA5E9"/>
    <rect x="500" y="186" width="12" height="50" rx="2.5" fill="#4F46E5"/>
    <rect x="514" y="206" width="12" height="30" rx="2.5" fill="#0EA5E9"/>
    <rect x="534" y="164" width="12" height="72" rx="2.5" fill="#4F46E5"/>
    <rect x="548" y="192" width="12" height="44" rx="2.5" fill="#0EA5E9"/>
    <rect x="430" y="152" width="44" height="5" rx="2.5" class="f-bar-2"/>
  </g>

  <!-- Below the fold of the crops: the same file, read by more than reports. -->
  <rect x="20" y="276" width="560" height="56" rx="10" class="f-card s-soft" fill-opacity=".45" stroke-width="1.5" stroke-dasharray="5 5"/>
  <text x="38" y="309" font-size="11" class="t-soft">brand/design.md</text>
  <rect x="150" y="294" width="74" height="22" rx="11" fill="#4F46E5" fill-opacity=".12" stroke="#4F46E5" stroke-opacity=".5" stroke-width="1.2"/>
  <text x="166" y="309" font-size="10" font-weight="600">Reports</text>
  <rect x="234" y="294" width="58" height="22" rx="11" fill="none" class="s-soft" stroke-width="1.2" stroke-dasharray="3 3"/>
  <text x="250" y="309" font-size="10" class="t-soft">Chat</text>
  <rect x="302" y="294" width="76" height="22" rx="11" fill="none" class="s-soft" stroke-width="1.2" stroke-dasharray="3 3"/>
  <text x="317" y="309" font-size="10" class="t-soft">Artifacts</text>
  <rect x="388" y="294" width="66" height="22" rx="11" fill="none" class="s-soft" stroke-width="1.2" stroke-dasharray="3 3"/>
  <text x="403" y="309" font-size="10" class="t-soft">Emails</text>
</svg>
