---
/* The two functional pieces between the model and the screen: a custom streaming
   parser (langdiff-inspired) and one shared contracts package both sides consume.
   The pipeline runs left to right and stacks on a phone; the shared package sits
   underneath and feeds both ends. */
import Icon from '../../Icon.astro';

const pipe = [
  { label: 'Server', sub: 'LLM tool calls → blocks', tone: '' },
  { label: 'Streaming parser', sub: 'custom · langdiff-inspired + our extras', tone: 'coral' },
  { label: 'Renderer', sub: 'block type → component', tone: '' },
];
const kinds = ['interactive', 'read-only', 'stateful', 'live slots'];
---
<figure class="sk-fig">
  <div class="sk-sheet pc" role="img" aria-label="Server-side tool calls stream as blocks into a custom streaming parser, inspired by langdiff and extended for our platform, then into the renderer. Underneath, one shared package of contracts, a prompt registry and Zod schemas is consumed by both client and server. It covers interactive, read-only, stateful and live components.">
    <ol class="pc-pipe">
      {pipe.map((p, i) => (
        <>
          {i > 0 && <li class="sk-arrow pc-arrow" aria-hidden="true"><Icon name="arrow-right" /></li>}
          <li class:list={['sk-box', p.tone && `sk-box--${p.tone}`, `sk-lean-${i + 1}`]}>
            <strong>{p.label}</strong>
            <span>{p.sub}</span>
          </li>
        </>
      ))}
    </ol>
    <p class="pc-feeds sk-hand" aria-hidden="true">↑ both ends read from one source ↑</p>
    <div class="sk-box sk-box--blue sk-lean-4 pc-shared">
      <p class="sk-hdr">Shared package · client + server</p>
      <p class="pc-mods"><span>Contracts</span><span>Prompt registry</span><span>Zod schemas</span></p>
      <p class="pc-kinds">One contract system for every kind of component: {kinds.map((k) => <em>{k}</em>)}</p>
    </div>
  </div>
</figure>

<style>
  .pc-pipe { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr auto 1.2fr auto 1fr; align-items: center; gap: .6rem; }
  .pc-pipe .sk-box { display: grid; gap: .2rem; text-align: center; }
  .pc-pipe strong { font-size: .9rem; font-weight: 500; color: var(--c); }
  .pc-pipe span { font-size: .74rem; line-height: 1.35; color: var(--ink-faint); }
  .pc-feeds { margin: 1rem 0 .7rem !important; max-width: none; text-align: center; color: var(--blue); }
  .pc-shared { text-align: center; }
  .pc-shared .sk-hdr { font-size: .64rem; color: var(--blue); }
  .pc-mods { display: flex; justify-content: center; flex-wrap: wrap; gap: .5rem; margin: 0 0 .7rem !important; max-width: none; }
  .pc-mods span { padding: .3rem .7rem; border: 1.5px solid var(--ink); border-radius: 999px; font-size: .8rem; font-weight: 500; color: var(--ink); }
  .pc-kinds { margin: 0 !important; max-width: none; font-size: .78rem; color: var(--ink-faint); }
  .pc-kinds em { font-style: normal; font-family: var(--font-mono); font-size: .7rem; color: var(--ink-soft); margin-left: .45rem; }
  @media (max-width: 559px) {
    .pc-pipe { grid-template-columns: 1fr; justify-items: stretch; }
    .pc-arrow { justify-self: center; transform: rotate(90deg); }
  }
</style>
