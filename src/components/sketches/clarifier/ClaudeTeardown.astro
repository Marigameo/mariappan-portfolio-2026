---
/* The homework, in one figure. On top, Claude's clarifying-question card redrawn as a
   wireframe (no screenshot, no brand), with numbered pins tied to notes on what each
   part does. Below, a strip of the other systems I looked at, each with the one thing
   I took from it. The pins sit in the wireframe's margin; on a phone the notes stack
   under the card and the strip becomes one column. */
const notes = [
  { n: 1, t: 'The question, in plain words', d: 'One decision per screen, with no form to scan.' },
  { n: 2, t: '“2 of 4”', d: 'How many are left, so it never feels endless.' },
  { n: 3, t: 'Numbered keys', d: 'The number is the shortcut.' },
  { n: 4, t: 'An arrow on the active row', d: 'It shows where Enter goes.' },
  { n: 5, t: '“Something else”', d: 'The escape hatch, always one row, never hidden.' },
  { n: 6, t: 'Skip, and ×', d: 'Two ways out. I wanted each to mean something different.' },
];
const others = [
  { who: 'Cursor plan mode', took: 'Multi-select must never move on by itself. Theirs did, after one click.' },
  { who: 'ChatGPT deep research', took: 'Ask before the expensive work, not halfway through it.' },
  { who: 'MCP elicitation', took: 'Accept, decline and cancel are three different answers.' },
  { who: 'LangGraph interrupts', took: 'The agent can choose to ask, or a step can always need a human.' },
  { who: 'Shape of AI', took: 'Follow-ups belong before generation, short and set apart.' },
];
---
<figure class="sk-fig">
  <div class="sk-sheet tk" role="img" aria-label="A wireframe of Claude’s clarifying-question card, taken apart. 1: the question, in plain words, one decision per screen. 2: a step count, 2 of 4, so it never feels endless. 3: numbered keys, where the number is the shortcut. 4: an arrow on the active row, showing where Enter goes. 5: a Something else row, the escape hatch, always there. 6: Skip and a close button, two ways out, which I wanted to mean different things. Below, what I took from others: Cursor’s plan mode taught me multi-select must never move on by itself; ChatGPT deep research asks before the expensive work; MCP elicitation separates accept, decline and cancel; LangGraph shows the agent can choose to ask or a step can always need a human; and Shape of AI puts follow-ups before generation, short and set apart.">
    <div class="tk-top">
      <div class="tk-card sk-box sk-lean-1" aria-hidden="true">
        <div class="tk-head">
          <span class="tk-q">What’s your budget per night? <i class="tk-pin">1</i></span>
          <span class="tk-count">2 of 4 <i class="tk-pin">2</i></span>
          <span class="tk-x">×</span>
        </div>
        <div class="tk-rows">
          <div class="tk-row tk-row--on"><span class="tk-key">1</span><span>$250–400</span><span class="tk-arrow">→ <i class="tk-pin">4</i></span><i class="tk-pin tk-pin--key">3</i></div>
          <div class="tk-row"><span class="tk-key">2</span><span>$400–600</span></div>
          <div class="tk-row"><span class="tk-key">3</span><span>$600+</span></div>
          <div class="tk-row tk-row--else"><span class="tk-key">✎</span><span>Something else</span><i class="tk-pin">5</i></div>
        </div>
        <div class="tk-foot"><span class="tk-skip">Skip</span><i class="tk-pin">6</i></div>
        <p class="tk-hint">↑↓ to move · Enter to pick · Esc to skip</p>
      </div>
      <ol class="tk-notes" aria-hidden="true">
        {notes.map((x) => <li><i class="tk-pin">{x.n}</i><b>{x.t}</b><span>{x.d}</span></li>)}
      </ol>
    </div>
    <p class="sk-hdr tk-sub" aria-hidden="true">And what I took from others</p>
    <ul class="tk-others" aria-hidden="true">
      {others.map((o, i) => (
        <li class:list={['sk-box', 'sk-box--blue', `sk-lean-${(i % 4) + 1}`]}>
          <p class="tk-who">{o.who}</p>
          <p class="tk-took">{o.took}</p>
        </li>
      ))}
    </ul>
  </div>
  <figcaption>Learn why it works first. Then the parts you keep are on purpose.</figcaption>
</figure>

<style>
  .tk { display: grid; gap: 1.1rem; }
  .tk p { margin: 0 !important; max-width: none; }
  .tk-top { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 1.4rem; align-items: center; }
  .tk-pin { display: inline-grid; place-items: center; flex: none; inline-size: 1.15rem; block-size: 1.15rem; font: 600 .62rem/1 var(--font-mono); font-style: normal; color: var(--paper-2); background: var(--coral); border-radius: 50%; }

  .tk-card { padding: .9rem .9rem .7rem; background: var(--paper-2); font-family: var(--font-sub); }
  .tk-head { display: flex; align-items: center; gap: .6rem; margin-bottom: .6rem; }
  .tk-q { flex: 1; display: flex; align-items: center; gap: .35rem; font-family: var(--font-display); font-size: 1rem; color: var(--ink); }
  .tk-count { display: flex; align-items: center; gap: .3rem; font-size: .72rem; color: var(--ink-faint); white-space: nowrap; }
  .tk-x { font-size: 1rem; color: var(--ink-faint); }
  .tk-rows { display: grid; }
  .tk-row { position: relative; display: flex; align-items: center; gap: .6rem; padding: .45rem .5rem; font-size: .8rem; color: var(--ink); border-bottom: 1px solid var(--line); }
  .tk-row--on { background: var(--sand); border-radius: 6px; border-color: transparent; }
  .tk-row--else { color: var(--ink-faint); border-bottom: 0; }
  .tk-row--else .tk-pin { margin-inline-start: auto; }
  .tk-key { display: grid; place-items: center; inline-size: 1.3rem; block-size: 1.3rem; font: .66rem var(--font-mono); color: var(--ink-soft); background: var(--sand-2); border-radius: 4px; }
  .tk-arrow { display: flex; align-items: center; gap: .3rem; margin-inline-start: auto; color: var(--ink-soft); }
  .tk-pin--key { position: absolute; inset-inline-start: -.7rem; inset-block-start: -.45rem; }
  .tk-foot { display: flex; justify-content: flex-end; align-items: center; gap: .35rem; margin-top: .55rem; padding-top: .55rem; border-top: 1px solid var(--line); }
  .tk-skip { padding: .2rem .6rem; font-size: .74rem; border: 1px solid var(--line); border-radius: 6px; color: var(--ink); }
  .tk-hint { margin-top: .5rem !important; text-align: center; font-size: .64rem; color: var(--ink-faint); }

  .tk-notes { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .tk-notes li { display: grid; grid-template-columns: auto 1fr; column-gap: .55rem; align-items: baseline; }
  .tk-notes b { font-size: .86rem; font-weight: 500; color: var(--ink); }
  .tk-notes span { grid-column: 2; font-size: .78rem; line-height: 1.4; color: var(--ink-faint); }

  .tk-sub { margin-top: .2rem !important; font-size: .62rem !important; letter-spacing: .14em; color: var(--ink-faint); }
  .tk-others { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .7rem; }
  .tk-others li { display: grid; gap: .3rem; align-content: start; padding: .6rem .65rem .7rem; }
  .tk-who { font-family: var(--font-mono); font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; color: var(--c); }
  .tk-took { font-size: .78rem; line-height: 1.4; color: var(--ink); }

  @media (max-width: 719px) {
    .tk-top { grid-template-columns: 1fr; }
    .tk-others { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 459px) { .tk-others { grid-template-columns: 1fr; } }
</style>
