---
// Card sketch for the design ecosystem story.
// The design system doc in the middle, with the two doors it opens: Storybook on
// the left for people, llms.txt on the right for coding agents. Everything that
// matters sits in the top band so the 16:9 card crop keeps all three. Below the
// fold, the two packages the whole thing stands on. Strive orange is the one
// fixed colour; the rest follows the theme through the .sk rules.
---
<svg class="sk" viewBox="0 0 600 440" preserveAspectRatio="xMinYMin slice" role="img" aria-label="Sketch of the Strive design ecosystem: a design system doc in the middle with foundations, patterns and components, orange swatches and a type sample. Dashed arrows lead out to a Storybook playground on the left, with an orange button, an input and a toggle, and to an llms.txt file for coding agents on the right. Below, two slabs: ui-core and ui-blocks.">
  <rect width="600" height="440" class="f-page"/>

  <!-- Storybook: a sidebar and three live components. -->
  <g class="sk-lift">
    <rect x="20" y="30" width="180" height="222" rx="10" class="f-card s-soft" stroke-width="1.5"/>
    <text x="34" y="52" font-size="11" font-weight="600">Storybook</text>
    <line x1="74" y1="64" x2="74" y2="240" class="s-line"/>
    <rect x="32" y="74" width="32" height="6" rx="3" class="f-bar"/>
    <rect x="32" y="88" width="26" height="6" rx="3" class="f-bar-2"/>
    <rect x="32" y="102" width="30" height="6" rx="3" class="f-bar-2"/>
    <rect x="32" y="116" width="22" height="6" rx="3" class="f-bar-2"/>
    <rect x="32" y="130" width="28" height="6" rx="3" class="f-bar-2"/>
    <rect x="88" y="76" width="70" height="22" rx="7" fill="#f26b1d"/>
    <rect x="102" y="85" width="42" height="5" rx="2.5" class="f-paper"/>
    <rect x="88" y="114" width="98" height="22" rx="6" fill="none" class="s-soft" stroke-width="1.4"/>
    <rect x="96" y="123" width="40" height="5" rx="2.5" class="f-bar-2"/>
    <rect x="88" y="152" width="30" height="16" rx="8" fill="#f26b1d" fill-opacity=".85"/>
    <circle cx="110" cy="160" r="5.5" class="f-paper"/>
    <rect x="126" y="157" width="44" height="5" rx="2.5" class="f-bar-2"/>
    <rect x="88" y="186" width="98" height="40" rx="6" class="f-tint"/>
    <rect x="96" y="196" width="60" height="5" rx="2.5" class="f-bar"/>
    <rect x="96" y="208" width="80" height="5" rx="2.5" class="f-bar-2"/>
  </g>

  <path d="M222 132 C 216 124, 210 124, 204 130" class="s-ink" stroke-dasharray="3 3"/>
  <path d="M210 124 l-7 6 9 2" class="s-ink"/>

  <!-- The doc: the one source of truth. -->
  <g class="sk-lift">
    <rect x="226" y="30" width="164" height="222" rx="10" class="f-card" stroke="#f26b1d" stroke-opacity=".6" stroke-width="1.5"/>
    <rect x="240" y="44" width="10" height="10" rx="3" fill="#f26b1d"/>
    <text x="256" y="53" font-size="10" font-weight="600">Design system</text>
    <rect x="240" y="66" width="40" height="12" rx="6" fill="#f26b1d" fill-opacity=".16"/>
    <rect x="284" y="66" width="34" height="12" rx="6" class="f-tint"/>
    <rect x="322" y="66" width="40" height="12" rx="6" class="f-tint"/>
    <text x="240" y="118" font-size="30" class="t-display">Aa</text>
    <rect x="288" y="98" width="70" height="5" rx="2.5" class="f-bar"/>
    <rect x="288" y="110" width="52" height="5" rx="2.5" class="f-bar-2"/>
    <rect x="240" y="134" width="24" height="24" rx="5" fill="#f26b1d"/>
    <rect x="268" y="134" width="24" height="24" rx="5" fill="#f26b1d" fill-opacity=".7"/>
    <rect x="296" y="134" width="24" height="24" rx="5" fill="#f26b1d" fill-opacity=".4"/>
    <rect x="324" y="134" width="24" height="24" rx="5" fill="#f26b1d" fill-opacity=".15"/>
    <rect x="352" y="134" width="24" height="24" rx="5" class="f-ink"/>
    <line x1="240" y1="172.5" x2="376" y2="172.5" class="s-line" stroke-dasharray="4 4"/>
    <rect x="240" y="184" width="64" height="26" rx="5" class="f-tint"/>
    <rect x="310" y="184" width="64" height="26" rx="5" class="f-tint"/>
    <rect x="248" y="194" width="34" height="5" rx="2.5" class="f-bar"/>
    <rect x="318" y="194" width="40" height="5" rx="2.5" class="f-bar"/>
    <rect x="240" y="218" width="134" height="5" rx="2.5" class="f-bar-2"/>
    <rect x="240" y="230" width="100" height="5" rx="2.5" class="f-bar-2"/>
  </g>

  <path d="M394 132 C 400 124, 406 124, 412 130" class="s-ink" stroke-dasharray="3 3"/>
  <path d="M406 124 l7 6 -9 2" class="s-ink"/>

  <!-- For coding agents: a tiny router file. -->
  <g class="sk-lift">
    <rect x="416" y="30" width="164" height="222" rx="10" class="f-card s-soft" stroke-width="1.5"/>
    <text x="430" y="52" font-size="11" style="font-family: var(--font-mono)" font-weight="600">llms.txt</text>
    <line x1="416" y1="64.5" x2="580" y2="64.5" class="s-line"/>
    <text x="430" y="86" font-size="9" class="t-soft">1</text>
    <rect x="442" y="80" width="56" height="6" rx="3" class="f-bar"/>
    <text x="504" y="86" font-size="9" fill="#f26b1d">→ DESIGN.md</text>
    <text x="430" y="108" font-size="9" class="t-soft">2</text>
    <rect x="442" y="102" width="48" height="6" rx="3" class="f-bar"/>
    <text x="496" y="108" font-size="9" fill="#f26b1d">→ index.md</text>
    <text x="430" y="130" font-size="9" class="t-soft">3</text>
    <rect x="442" y="124" width="64" height="6" rx="3" class="f-bar"/>
    <text x="430" y="152" font-size="9" class="t-soft">4</text>
    <rect x="442" y="146" width="40" height="6" rx="3" class="f-bar"/>
    <text x="488" y="152" font-size="9" fill="#f26b1d">→ tokens.json</text>
    <text x="430" y="174" font-size="9" class="t-soft">5</text>
    <rect x="442" y="168" width="70" height="6" rx="3" class="f-bar-2"/>
    <rect x="430" y="196" width="136" height="40" rx="6" class="f-tint"/>
    <text x="440" y="213" font-size="8.5" class="t-soft">for Claude Code,</text>
    <text x="440" y="226" font-size="8.5" class="t-soft">Cursor and friends</text>
  </g>

  <!-- Below the fold of the crops: the packages everything stands on. -->
  <rect x="60" y="282" width="480" height="40" rx="10" class="f-card" stroke="#f26b1d" stroke-opacity=".45" stroke-width="1.5"/>
  <text x="80" y="307" font-size="11" font-weight="600">@strivelabs/ui-blocks</text>
  <rect x="260" y="298" width="60" height="12" rx="6" class="f-tint"/>
  <rect x="326" y="298" width="72" height="12" rx="6" class="f-tint"/>
  <rect x="404" y="298" width="56" height="12" rx="6" class="f-tint"/>
  <rect x="20" y="334" width="560" height="40" rx="10" class="f-card s-soft" stroke-width="1.5"/>
  <text x="40" y="359" font-size="11" font-weight="600">@strivelabs/ui-core</text>
  <rect x="220" y="350" width="48" height="12" rx="6" class="f-tint"/>
  <rect x="274" y="350" width="44" height="12" rx="6" class="f-tint"/>
  <rect x="324" y="350" width="56" height="12" rx="6" class="f-tint"/>
  <rect x="386" y="350" width="40" height="12" rx="6" class="f-tint"/>
</svg>
