---
// Artboard sketch for the chat mode picker story (the studio, Experiments page).
// A chat home in Strive: a greeting, the composer with an Effort pill, and the
// effort popover open above it, Faster at one end and Smarter at the other. At
// rest the slider sits on Balanced; on hover the thumb slides to Deep Dive, the
// track glitters and the composer's outline glows deeper, the way a mode change
// reads in the prototype. Strive's orange-to-magenta is the one fixed colour;
// the rest follows the theme through the .sk rules. The story's hero shows the
// Deep Dive state, since there's no hover there.
interface Props { label: string }
const { label } = Astro.props;
const sparkles = [[340, 167], [362, 171], [388, 166], [410, 172], [436, 167], [458, 171], [484, 166], [500, 172]];
---
<svg class="sk cm" viewBox="0 0 600 440" preserveAspectRatio="xMidYMin slice" role="img" aria-label={label}>
  <defs>
    <linearGradient id="cm-grad" x1="0" x2="1">
      <stop offset="0" stop-color="#F7BB5C" /><stop offset=".5" stop-color="#F56B10" /><stop offset="1" stop-color="#B34086" />
    </linearGradient>
  </defs>
  <rect width="600" height="440" class="f-tint" />

  <!-- A slim nav rail. -->
  <rect x="14" y="14" width="34" height="200" rx="12" class="f-card s-soft" stroke-width="1" />
  <rect x="23" y="24" width="16" height="16" rx="5" fill="url(#cm-grad)" />
  <circle cx="31" cy="62" r="5" class="cm-icon" /><circle cx="31" cy="86" r="5" class="cm-icon" /><circle cx="31" cy="110" r="5" class="cm-icon" />

  <!-- Greeting. -->
  <text x="112" y="76" font-size="21" class="t-display t-soft">Good afternoon, <tspan class="cm-name">Maya</tspan></text>

  <!-- The effort popover, open above the pill. -->
  <rect x="300" y="96" width="232" height="96" rx="12" class="f-card s-soft cm-pop" stroke-width="1.2" />
  <text x="318" y="124" font-size="12" class="t-soft">Effort</text>
  <text x="356" y="124" font-size="12" font-weight="700" class="cm-word cm-word--bal">Balanced</text>
  <text x="356" y="124" font-size="12" font-weight="700" fill="url(#cm-grad)" class="cm-word cm-word--deep">Deep Dive</text>
  <circle cx="512" cy="120" r="6" class="cm-icon" />
  <text x="318" y="152" font-size="8.5" class="t-soft">Faster</text>
  <text x="514" y="152" font-size="8.5" text-anchor="end" class="t-soft">Smarter</text>
  <rect x="318" y="162" width="196" height="12" rx="6" class="f-bar-2" />
  <rect x="318" y="162" width="196" height="12" rx="6" fill="url(#cm-grad)" class="cm-fill" />
  <g class="cm-glitter">{sparkles.map(([x, y]) => <circle cx={x} cy={y} r="1.1" fill="#fff" />)}</g>
  <circle cx="0" cy="168" r="10" class="cm-thumb" />

  <!-- The composer, its outline glowing with the mode. -->
  <rect x="104" y="208" width="456" height="92" rx="16" class="cm-glow" />
  <rect x="108" y="212" width="448" height="84" rx="13" class="f-card s-soft" stroke-width="1.2" />
  <text x="128" y="240" font-size="12" class="t-soft">Ask anything…</text>
  <path d="M137 266l-7.5 7.5a3.6 3.6 0 0 1-5-5l8-8a2.4 2.4 0 0 1 3.4 3.4l-7.6 7.6" class="cm-clip" />
  <rect x="420" y="258" width="92" height="26" rx="8" class="f-page s-soft" stroke-width="1" />
  <text x="434" y="275" font-size="10" font-weight="700" class="cm-word cm-word--bal">Balanced</text>
  <text x="434" y="275" font-size="10" font-weight="700" fill="url(#cm-grad)" class="cm-word cm-word--deep">Deep Dive</text>
  <path d="M495 268l4 4 4-4" class="cm-chev" />
  <rect x="518" y="258" width="26" height="26" rx="8" class="f-ink" />
  <path d="M526 271l11-5-4 11-2-4z" class="cm-send" />

  <!-- Suggestions under the composer. -->
  <rect x="128" y="318" width="96" height="20" rx="10" class="f-page s-soft" stroke-width="1" />
  <rect x="232" y="318" width="120" height="20" rx="10" class="f-page s-soft" stroke-width="1" />
  <rect x="360" y="318" width="84" height="20" rx="10" class="f-page s-soft" stroke-width="1" />
  <rect x="142" y="325" width="68" height="6" rx="3" class="f-bar-2" /><rect x="246" y="325" width="92" height="6" rx="3" class="f-bar-2" /><rect x="374" y="325" width="56" height="6" rx="3" class="f-bar-2" />
</svg>

<style>
  .cm text { fill: var(--ink); }
  .cm .t-soft { fill: var(--ink-soft); }
  .cm .cm-name { fill: var(--ink); }
  .cm .cm-word--bal { fill: var(--ink); }
  .cm .cm-word--deep { fill: url(#cm-grad); }
  .cm .cm-icon { fill: none; stroke: var(--ink); stroke-opacity: .3; stroke-width: 1.2; }
  .cm .cm-clip, .cm .cm-chev { fill: none; stroke: var(--ink); stroke-opacity: .45; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .cm .cm-send { fill: var(--paper-2); }
  .cm .cm-pop { filter: drop-shadow(0 4px 8px color-mix(in srgb, var(--ink) 10%, transparent)); }
  .cm .cm-thumb { fill: #fff; stroke: #000; stroke-opacity: .12; stroke-width: 1; }
  .cm .cm-glow { fill: none; stroke: #F7BB5C; stroke-opacity: .35; stroke-width: 4; }

  /* Balanced at rest, Deep Dive on hover. */
  .cm .cm-fill { transform-box: fill-box; transform-origin: left; transform: scaleX(.5); }
  .cm .cm-thumb { transform: translateX(416px); }
  .cm .cm-word--deep, .cm .cm-glitter { opacity: 0; }
  .cm .cm-fill, .cm .cm-thumb, .cm .cm-glow, .cm .cm-word, .cm .cm-glitter { transition: transform .45s cubic-bezier(.2,.8,.2,1), opacity .3s ease, stroke .3s ease, stroke-opacity .3s ease; }
  :global(.art-link:hover) .cm .cm-fill, :global(.art-link:focus-visible) .cm .cm-fill, :global(.cm-deep) .cm .cm-fill { transform: scaleX(.93); }
  :global(.art-link:hover) .cm .cm-thumb, :global(.art-link:focus-visible) .cm .cm-thumb, :global(.cm-deep) .cm .cm-thumb { transform: translateX(500px); }
  :global(.art-link:hover) .cm .cm-word--deep, :global(.art-link:focus-visible) .cm .cm-word--deep, :global(.cm-deep) .cm .cm-word--deep,
  :global(.art-link:hover) .cm .cm-glitter, :global(.art-link:focus-visible) .cm .cm-glitter, :global(.cm-deep) .cm .cm-glitter { opacity: 1; }
  :global(.art-link:hover) .cm .cm-word--bal, :global(.art-link:focus-visible) .cm .cm-word--bal, :global(.cm-deep) .cm .cm-word--bal { opacity: 0; }
  :global(.art-link:hover) .cm .cm-glow, :global(.art-link:focus-visible) .cm .cm-glow, :global(.cm-deep) .cm .cm-glow { stroke: #B34086; stroke-opacity: .3; }
  @media (prefers-reduced-motion: reduce) { .cm * { transition: none !important; } }
</style>
