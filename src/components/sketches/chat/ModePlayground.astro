---
/* A playground for the chat mode picker story, rebuilt from the Claude prototypes:
   one composer, seven ways to pick Quick, Balanced or Deep Dive, and the mode
   carries over as you switch between them. With `compare`, a second switch
   flips between the first pass (v1) and the build after the interaction audit
   (v2), so the fixes can be felt, not only read: v1's labels resize their pill,
   its popovers snap shut behind an invisible backdrop, its thumb jumps stop to
   stop and it has no keyboard; v2 is the audited one. It keeps the prototype's
   own look (Strive orange, a serif greeting, system font) and stays light in
   dark mode, like the playground in the frontmatter story. Every direction is
   server-rendered; without JS it shows as a still. */
interface Props {
  /** Show the v1 / v2 switch. */
  compare?: boolean;
  /** Direction to open on. */
  start?: string;
  build?: 'v1' | 'v2';
  caption?: string;
}
const { compare = false, start = '1a', build = 'v2', caption } = Astro.props;

const LABELS = ['Quick', 'Balanced', 'Deep Dive'];
const DESCS = ['Fast, lighter answers', 'A mix of speed and detail', 'Slower, more thorough analysis'];

const dirs = [
  { id: '1a', name: 'Rising signal', sub: 'sliding segmented control', subV1: 'expanding segmented control' },
  { id: '1b', name: 'Effort scrubber', sub: 'a compact faster ↔ deeper track' },
  { id: '1c', name: 'Energy orb', sub: 'icon only, the pulse is the depth' },
  { id: '2a', name: 'Effort slider', sub: 'Claude-style, glitter at max', rec: true },
  { id: '3a', name: 'Tap to cycle', sub: 'one control, no popover' },
  { id: '3b', name: 'Rising ladder', sub: 'hover previews, click commits', nameV1: 'Hold and scrub', subV1: 'press, drag up to deepen' },
  { id: '3c', name: 'Fuel gauge', sub: 'an inline meter fills the composer’s edge' },
];
const first = dirs.find((d) => d.id === start) ?? dirs[0];
const v1 = build === 'v1';

const ICON = {
  clip: '<path d="M21.44 11.05 12.25 20.24a5 5 0 0 1-7.07-7.07l9.19-9.19a3.5 3.5 0 0 1 4.95 4.95l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>',
  send: '<path d="m22 2-7 20-4-9-9-4 20-7z"/>',
  chev: '<path d="m6 9 6 6 6-6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  q: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
};
const ON = '#F56B10';
const OFF = 'rgba(0,0,0,.18)';
---
<figure class="sk-fig mp-fig">
  <div class="mp" data-mp data-dir={first.id} data-build={build} data-mode="1" data-dirs={JSON.stringify(dirs)} style="--m: 1">
    <div class="mp-bar">
      <span class="mp-lbl">Direction</span>
      <div class="mp-seg" role="group" aria-label="Direction">
        {dirs.map((d) => (
          <button type="button" data-set-dir={d.id} aria-pressed={String(d.id === first.id)} aria-label={`${d.id}, ${d.name}${d.rec ? ', the pick' : ''}`}>{d.id}{d.rec && <span class="mp-star" aria-hidden="true">★</span>}</button>
        ))}
      </div>
      {compare && (
        <>
          <span class="mp-lbl">Build</span>
          <div class="mp-seg" role="group" aria-label="Build">
            <button type="button" data-set-build="v1" aria-pressed={String(v1)}>v1 · first pass</button>
            <button type="button" data-set-build="v2" aria-pressed={String(!v1)}>v2 · after the audit</button>
          </div>
        </>
      )}
    </div>

    <div class="mp-stage">
      <p class="mp-name"><span class="mp-id" data-dir-id>{first.id}</span><b data-dir-name>{v1 && first.nameV1 ? first.nameV1 : first.name}</b><span data-dir-sub>{v1 && first.subV1 ? first.subV1 : first.sub}</span></p>
      <p class="mp-hint">Mouse, keys or touch</p>

      <div class="mp-card">
        <p class="mp-greet">Good afternoon, <b>Maya</b></p>
        <div class="mp-shell">
          <div class="mp-glow"></div>
          <div class="mp-composer">
            <div class="mp-fuel-clip"><div class="mp-fuel"></div></div>
            <div class="mp-input">Ask anything…</div>
            <div class="mp-row">
              <button type="button" class="mp-ic mp-tth" aria-label="Attach" data-tip="Attach"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.clip} /><span class="tt" aria-hidden="true">Attach</span></button>
              <span class="mp-spring"></span>

              <!-- 1a · Rising signal: a radiogroup; a highlight slides under the mode. -->
              <div class="mp-ctl" data-ctl="1a">
                <div class="mp-segc" role="radiogroup" aria-label="Chat mode" data-radios>
                  <span class="mp-seg-hl" aria-hidden="true"></span>
                  {LABELS.map((l, i) => (
                    <button type="button" class="mp-segb mp-tth" role="radio" aria-checked={String(i === 1)} tabindex={i === 1 ? '0' : '-1'} aria-label={l} aria-description={DESCS[i]} data-radio={i} data-tip={`${l} — ${DESCS[i].toLowerCase()}`}>
                      <span class="mp-segi"><svg viewBox="0 0 17 14" aria-hidden="true">{[0, 1, 2].map((b) => <rect x={b * 6.5} y={8 - b * 4} width="3.5" height={6 + b * 4} rx="1.5" fill="currentColor" opacity={b <= i ? 1 : .28} />)}</svg></span>
                      <span class="mp-segl">{l}</span>
                      <span class="tt" aria-hidden="true"><b>{l}</b>{DESCS[i]}</span>
                    </button>
                  ))}
                </div>
              </div>

              <!-- 1b · Effort scrubber, and 2a · the Claude-style effort slider. -->
              {[
                { id: '1b', head: 'Mode', ends: ['Faster', 'Deeper'], w: 300, tip: 'Response mode', shimmer: false },
                { id: '2a', head: 'Effort', ends: ['Faster', 'Smarter'], w: 440, tip: 'Effort', shimmer: true },
              ].map((s) => (
                <div class="mp-ctl" data-ctl={s.id}>
                  <div class="mp-anchor mp-anchor--dialog" data-anchor>
                    <button type="button" class="mp-pill mp-tth" aria-haspopup="dialog" aria-expanded="false" data-trigger data-aria={`${s.tip}: `} aria-label={`${s.tip}: Balanced`}>
                      {s.id === '1b' && <svg class="mp-bars" viewBox="0 0 17 14" aria-hidden="true"><rect x="0" y="8" width="3.5" height="6" rx="1.5" fill={ON} /><rect data-bar="1" x="6.5" y="4" width="3.5" height="10" rx="1.5" fill={ON} /><rect data-bar="2" x="13" y="0" width="3.5" height="14" rx="1.5" fill={OFF} /></svg>}
                      <span class="mp-lab"><span class="mp-ghost" aria-hidden="true">Deep Dive</span><b class="mp-word" data-word data-shimmer={s.shimmer ? '' : undefined}>Balanced</b></span>
                      {s.id === '2a' && <svg class="mp-chev" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.chev} />}
                      <span class="tt r" aria-hidden="true">{s.tip}</span>
                    </button>
                    <div class:list={['mp-pop', s.id === '2a' && 'mp-pop--big']} role="dialog" aria-label={s.tip} data-pop data-open="false" style={`--w: ${s.w}px`}>
                      <div class="mp-pop-h">
                        <span class="mp-pop-t">{s.head} <span class="mp-lab"><span class="mp-ghost" aria-hidden="true">Deep Dive</span><b class="mp-word" data-word data-head data-shimmer={s.shimmer ? '' : undefined}>Balanced</b></span></span>
                        <span class="mp-qwrap">
                          <button type="button" class="mp-q" aria-label={`About ${s.tip.toLowerCase()}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.q} /></button>
                          <span class="mp-qtip" role="tooltip">{s.id === '2a'
                            ? <><b>Effort</b>Higher effort means more thorough responses, but takes longer.</>
                            : <><b data-name>Balanced</b><span data-desc>{DESCS[1]}</span></>}</span>
                        </span>
                      </div>
                      <div class="mp-ends" aria-hidden="true"><span>{s.ends[0]}</span><span>{s.ends[1]}</span></div>
                      <div class="mp-slider" role="slider" tabindex={v1 ? undefined : '0'} aria-label={s.tip} aria-valuemin="0" aria-valuemax="2" aria-valuenow="1" aria-valuetext="Balanced" data-slider style="--p: 50%">
                        <div class="mp-track">
                          <span class="mp-dot" style="left: 7%"></span><span class="mp-dot" style="left: 50%"></span><span class="mp-dot" style="left: 93%"></span>
                          <span class="mp-fill">{s.shimmer && <span class="mp-glitter"></span>}</span>
                          <span class="mp-thumb"></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))}

              <!-- 1c · Energy orb: icon only; it breathes slower and rings more as the mode deepens. -->
              <div class="mp-ctl" data-ctl="1c">
                <div class="mp-anchor" data-anchor>
                  <button type="button" class="mp-orb-btn mp-tth" aria-haspopup="listbox" aria-expanded="false" data-trigger data-aria="Response mode: " aria-label="Response mode: Balanced" data-tip="{name} — tap to change">
                    <span class="mp-orb mp-orb--live" aria-hidden="true"><span class="mp-ring mp-ring--1"></span><span class="mp-ring mp-ring--2"></span><span class="mp-core"></span></span>
                    <span class="tt r" aria-hidden="true"><b data-name>Balanced</b><span data-desc>{DESCS[1]}</span></span>
                  </button>
                  <div class="mp-pop mp-menu" role="listbox" aria-label="Response mode" data-pop data-open="false" data-list="down">
                    {LABELS.map((l, i) => (
                      <button type="button" class="mp-opt" role="option" aria-selected={String(i === 1)} tabindex="-1" data-opt={i}>
                        <span class="mp-orb" aria-hidden="true" style={`--d: ${['1.3s', '2.2s', '3.2s'][i]}`}>
                          {i >= 1 && <span class="mp-ring mp-ring--on"></span>}
                          {i >= 2 && <span class="mp-ring mp-ring--on mp-ring--late"></span>}
                          <span class="mp-core"></span>
                        </span>
                        <span class="mp-tx"><span class="mp-n">{l}</span><span class="mp-d">{DESCS[i]}</span></span>
                        <svg class="mp-ck" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.check} />
                      </button>
                    ))}
                  </div>
                </div>
              </div>

              <!-- 3a · Tap to cycle: one pill, every click steps the mode (Shift-click goes back in v2). -->
              <div class="mp-ctl" data-ctl="3a">
                <button type="button" class="mp-pill mp-tth" data-cycle data-aria="Response mode: " data-aria-end=". Activate to switch." aria-label="Response mode: Balanced. Activate to switch." data-tip="{name} — {desc}. Tap to change.">
                  <svg class="mp-bars" viewBox="0 0 17 14" aria-hidden="true"><rect x="0" y="8" width="3.5" height="6" rx="1.5" fill={ON} /><rect data-bar="1" x="6.5" y="4" width="3.5" height="10" rx="1.5" fill={ON} /><rect data-bar="2" x="13" y="0" width="3.5" height="14" rx="1.5" fill={OFF} /></svg>
                  <span class="mp-lab"><span class="mp-ghost" aria-hidden="true">Deep Dive</span><b class="mp-word" data-word data-shimmer>Balanced</b></span>
                  <span class="tt r" aria-hidden="true"><b data-name>Balanced</b><span data-desc>{DESCS[1]}</span></span>
                </button>
              </div>

              <!-- 3b · Rising ladder: Deep Dive on top; v2 previews on hover, v1 scrubs while pressed. -->
              <div class="mp-ctl" data-ctl="3b">
                <div class="mp-anchor" data-anchor>
                  <button type="button" class="mp-pill mp-tth" aria-haspopup="listbox" aria-expanded="false" data-trigger data-aria="Response mode: " aria-label="Response mode: Balanced" data-tip="{name} — {desc}">
                    <svg class="mp-bars" viewBox="0 0 17 14" aria-hidden="true"><rect x="0" y="8" width="3.5" height="6" rx="1.5" fill={ON} /><rect data-bar="1" x="6.5" y="4" width="3.5" height="10" rx="1.5" fill={ON} /><rect data-bar="2" x="13" y="0" width="3.5" height="14" rx="1.5" fill={OFF} /></svg>
                    <span class="mp-lab"><span class="mp-ghost" aria-hidden="true">Deep Dive</span><b class="mp-word" data-word>Balanced</b></span>
                    <svg class="mp-chev" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.chev} />
                    <span class="tt r" aria-hidden="true"><b data-name>Balanced</b><span data-desc>{DESCS[1]}</span></span>
                  </button>
                  <div class="mp-pop mp-ladder" role="listbox" aria-label="Response mode" data-pop data-open="false" data-list="up" data-ladder style="--hl: 44px">
                    <span class="mp-lad-hl" aria-hidden="true"></span>
                    {[2, 1, 0].map((i) => (
                      <button type="button" class="mp-lad-row" role="option" aria-selected={String(i === 1)} tabindex="-1" data-opt={i} data-lad={i}><span>{LABELS[i]}</span><span class="mp-lad-sel" aria-hidden="true"></span></button>
                    ))}
                  </div>
                </div>
              </div>

              <!-- 3c · Fuel gauge: three cells to click or drag; the composer's left edge fills with the mode. -->
              <div class="mp-ctl mp-ctl--meter" data-ctl="3c">
                <div class="mp-meter mp-tth" role="slider" tabindex={v1 ? undefined : '0'} aria-label="Response mode" aria-valuemin="0" aria-valuemax="2" aria-valuenow="1" aria-valuetext="Balanced" data-meter data-tip="{name} — {desc}">
                  {[0, 1, 2].map((i) => <span class:list={['mp-cell', `mp-cell--${i}`]} data-cell={i}></span>)}
                  <span class="tt r" aria-hidden="true"><b data-name>Balanced</b><span data-desc>{DESCS[1]}</span></span>
                </div>
                <span class="mp-lab mp-meter-lab" aria-hidden="true"><span class="mp-ghost">Deep Dive</span><span data-preview>Balanced</span></span>
              </div>

              <button type="button" class="mp-send mp-tth" aria-label="Send" data-tip="Send"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.send} /><span class="tt r" aria-hidden="true">Send</span></button>
            </div>
          </div>
        </div>
      </div>
      <!-- v1's invisible backdrop, kept to the stage so the switches above still work. -->
      <div class="mp-backdrop" data-backdrop aria-hidden="true"></div>
    </div>
    <p class="mp-sr" aria-live="polite" data-live></p>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  const LABELS = ['Quick', 'Balanced', 'Deep Dive'];
  const DESCS = ['Fast, lighter answers', 'A mix of speed and detail', 'Slower, more thorough analysis'];
  const STOPS = [0.07, 0.5, 0.93];
  const ON = '#F56B10';
  const OFF = 'rgba(0,0,0,.18)';
  type Dir = { id: string; name: string; sub: string; nameV1?: string; subV1?: string };

  document.querySelectorAll<HTMLElement>('[data-mp]').forEach((root) => {
    const dirs: Dir[] = JSON.parse(root.dataset.dirs || '[]');
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const $$ = <T extends Element = HTMLElement>(sel: string, el: ParentNode = root) => [...el.querySelectorAll<T>(sel)] as T[];
    let mode = 1;
    let open: HTMLElement | null = null; // the open anchor
    let drag: HTMLElement | null = null;
    let hoverLadder: number | null = null;
    let hoverMeter: number | null = null;
    const v2 = () => root.dataset.build !== 'v1';
    const fill = (s: string) => s.replace('{name}', LABELS[mode]).replace('{desc}', DESCS[mode].toLowerCase());

    // Replays the slide-up on a word; the key is restarting the animation.
    const replay = (w: HTMLElement) => { w.classList.remove('is-swap'); void w.offsetWidth; w.classList.add('is-swap'); };

    function paintLadder() {
      $$('[data-ladder]').forEach((l) => {
        const hl = v2() && hoverLadder != null ? hoverLadder : mode;
        l.style.setProperty('--hl', `${(2 - hl) * 44}px`);
        $$<HTMLElement>('[data-lad]', l).forEach((r) => {
          const i = Number(r.dataset.lad);
          r.classList.toggle('is-hl', i === hl);
          r.style.setProperty('--sel', i === mode ? (i === hl ? '.9' : '.5') : '0');
        });
      });
    }
    function paintMeter() {
      const peek = v2() ? hoverMeter : null;
      $$('[data-cell]').forEach((c) => {
        const i = Number(c.dataset.cell);
        c.style.background = i <= mode ? ON : peek != null && i <= peek ? 'rgba(245,107,16,.35)' : '#D8D8D8';
      });
      $$('[data-preview]').forEach((p) => { p.textContent = LABELS[peek ?? mode]; });
    }
    function titles() {
      $$('[data-tip]').forEach((el) => {
        if (v2()) el.removeAttribute('title');
        else el.title = fill(el.dataset.tip!);
      });
    }

    function render(changed: boolean) {
      root.dataset.mode = String(mode);
      root.style.setProperty('--m', String(mode));
      const shown = root.querySelector<HTMLElement>(`[data-ctl="${root.dataset.dir}"]`);
      $$('[data-word]').forEach((w) => {
        if (w.textContent !== LABELS[mode]) {
          w.textContent = LABELS[mode];
          if (changed && shown?.contains(w)) replay(w);
        }
        w.classList.toggle('is-deep', mode === 2 && w.hasAttribute('data-shimmer'));
      });
      $$('[data-name]').forEach((n) => { n.textContent = LABELS[mode]; });
      $$('[data-desc]').forEach((n) => { n.textContent = DESCS[mode]; });
      $$('[data-bar]').forEach((r) => r.setAttribute('fill', Number(r.dataset.bar) <= mode ? ON : OFF));
      $$('[data-radio]').forEach((b) => {
        const i = Number(b.dataset.radio);
        b.setAttribute('aria-checked', String(i === mode));
        b.tabIndex = v2() ? (i === mode ? 0 : -1) : 0;
      });
      $$('[data-slider], [data-meter]').forEach((s) => {
        if (s.hasAttribute('data-slider') && !(s === drag && v2())) s.style.setProperty('--p', `${STOPS[mode] * 100}%`);
        s.setAttribute('aria-valuenow', String(mode));
        s.setAttribute('aria-valuetext', LABELS[mode]);
        if (v2()) s.tabIndex = 0; else s.removeAttribute('tabindex');
      });
      $$('[data-opt]').forEach((o) => o.setAttribute('aria-selected', String(Number(o.dataset.opt) === mode)));
      $$('[data-aria]').forEach((el) => el.setAttribute('aria-label', el.dataset.aria + LABELS[mode] + (el.dataset.ariaEnd || '')));
      paintLadder();
      paintMeter();
      titles();
    }

    function setMode(n: number) {
      if (n === mode) return;
      mode = n;
      render(true);
      if (v2()) live.textContent = `Mode set to ${LABELS[n]}`;
    }

    // Popovers. v2: always mounted, fade from the anchor, close on an outside
    // click or Esc, and hand focus in and back. v1: mount with a pop-in, snap
    // shut, and an invisible backdrop over the frame that eats the next click.
    function openPop(anchor: HTMLElement) {
      closePop(false);
      open = anchor;
      const pop = anchor.querySelector<HTMLElement>('[data-pop]')!;
      pop.dataset.open = 'true';
      anchor.querySelector('[data-trigger]')!.setAttribute('aria-expanded', 'true');
      if (!v2()) {
        root.classList.add('has-backdrop');
        $$('[data-head]', pop).forEach(replay);
        return;
      }
      requestAnimationFrame(() => {
        const target = pop.querySelector<HTMLElement>('[data-slider]') ?? pop.querySelector<HTMLElement>(`[data-opt="${mode}"]`);
        target?.focus({ preventScroll: true });
      });
    }
    function closePop(refocus: boolean) {
      if (!open) return;
      const anchor = open;
      open = null;
      anchor.querySelector<HTMLElement>('[data-pop]')!.dataset.open = 'false';
      const trig = anchor.querySelector<HTMLElement>('[data-trigger]')!;
      trig.setAttribute('aria-expanded', 'false');
      root.classList.remove('has-backdrop');
      hoverLadder = null;
      paintLadder();
      if (refocus && v2()) trig.focus({ preventScroll: true });
    }

    $$('[data-trigger]').forEach((t) => t.addEventListener('click', () => {
      const anchor = t.closest<HTMLElement>('[data-anchor]')!;
      if (open === anchor) closePop(false); else openPop(anchor);
    }));
    root.querySelector('[data-backdrop]')!.addEventListener('click', () => closePop(false));
    document.addEventListener('pointerdown', (e) => {
      if (open && v2() && !open.contains(e.target as Node)) closePop(false);
    }, true);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open && v2()) { e.preventDefault(); closePop(true); }
    });

    // Sliders (1b, 2a). v2: the thumb follows the pointer 1:1 over the whole
    // padded hit area, then settles on the nearest stop. v1: only the track
    // takes the press, and the thumb jumps between stops.
    $$('[data-slider]').forEach((s) => {
      const track = s.querySelector<HTMLElement>('.mp-track')!;
      const at = (x: number) => {
        const rc = track.getBoundingClientRect();
        const t = (x - rc.left) / rc.width;
        if (!v2()) { setMode(t < 0.34 ? 0 : t < 0.67 ? 1 : 2); return; }
        const p = Math.max(STOPS[0], Math.min(STOPS[2], t));
        s.style.setProperty('--p', `${p * 100}%`);
        let idx = 0;
        STOPS.forEach((st, i) => { if (Math.abs(st - p) < Math.abs(STOPS[idx] - p)) idx = i; });
        setMode(idx);
      };
      s.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        if (!v2() && !(e.target as Element).closest('.mp-track')) return;
        e.preventDefault();
        const cap = v2() ? s : (e.target as Element);
        try { cap.setPointerCapture(e.pointerId); } catch { /* gone */ }
        if (v2()) { s.focus({ preventScroll: true }); s.dataset.drag = 'true'; }
        drag = s;
        at(e.clientX);
      });
      s.addEventListener('pointermove', (e) => { if (drag === s) at(e.clientX); });
      const up = () => {
        if (drag !== s) return;
        drag = null;
        delete s.dataset.drag;
        s.style.setProperty('--p', `${STOPS[mode] * 100}%`);
      };
      s.addEventListener('pointerup', up);
      s.addEventListener('lostpointercapture', up);
      s.addEventListener('keydown', (e) => {
        if (!v2()) return;
        let n: number;
        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') n = Math.min(2, mode + 1);
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') n = Math.max(0, mode - 1);
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = 2;
        else if (e.key === 'Enter') { e.preventDefault(); closePop(true); return; }
        else return;
        e.preventDefault();
        setMode(n);
      });
    });

    // 1a: arrows move the mode and the focus together (roving tabindex).
    root.querySelector('[data-radios]')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (!v2()) return;
      let n: number;
      if (k === 'ArrowRight' || k === 'ArrowDown') n = (mode + 1) % 3;
      else if (k === 'ArrowLeft' || k === 'ArrowUp') n = (mode + 2) % 3;
      else if (k === 'Home') n = 0;
      else if (k === 'End') n = 2;
      else return;
      e.preventDefault();
      setMode(n);
