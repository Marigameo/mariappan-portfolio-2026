---
// Card sketch for the DforDoubts project.
// Hand-drawn product sketch. Colours come from the .sk rules in src/styles/style.css
// so it follows the theme; the fixed hex values are the product's own brand colours.
---
<svg class="sk" viewBox="0 0 600 440" preserveAspectRatio="xMidYMin slice" role="img" aria-label="Sketch of the DforDoubts home page: a nav with a Learner's Login button, a course search bar and three course cards with educator avatars and English and Live tags">
  <defs>
    <g id="sk-dfd-card">
      <rect width="160" height="270" rx="10" style="fill:var(--paper-2);stroke:var(--ink);stroke-opacity:.14;stroke-width:1.5"/>
      <rect x="14" y="16" width="58" height="8" rx="4" fill="#b31c4e" fill-opacity=".75"/>
      <rect x="98" y="12" width="48" height="16" rx="8" fill="#b31c4e" fill-opacity=".1"/>
      <rect x="108" y="18" width="28" height="4" rx="2" fill="#b31c4e" fill-opacity=".5"/>
      <rect x="14" y="82" width="132" height="6" rx="3" style="fill:var(--ink);fill-opacity:.09"/>
      <rect x="14" y="94" width="122" height="6" rx="3" style="fill:var(--ink);fill-opacity:.09"/>
      <rect x="14" y="106" width="98" height="6" rx="3" style="fill:var(--ink);fill-opacity:.09"/>
      <rect x="14" y="128" width="42" height="8" rx="4" fill="#b31c4e" fill-opacity=".8"/>
      <rect x="88" y="129.5" width="58" height="5" rx="2.5" style="fill:var(--ink);fill-opacity:.09"/>
      <circle cx="36" cy="180" r="20" fill="#b31c4e" fill-opacity=".1"/>
      <circle cx="36" cy="174" r="7" style="fill:var(--ink);fill-opacity:.18"/>
      <path d="M22 196a14 14 0 0 1 28 0z" style="fill:var(--ink);fill-opacity:.18"/>
      <rect x="64" y="172" width="72" height="8" rx="4" fill="#b31c4e" fill-opacity=".7"/>
      <rect x="64" y="188" width="82" height="6" rx="3" style="fill:var(--ink);fill-opacity:.09"/>
      <rect x="14" y="222" width="42" height="16" rx="3" fill="#16a34a" fill-opacity=".15"/>
      <rect x="22" y="228" width="26" height="4" rx="2" fill="#16a34a" fill-opacity=".8"/>
      <rect x="62" y="222" width="30" height="16" rx="3" style="fill: var(--yellow)"/>
      <rect x="70" y="228" width="14" height="4" rx="2" fill="#2a2610" fill-opacity=".8"/>
      <rect x="102" y="227" width="20" height="6" rx="3" fill="#2563eb" fill-opacity=".85"/>
      <rect x="126" y="227" width="20" height="6" rx="3" fill="#2563eb" fill-opacity=".85"/>
    </g>
  </defs>
  <rect width="600" height="440" class="f-card"/>
  <circle cx="46" cy="28" r="13" fill="#b31c4e" fill-opacity=".1" stroke="#b31c4e" stroke-opacity=".55" stroke-width="1.3"/>
  <path d="M46 20l6 3v5c0 4-3 6-6 8-3-2-6-4-6-8v-5z" fill="#b31c4e" fill-opacity=".55"/>
  <rect x="214" y="24" width="40" height="8" rx="4" class="f-bar"/>
  <rect x="270" y="24" width="78" height="8" rx="4" class="f-bar"/>
  <rect x="364" y="24" width="52" height="8" rx="4" class="f-bar"/>
  <path d="M436 23h14M436 28h14M436 33h14" class="s-ink" stroke-opacity=".6" stroke-width="1.4"/>
  <rect x="488" y="13" width="96" height="30" rx="6" fill="#b31c4e"/>
  <rect x="506" y="25" width="60" height="6" rx="3" fill="#fff" fill-opacity=".9"/>
  <text x="300" y="84" text-anchor="middle" font-size="14" font-weight="600" class="t-soft">Highly personalized courses tailored by our network of industry experts!</text>
  <rect x="40" y="108" width="520" height="36" rx="8" class="f-card s-soft" stroke-width="1.5"/>
  <circle cx="60" cy="125" r="5" class="s-ink" stroke-opacity=".55" stroke-width="1.3"/>
  <path d="M63.5 128.5l4 4" class="s-ink" stroke-opacity=".55" stroke-width="1.3"/>
  <rect x="76" y="122" width="200" height="7" rx="3.5" class="f-bar-2"/>
  <g class="sk-lift">
    <use href="#sk-dfd-card" x="40" y="170"/>
    <rect x="54" y="212" width="126" height="10" rx="4" class="f-bar"/>
    <rect x="54" y="228" width="88" height="10" rx="4" class="f-bar"/>
    <use href="#sk-dfd-card" x="220" y="170"/>
    <rect x="234" y="212" width="118" height="10" rx="4" class="f-bar"/>
    <rect x="234" y="228" width="64" height="10" rx="4" class="f-bar"/>
    <use href="#sk-dfd-card" x="400" y="170"/>
    <rect x="414" y="212" width="132" height="10" rx="4" class="f-bar"/>
    <rect x="414" y="228" width="100" height="10" rx="4" class="f-bar"/>
  </g>
  <rect x="444" y="392" width="136" height="32" rx="16" class="f-card s-soft" stroke-width="1.5"/>
  <circle cx="462" cy="408" r="8" fill="#25d366"/>
  <path d="M458.5 411.5l.8-2.6a4 4 0 1 1 1.8 1.8z" fill="#fff"/>
  <rect x="476" y="404" width="90" height="8" rx="4" class="f-bar"/>
</svg>
