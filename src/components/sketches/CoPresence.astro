---
// Card sketch for co-presence.
// A war room thread: two agents talking (rounded-square faces) and a person (a
// circle), then the strip above the message box: four faces with their marks
// (amber waiting, green working, none for just here) and +3, and the one line that
// says what matters, "Rollback agent · Needs you · Roll back to v412?". Everything
// sits in the top 16:9 of the 600x440 box, since card frames crop the bottom. Colours
// come from the .sk rules so it follows the theme; the fixed amber and green are the
// component's own signals.
---
<svg class="sk" viewBox="0 0 600 440" preserveAspectRatio="xMinYMin slice" role="img" aria-label="Sketch of a war room chat: the Logs agent and the Deploy-diff agent talk about a slow checkout, Aisha replies, and above the message box a strip of four faces with +3 says Rollback agent, Needs you, Roll back to v412?">
  <rect width="600" height="440" class="f-page"/>

  <rect x="24" y="20" width="26" height="26" rx="7" class="f-bar-2"/>
  <text x="62" y="31" font-size="11" font-weight="600">Logs agent</text>
  <text x="62" y="47" font-size="11.5" class="t-soft">Every timeout is waiting on a DB connection.</text>

  <rect x="24" y="66" width="26" height="26" rx="7" class="f-bar-2"/>
  <text x="62" y="77" font-size="11" font-weight="600">Deploy-diff agent</text>
  <text x="62" y="93" font-size="11.5" class="t-soft">v413 changed pool_size from 50 to 5. Looks like a typo.</text>

  <circle cx="37" cy="125" r="13" class="f-bar-2"/>
  <text x="62" y="123" font-size="11" font-weight="600">Aisha Khan</text>
  <text x="62" y="139" font-size="11.5" class="t-soft">EU is hit harder than US. I added that to Impact.</text>

  <g class="sk-lift">
    <rect x="24" y="166" width="552" height="84" rx="12" class="f-tint"/>
    <text x="40" y="186" font-size="10" font-weight="600" style="fill: #b45309">Needs you</text>
    <text x="40" y="205" font-size="12.5">Roll back payments-api to v412?</text>
    <rect x="40" y="215" width="70" height="24" rx="12" class="f-ink"/>
    <text x="54" y="231" font-size="11" font-weight="500" class="t-on-ink">Approve</text>
    <rect x="118" y="215" width="54" height="24" rx="12" class="f-card s-soft" stroke-width="1.5"/>
    <text x="132" y="231" font-size="11">Hold</text>

    <rect x="28" y="262" width="30" height="30" rx="8" class="f-bar" stroke="var(--paper)" stroke-width="2.5"/>
    <rect x="50" y="262" width="30" height="30" rx="8" class="f-bar-2" stroke="var(--paper)" stroke-width="2.5"/>
    <circle cx="87" cy="277" r="15" class="f-bar" stroke="var(--paper)" stroke-width="2.5"/>
    <rect x="94" y="262" width="30" height="30" rx="8" class="f-bar-2" stroke="var(--paper)" stroke-width="2.5"/>
    <circle cx="53" cy="291" r="5.5" style="fill: #b45309" stroke="var(--paper)" stroke-width="2.5"/>
    <circle cx="75" cy="291" r="5.5" style="fill: #1f9d55" stroke="var(--paper)" stroke-width="2.5"/>
    <circle cx="119" cy="291" r="5.5" style="fill: #1f9d55" stroke="var(--paper)" stroke-width="2.5"/>
    <circle cx="146" cy="277" r="14" class="f-tint"/>
    <text x="137" y="281" font-size="10.5" class="t-soft">+3</text>
    <text x="172" y="281.5" font-size="12" font-weight="600">Rollback agent</text>
    <text x="263" y="281.5" font-size="12" class="t-soft">·</text>
    <text x="272" y="281.5" font-size="12" font-weight="500" style="fill: #b45309">Needs you</text>
    <text x="336" y="281.5" font-size="12" class="t-soft">· Roll back to v412?</text>

    <rect x="24" y="304" width="552" height="34" rx="17" class="f-card s-soft" stroke-width="1.5"/>
    <text x="42" y="325.5" font-size="11.5" class="t-soft">Message the war room…</text>
    <circle cx="558" cy="321" r="12" class="f-ink"/>
    <path d="M558 327v-11m-4.5 4.5l4.5-4.5 4.5 4.5" stroke="var(--paper)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>

<style>
  .t-on-ink { fill: var(--paper-2) !important; }
</style>
