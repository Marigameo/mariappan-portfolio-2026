---
/* Thenga (Malayalam for coconut), the mascot of the experiments stash.
   Every coconut is a keeper: it sprouts, or it cracks open with something shiny
   inside, or it goes full moonshot. Ink and the idle loops come from the .mascot
   rules in style.css; the m-a-* groups are the moving parts.
   Moods: hero (waving), sprouted (hops), cracked (lid pops, star twinkles),
   moonshot (hovers on flickering flames).
   `hobby` (hero only) swaps the wave for Thenga's day off, on the About page:
   guitar (strums, notes rise), camera (flash pops), pen (writes on a page),
   pot (stirs, steam rises), backpack (walking stick, a paper plane drifts by).
   brush is the studio's painter (Experiments page): a beret in place of the sprout
   (one leaf pokes out), a palette in one hand, a brush that dabs a stroke of paint. */
import type { Mood } from '../../data/experiments';
import type { Hobby } from '../../data/offclock';

interface Props { mood?: Mood; hobby?: Hobby; label?: string; class?: string }
const { mood = 'hero', hobby, label, class: cls } = Astro.props;
---
<svg class:list={['mascot', `mascot--${mood}`, hobby && `mascot--${hobby}`, cls]} viewBox="0 0 160 160" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <ellipse cx="80" cy="148" rx="36" ry="5" class="m-shadow m-a-shadow" />

  {mood === 'cracked' ? (
    <g class="m-a-body">
      <!-- the treasure, popping out between shell and lid -->
      <g class="m-a-star">
        <path d="M80 34v-8M58 42l-6-5M102 42l6-5M50 58h-8M110 58h8" class="m-line m-thin m-ray" />
        <path d="M80 40l5 10 11 1.5-8 7.5 2 11-10-5.5-10 5.5 2-11-8-7.5 11-1.5z" class="m-star" />
      </g>
      <!-- lid, lifted and tipped, sprout still on top -->
      <g class="m-a-lid">
        <g transform="rotate(-20 60 40) translate(-10 -26)">
          <path d="M44 72l8 6 8-8 8 8 8-8 8 8 8-8 8 8 8-8 8 2c-2-18-18-30-36-30s-34 12-36 30z" class="m-shell" />
          <path d="M80 42c0-6 1-10 3-14" class="m-line" />
          <path d="M83 30c-7-6-16-6-21 0 6 3 15 3 21 0z" class="m-leaf" />
          <path d="M83 30c5-8 14-9 20-4-5 5-14 7-20 4z" class="m-leaf" />
        </g>
      </g>
      <!-- the shell, open at the top -->
      <path d="M44 72l8 6 8-8 8 8 8-8 8 8 8-8 8 8 8-8 8 2c10 12 10 46-6 56-12 8-48 8-60 0-16-10-16-44-6-56z" class="m-shell" />
      <path d="M50 108c2 4 5 7 9 9M110 118c-3 3-7 5-11 6" class="m-line m-thin m-fibre" />
      <path d="M62 96c2-5 8-5 10 0M88 96c2-5 8-5 10 0" class="m-line m-thin" />
      <ellipse cx="80" cy="110" rx="5" ry="6" class="m-mouth" />
      <ellipse cx="60" cy="106" rx="4.5" ry="2.6" class="m-cheek" /><ellipse cx="100" cy="106" rx="4.5" ry="2.6" class="m-cheek" />
      <path d="M40 96c-8-6-10-16-6-26" class="m-line" />
      <path d="M120 96c8-6 10-16 6-26" class="m-line" />
      <ellipse cx="68" cy="138" rx="8" ry="4" class="m-foot" /><ellipse cx="92" cy="138" rx="8" ry="4" class="m-foot" />
    </g>
  ) : (
    <g class="m-a-body">
      {mood === 'moonshot' && (
        <g class="m-a-flames">
          <path d="M62 128c-4 10 0 18 6 22 0-6 4-10 4-14M98 128c4 10 0 18-6 22 0-6-4-10-4-14" class="m-flame" />
        </g>
      )}
      {mood === 'moonshot' && (
        <path d="M40 60l-8-4M38 74h-9M120 60l8-4M122 74h9" class="m-line m-thin m-ray m-a-rays" />
      )}

      {hobby === 'backpack' && (
        <g>
          <!-- the pack, behind the shell, and a paper plane off on its own trip -->
          <rect x="22" y="70" width="30" height="58" rx="9" class="m-pack" />
          <rect x="26" y="96" width="18" height="20" rx="4" class="m-pack-pocket" />
          <g class="m-a-plane"><path d="M104 22l26-8-10 18-5-6z" class="m-card" /><path d="M115 26l5 6" class="m-line m-thin" /><path d="M100 30c-8 4-16 4-24 2" class="m-line m-thin m-trail" /></g>
        </g>
      )}
      <!-- sprout (under the beret, the painter keeps just one leaf) -->
      {hobby !== 'brush' && <g class="m-a-sprout">
        {mood === 'sprouted' ? (
          <g>
            <path d="M80 58c0-12 1-22 4-30" class="m-line" />
            <path d="M84 30c-14-12-34-10-42 2 14 6 30 6 42-2z" class="m-leaf" />
            <path d="M84 30c10-16 30-18 42-8-10 10-28 14-42 8z" class="m-leaf" />
            <path d="M83 30c-2-12 2-22 10-26 2 10-2 20-10 26z" class="m-leaf" />
            <circle cx="84" cy="30" r="3" class="m-yellow" />
          </g>
        ) : (
          <g>
            <path d="M80 58c0-8 1-14 3-19" class="m-line" />
            <path d="M83 40c-8-8-20-8-26 0 8 4 18 4 26 0z" class="m-leaf" />
            <path d="M83 40c6-10 18-12 26-6-6 7-18 10-26 6z" class="m-leaf" />
          </g>
        )}
      </g>}

      <!-- shell -->
      <g transform={mood === 'moonshot' ? 'rotate(-4 80 96)' : undefined}>
        <path d="M80 56c26 0 44 18 44 42 0 22-18 36-44 36s-44-14-44-36c0-24 18-42 44-42z" class="m-shell" />
        <path d="M52 76c3-4 6-6 10-8M50 108c2 4 5 7 9 9M104 70c4 2 7 5 9 9M110 118c-3 3-7 5-11 6" class="m-line m-thin m-fibre" />
        <!-- the coconut's own three "eyes" up top -->
        {hobby !== 'brush' && (<g><circle cx="74" cy="66" r="2.2" class="m-pore" /><circle cx="86" cy="66" r="2.2" class="m-pore" /><circle cx="80" cy="72" r="2.2" class="m-pore" /></g>)}

        {mood === 'hero' && (<g><g class="m-a-blink"><circle cx="68" cy="96" r="3.4" class="m-dot" /><circle cx="92" cy="96" r="3.4" class="m-dot" /></g><path d="M73 106c4 4 10 4 14 0" class="m-line m-thin" /></g>)}
        {mood === 'sprouted' && (<g><path d="M63 97c2-4 8-4 10 0M87 97c2-4 8-4 10 0" class="m-line m-thin" /><path d="M71 104c4 7 14 7 18 0z" class="m-mouth" /></g>)}
        {mood === 'moonshot' && (<g><circle cx="67" cy="95" r="7" class="m-card" /><circle cx="93" cy="95" r="8.5" class="m-card" /><circle cx="69" cy="93" r="3" class="m-dot" /><circle cx="95" cy="92" r="3.4" class="m-dot" /><path d="M70 108c6 5 14 5 20 0z" class="m-mouth" /></g>)}
        <ellipse cx="60" cy="106" rx="4.5" ry="2.6" class="m-cheek" /><ellipse cx="100" cy="106" rx="4.5" ry="2.6" class="m-cheek" />
      </g>

      <!-- arms + feet -->
      {mood === 'hero' && !hobby && (<g><path d="M38 102c-8 0-12-6-12-12" class="m-line" /><g class="m-a-wave"><path d="M122 100c8-4 10-12 8-20" class="m-line" /><path d="M128 74c3-2 7-1 8 2M130 68c5-3 11-1 12 4" class="m-line m-thin m-wave" /></g></g>)}
      {mood === 'sprouted' && (<g><path d="M38 100c-8-4-10-12-8-20" class="m-line" /><path d="M122 100c8-4 10-12 8-20" class="m-line" /></g>)}
      {mood === 'moonshot' && (<g><path d="M38 96c-10-4-12-14-8-22" class="m-line" /><path d="M122 96c10-4 12-14 8-22" class="m-line" /></g>)}
      {mood !== 'moonshot' && hobby !== 'pot' && (<g><ellipse cx="68" cy="138" rx="8" ry="4" class="m-foot" /><ellipse cx="92" cy="138" rx="8" ry="4" class="m-foot" /></g>)}

      {hobby === 'guitar' && (
        <g>
          <g class="m-a-notes">
            <path d="M120 46V32l9-3v14" class="m-line m-thin" /><ellipse cx="117" cy="46" rx="3.2" ry="2.4" class="m-dot" /><ellipse cx="126" cy="43" rx="3.2" ry="2.4" class="m-dot" />
            <path d="M138 62V52" class="m-line m-thin" /><ellipse cx="135.5" cy="62" rx="3" ry="2.2" class="m-dot" />
          </g>
          <g transform="rotate(-30 76 118)">
            <path d="M84 115h50" class="m-neck-ink" /><path d="M84 115h50" class="m-neck" />
            <rect x="132" y="109" width="12" height="12" rx="2.5" class="m-wood" />
            <ellipse cx="62" cy="118" rx="19" ry="16" class="m-wood" />
            <ellipse cx="82" cy="118" rx="13" ry="12" class="m-wood" />
            <path d="M66 110c4-3 9-3 13 0M66 126c4 3 9 3 13 0" class="m-wood-join" />
            <circle cx="74" cy="118" r="5" class="m-dot" />
            <path d="M56 117h78M56 119.5h78" class="m-string" />
          </g>
          <path d="M122 100c6-3 7-9 3-14" class="m-line" />
          <g class="m-a-strum"><path d="M40 102c4 10 14 18 26 20" class="m-line" /></g>
        </g>
      )}
      {hobby === 'camera' && (
        <g>
          <path d="M38 104c6 6 12 10 18 12M122 104c-6 6-12 10-18 12" class="m-line" />
          <rect x="54" y="108" width="52" height="30" rx="6" class="m-camera" />
          <rect x="60" y="103" width="12" height="7" rx="2" class="m-camera" />
          <circle cx="82" cy="123" r="10" class="m-card" /><circle cx="82" cy="123" r="5" class="m-lens" />
          <g class="m-a-flash"><path d="M66 96v-8M58 98l-5-5M74 98l5-5M54 105h-7M78 105h7" class="m-line m-thin m-ray" /></g>
        </g>
      )}
      {hobby === 'pen' && (
        <g>
          <g transform="rotate(-8 70 125)">
            <rect x="46" y="110" width="46" height="32" rx="3" class="m-card" />
            <path d="M52 119c3-3 5 3 8 0s5 3 8 0 5 3 8 0M52 127c3-3 5 3 8 0s5 3 8 0M52 135c3-3 5 3 8 0s5 3 8 0 5 3 8 0" class="m-line m-thin m-ink-soft" />
          </g>
          <path d="M38 104c4 8 8 14 12 18" class="m-line" />
          <path d="M122 102c-4 2-8 2-12 1" class="m-line" />
          <g class="m-a-write"><path d="M112 98L90 124" class="m-pen" /><path d="M90 124l-3 5 5-2z" class="m-dot" /></g>
        </g>
      )}
      {hobby === 'pot' && (
        <g>
          <g class="m-a-steam"><path d="M66 112c-4-4 4-8 0-12" class="m-line m-thin m-steam" /><path d="M80 110c-4-4 4-8 0-12" class="m-line m-thin m-steam" /><path d="M94 112c-4-4 4-8 0-12" class="m-line m-thin m-steam" /></g>
          <path d="M48 118h64v14c0 8-10 13-32 13s-32-5-32-13z" class="m-pot" />
          <ellipse cx="80" cy="118" rx="32" ry="5" class="m-pot-rim" />
          <path d="M48 123h-7M112 123h7" class="m-line" />
          <path d="M38 104c0 8 2 14 5 19" class="m-line" />
          <g class="m-a-stir"><path d="M122 100c-2 4-6 6-10 6" class="m-line" /><path d="M114 104L94 122" class="m-ladle" /><ellipse cx="92" cy="123" rx="5" ry="3" class="m-pot-rim" /></g>
        </g>
      )}
      {hobby === 'brush' && (
        <g>
          <!-- the beret, tipped to one side, a leaf for its nub -->
          <g transform="rotate(-10 82 58)">
            <path d="M84 44c0-5 1-9 4-12" class="m-line m-thin" />
            <path d="M88 33c-6-6-14-6-19 0 6 3 13 3 19 0z" class="m-leaf" />
            <path d="M52 62c0-12 14-20 32-20s32 8 32 18c0 4-9 7-32 7s-32-2-32-5z" class="m-beret" />
          </g>
          <!-- the palette, held out on the left, a blob of each accent -->
          <path d="M38 104c-6 3-10 7-12 11" class="m-line" />
          <path d="M4 121c0-10 10-17 23-17s25 5 25 13c0 5-5 6-9 6s-6 4-3 7c2 3-2 6-13 6C13 136 4 131 4 121z" class="m-palette" />
          <circle cx="15" cy="118" r="3.4" class="m-blob" style="fill: var(--coral-soft)" />
          <circle cx="25" cy="111" r="3.4" class="m-blob" style="fill: var(--yellow)" />
          <circle cx="36" cy="111" r="3.4" class="m-blob" style="fill: var(--blue)" />
          <circle cx="15" cy="128" r="3.4" class="m-blob" style="fill: var(--teal)" />
          <!-- the brush, dabbing; a stroke of paint appears where it lands -->
          <g class="m-a-splat"><path d="M126 44c4-6 9-6 12 0s9 6 13 0" class="m-paint" /></g>
          <g class="m-a-dab">
            <path d="M122 100c6-2 10-6 12-11" class="m-line" />
            <path d="M127 99L145 63" class="m-brush" />
            <path d="M143 66l3-7 5 2.5-3 7z" class="m-ferrule" />
            <path d="M146 59c1-5 4-8 8-10 0 5-2 9-5 11.5z" class="m-tip" />
          </g>
        </g>
      )}
      {hobby === 'backpack' && (
        <g>
          <path d="M58 64c-6 20-7 44-3 62" class="m-strap" />
          <path d="M38 102c-6 4-8 10-7 16" class="m-line" />
          <path d="M122 100c4-2 6-6 7-11" class="m-line" />
          <path d="M129 84l5 62" class="m-stick" />
        </g>
      )}
    </g>
  )}
</svg>
