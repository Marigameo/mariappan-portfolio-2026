---
/* Two to four shots side by side (one column on phones), each with a label
   and a short caption. Each opens full size, so small frames stay readable. */
import UxShot from './UxShot.astro';

interface Props {
  items: { src: string; width: number; height: number; alt: string; label?: string; caption?: string }[];
}
const { items } = Astro.props;
---
<div class="ux-gallery" style={`--cols: ${items.length}`}>
  {items.map((it) => <UxShot {...it} />)}
</div>
